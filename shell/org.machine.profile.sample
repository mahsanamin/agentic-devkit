#!/bin/zsh
# Organization-specific profile template
#
# How to use:
#   1. Copy this file to: shell/<your-org>.<os>.profile, where <os> is macos or linux
#      Example: shell/acme.macos.profile
#   2. Set a_company_name='acme' in your configs.profile (or ORG_SLUG in root.config)
#   3. This file will be auto-loaded by generic.profile
#
# The OS family is derived from `uname`, so you never set it by hand. One profile
# per company and OS:
#   shell/acme.macos.profile   (work laptop)
#   shell/acme.linux.profile   (work server)
#   shell/freelance.macos.profile (personal projects)
# The CPU is a separate value, $a_machine_arch (arm64 or x64), with
# $a_docker_platform (linux/arm64 or linux/amd64) derived from it. Branch on
# those inside the profile when something differs by CPU, e.g.
#   [ "$a_machine_arch" = "arm64" ] && export SOME_TOOL_FLAG=...

########################### Organization Exports ####
# export ORG_API_URL="https://api.example.com"
# export GIT_SSH_KEY="$(cat ~/.ssh/your-org-github-key)"

########################### SSH Aliases ####
# alias ssh_staging="ssh user@staging.example.com -i ~/.ssh/org_key"
# alias ssh_prod="ssh user@prod.example.com -i ~/.ssh/org_key"

########################### Directory Aliases ####
# alias cd_api="cd ${a_dir_w_repos}/api-service"
# alias cd_web="cd ${a_dir_w_repos}/web-app"
# alias cd_infra="cd ${a_dir_w_repos}/infrastructure"

########################### Database Aliases ####
# alias db_staging="psql -h staging-db.example.com -U readonly -d mydb"
# alias db_auth_token="aws rds generate-db-auth-token --hostname db.example.com --port 5432 --region us-east-1 --username readonly --profile org_profile"

########################### Build/Deploy ####
# export REPO_URL="s3://your-artifact-repo"
# export ORG_GRADLE_PROJECT_REPO_URL=${REPO_URL}/releases

########################### Mounts ####
# alias m_shared='sudo mount -o resvport -t nfs -o vers=3,proto=tcp server:/share ~/local-mount'

########################### Dev Environment (org-specific tools) ####
# Uncomment if this org needs specific tool versions or paths
# export PATH="/org-specific/tools/bin:$PATH"
