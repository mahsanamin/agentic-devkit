#!/bin/zsh

########################### The one file that is not in git ####
# Copy to ~/my_settings/configs.profile, then add to ~/.zshrc (or ~/.bashrc):
#   source ~/my_settings/configs.profile
#
# Keep it as small as it starts. Everything else lives in git:
#   logic  -> agentic-devkit/shell/bootstrap.profile
#   values -> your root repo's root.config, and root.local.config for this machine
#
# There are two ways to run. Pick one.

########################### Mode 1: with a root instruction repo (preferred) ####
# One repo owns every path on this machine. Set this and you are done: the machine
# name, the repo tiers, the overlays and the brain all come from its root.config.
export A_ROOT_DIR=''

########################### Mode 2: standalone, no root repo ####
# Only used when A_ROOT_DIR is empty. Set the values by hand instead.
if [ -z "$A_ROOT_DIR" ]; then
    # Machine type: 'm1' for Apple Silicon, 'i7' for Intel.
    export a_machine_type='m1'
    # Organization name. Loads <org>.<machine>.profile from your org overlay, if you have one.
    export a_company_name=''

    # Repo tiers, which become the cd_p / cd_w / cd_g aliases. Empty skips that alias.
    export a_dir_p_repos='/path/to/personal/repos'
    export a_dir_w_repos='/path/to/work/repos'
    export a_dir_g_repos='/path/to/global/repos'

    # Where this repo is cloned.
    export MY_WORKFLOW_DIR="${a_dir_p_repos}/agentic-devkit"

    # This machine's name, as an agent should introduce it. It does not have to match
    # the hostname. Selects machine/$A_MACHINE_NAME.md in your overlay.
    export A_MACHINE_NAME=''

    # Optional overlays and brain. Empty is fine, the build still works without them.
    export A_AGENT_OVERLAY_DIR=''
    export A_AGENT_ORG_OVERLAY_DIR=''
    export A_AGENT_BRAIN_DIR=''

    # Optional cloud drive, which becomes cd_gd and cd_gc.
    export a_dir_gd=''
    export a_dir_gc=''
fi

########################### Optional: task suite defaults ####
# Default zellij session for every task start. Unset keeps tasks in this terminal.
# export A_C_TASK_ZELLIJ_SESSION='work'
# Default ticket project key, so a bare number resolves (123 -> PROJ-123).
# export A_TASK_DEFAULT_KEY='PROJ'

########################### Hand off to the devkit ####
# Reads root.config when A_ROOT_DIR is set, maps roles to variable names, loads the
# shared aliases and commands, and wires the org overlay. All of it in git.
if [ -n "$A_ROOT_DIR" ] && [ -f "$A_ROOT_DIR/root.config" ]; then
    # local FIRST: every key in root.config is ${KEY:-default}, so a value set here survives
    # and the paths derived from it follow. The other order expands them before the override.
    [ -f "$A_ROOT_DIR/root.local.config" ] && source "$A_ROOT_DIR/root.local.config"
    source "$A_ROOT_DIR/root.config"
    source "${DEVKIT_DIR}/shell/bootstrap.profile"
else
    source "${MY_WORKFLOW_DIR}/shell/bootstrap.profile"
fi
