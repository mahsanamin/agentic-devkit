#!/bin/bash
#
# a_c_mem_doctor - diagnose (and safely relieve) macOS "red memory" slowdowns
# on a long-uptime dev machine, without rebooting.
#
# The problem it exists for:
#   A machine that runs JVM services degrades on a multi-day curve. A JVM
#   commits heap up to -Xmx and, by default, NEVER returns it to the OS. Ten
#   services that each peaked at 4GB during a busy afternoon still hold 40GB
#   at midnight while idle. macOS compresses and swaps those pages out. Then
#   an idle JVM runs a periodic GC, which must walk a heap that now lives on
#   disk - a swap storm. That is the "nothing is running but the machine is
#   dead" symptom. It compounds daily because more heap ends up swapped.
#
#   Memory only comes back when the owning process EXITS. There is no flush.
#   `sudo purge` does not help: it drops the file cache, not compressed heap.
#
# It reports per APP FAMILY, not per process. A browser or an Electron app
# splits into dozens of helpers, so no single process ever looks big enough to
# blame while the family holds many GB. Families are what you actually quit.
#
# What it does:
#   report (default, READ-ONLY) - swap + compressor verdict, memory by app
#     family, every JVM with its -Xmx and age, reclaimable build daemons, and
#     restart candidates with the memory each would return.
#   -i / --interactive - after the report, offer a numbered menu of ways out,
#     each with the memory it frees and its risk. You pick one, it acts, shows
#     the swap delta, and offers a re-scan. Apps are quit GRACEFULLY (tabs and
#     session preserved), never killed. It refuses to touch the process tree
#     this script is running inside.
#   --reclaim - stop only what is always safe to stop and respawns on demand:
#     idle Gradle / Kotlin / Maven daemons, and forked test JVMs idle longer
#     than STALE_HOURS. If a Gradle WORKER is alive a build is in flight, and
#     it refuses everything Gradle-related (a worker only exists during a
#     build, so killing it fails that build). --force overrides. It NEVER
#     touches your services, your IDE, or system processes.
#
# Memory comes from top(1), not ps(1). ps rss is resident-only, so on a
# thrashing machine it understates the worst offenders by design: once their
# pages are compressed or swapped out their rss SHRINKS and they look
# innocent. Measured on a live box, ps reported WindowServer at 198MB where
# its real footprint was 2756MB. top MEM is phys_footprint (what Activity
# Monitor shows) and CMPRS is the compressed portion.
#
# Usage:
#   a_c_mem_doctor                  Report only. Changes nothing.
#   a_c_mem_doctor --deep           Also show per-process compressed/swapped
#                                   footprint for the top JVMs (slower).
#   a_c_mem_doctor --procs          Also show the raw per-process table.
#   a_c_mem_doctor -i               Report, then offer a menu of ways out.
#   a_c_mem_doctor --reclaim        Report, then stop safe reclaimables.
#   a_c_mem_doctor --reclaim -n     Show what --reclaim would kill, kill nothing.
#   a_c_mem_doctor --top 20         Rows per table (default 12).
#   a_c_mem_doctor --force          Allow reclaim even during a live build.
#   a_c_mem_doctor --help           Show this help.
#
# Tuning (env vars):
#   STALE_HOURS   Idle age before a forked test JVM is reclaimable  (default 2)
#   BIG_MB        Family size that makes it a restart candidate     (default 1024)
#   OLD_DAYS      Age above which a big family is a candidate        (default 2)
#
# When the report is red and --reclaim is not enough, the escalation ladder is:
#   1. Restart the fattest JVM services one at a time (returns their heap).
#   2. Quit and reopen the big Electron/browser families.
#   3. Quit and reopen Docker Desktop (its VM never gives memory back either).
#   4. a_c_restart_login  (logout/login: drains all user memory, no reboot,
#      and the box stays up and reachable over SSH).
#
# The durable fix is not this script, it is making the JVMs give memory back:
#   -XX:+UseG1GC -XX:MinHeapFreeRatio=10 -XX:MaxHeapFreeRatio=25 \
#   -XX:G1PeriodicGCInterval=300000
#   (JDK 12+. On JDK 17+ ZGC uncommits by default: -XX:+ZUncommit
#    -XX:ZUncommitDelay=300.) Plus a real -Xmx per service, and in
#   ~/.gradle/gradle.properties: org.gradle.jvmargs=-Xmx2g and
#   org.gradle.daemon.idletimeout=1800000.
#
# Exit codes: 0 healthy, 1 degrading, 2 critical (so it can gate a scheduled run).

set -uo pipefail

STALE_HOURS="${STALE_HOURS:-2}"
BIG_MB="${BIG_MB:-1024}"
OLD_DAYS="${OLD_DAYS:-2}"

TOP=12
DRY_RUN=0
RECLAIM=0
DEEP=0
SHOW_PROCS=0
INTERACTIVE=0
FORCE=0

if [ -t 1 ]; then
    RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; DIM='\033[2m'; BOLD='\033[1m'; NC='\033[0m'
else
    RED=''; GREEN=''; YELLOW=''; BLUE=''; DIM=''; BOLD=''; NC=''
fi

while [ $# -gt 0 ]; do
    case "$1" in
        -n|--dry-run) DRY_RUN=1 ;;
        -r|--reclaim) RECLAIM=1 ;;
        -d|--deep)    DEEP=1 ;;
        -p|--procs)   SHOW_PROCS=1 ;;
        -i|--interactive) INTERACTIVE=1 ;;
        -f|--force)   FORCE=1 ;;
        -t|--top)     shift; TOP="${1:-12}" ;;
        -h|--help)    awk 'NR>1 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "$0"; exit 0 ;;
        *) echo "Unknown option: $1" >&2; exit 2 ;;
    esac
    shift
done

[ "$(uname -s)" = "Darwin" ] || { echo "a_c_mem_doctor: macOS only" >&2; exit 2; }

log()  { printf "%b\n" "$*"; }
rule() { log "${DIM}------------------------------------------------------------${NC}"; }
head2(){ log ""; log "${BLUE}${BOLD}$1${NC}"; }

# Shared awk helpers.
#   etime_secs - macOS ps prints elapsed as SS, MM:SS, HH:MM:SS or DD-HH:MM:SS.
#   family     - the owning app bundle. The FIRST ".app/" in the path is the
#                top-level bundle, so every Chrome helper, however deeply
#                nested, rolls up to "Google Chrome". Non-bundled processes
#                fall back to their binary name.
AWKLIB='
function etime_secs(e,   a, b, n, d, s) {
    d = 0
    if (e ~ /-/) { split(e, a, "-"); d = a[1]; e = a[2] }
    n = split(e, b, ":")
    if (n == 3)      s = b[1]*3600 + b[2]*60 + b[3]
    else if (n == 2) s = b[1]*60 + b[2]
    else             s = b[1]
    return d*86400 + s
}
function human_age(sec) {
    if (sec >= 86400) return sprintf("%dd", sec/86400)
    if (sec >= 3600)  return sprintf("%dh", sec/3600)
    return sprintf("%dm", sec/60)
}
function tokb(v,   u, n) {
    gsub(/[+*]$/, "", v)
    u = substr(v, length(v), 1)
    n = substr(v, 1, length(v) - 1) + 0
    if (u == "B") return n / 1024
    if (u == "K") return n
    if (u == "M") return n * 1024
    if (u == "G") return n * 1048576
    if (u == "T") return n * 1073741824
    return v + 0
}
function human_mb(mb) {
    if (mb >= 1024) return sprintf("%.2f GB", mb/1024)
    return sprintf("%.0f MB", mb)
}
function label(cmd) {
    if (cmd ~ /KotlinCompileDaemon/)                     return "Kotlin compile daemon"
    if (cmd ~ /GradleWorkerMain|gradle-worker-classpath/) return "Gradle worker"
    if (cmd ~ /GradleDaemon|org\.gradle\.launcher\.daemon/) return "Gradle daemon"
    if (cmd ~ /MavenDaemon|mvnd/)                        return "Maven daemon (mvnd)"
    if (cmd ~ /ForkedBooter|surefire|failsafe/)          return "orphaned test fork"
    return "build process"
}
function is_vm(p) {
    return (p ~ /Virtualization\.VirtualMachine|com\.docker\.virtualization|qemu|VirtualBoxVM|com\.utmapp/)
}
function is_system(p) {
    if (is_vm(p)) return 0
    return (p ~ /^\/System\// || p ~ /^\/usr\// || p ~ /^\/sbin\// || p ~ /^\/bin\//)
}
function family(p,   i, pre) {
    i = index(p, ".app/")
    if (i > 0) { pre = substr(p, 1, i-1); sub(/.*\//, "", pre); return pre }
    sub(/.*\//, "", p)
    return p
}'

# ---- 1. verdict ---------------------------------------------------------
PAGESIZE=$(sysctl -n hw.pagesize)
TOTAL_GB=$(sysctl -n hw.memsize | awk '{printf "%.0f", $1/1073741824}')

read -r SWAP_TOTAL SWAP_USED SWAP_PCT <<<"$(sysctl -n vm.swapusage | awk '
    { for (i=1;i<=NF;i++) {
        if ($i=="total") { t=$(i+2); sub(/M$/,"",t) }
        if ($i=="used")  { u=$(i+2); sub(/M$/,"",u) } } }
    END { printf "%.0f %.0f %.0f", t, u, (t>0 ? u*100/t : 0) }')"

read -r COMP_GB WIRED_GB <<<"$(vm_stat | awk -v ps="$PAGESIZE" '
    /Pages occupied by compressor/ { gsub(/\./,""); comp=$NF }
    /Pages wired down/             { gsub(/\./,""); wired=$NF }
    END { printf "%.1f %.1f", comp*ps/1073741824, wired*ps/1073741824 }')"

FREE_PCT=$(memory_pressure 2>/dev/null | awk -F': *' '/free percentage/ {gsub(/%/,"",$2); print $2}')
[ -n "$FREE_PCT" ] || FREE_PCT="?"

UP=$(uptime | sed -E 's/.*up +(.*), +[0-9]+ users.*/\1/; s/^ *//')
LOADAVG=$(uptime | sed -E 's/.*load averages?: *//')

STATUS=0; VERDICT="${GREEN}healthy${NC}"; WHY="swap and compressor are within normal range"
COMP_INT=${COMP_GB%.*}
if [ "$SWAP_PCT" -ge 60 ] || [ "$COMP_INT" -ge $((TOTAL_GB / 4)) ]; then
    STATUS=1; VERDICT="${YELLOW}degrading${NC}"; WHY="swap and/or the compressor are filling up; slowdowns will worsen"
fi
if [ "$SWAP_PCT" -ge 85 ]; then
    STATUS=2; VERDICT="${RED}critical${NC}"; WHY="swap is nearly full, the machine is thrashing"
fi

log "${BOLD}a_c_mem_doctor${NC}   ${DIM}$(hostname -s)   ${TOTAL_GB}GB RAM   up ${UP}${NC}"
rule
log "verdict     $VERDICT  ${DIM}${WHY}${NC}"
log "swap        ${SWAP_USED}M of ${SWAP_TOTAL}M used  (${SWAP_PCT}%)"
log "compressor  ${COMP_GB}GB compressed    wired ${WIRED_GB}GB    free ${FREE_PCT}%"
log "load        ${LOADAVG}"

# ---- 2. memory by app family -------------------------------------------
# ps(1) rss is resident-only, so on a thrashing machine it UNDERSTATES the
# worst offenders by design: once their pages are compressed or swapped out,
# their rss shrinks and they look innocent. top's MEM is phys_footprint (what
# Activity Monitor shows) and CMPRS is the compressed portion. We take memory
# from top and full binary paths from ps, joined on pid.
TOPDUMP=$(top -l 1 -n 9999 -stats pid,mem,cmprs 2>/dev/null | awk '$1 ~ /^[0-9]+$/ && NF >= 3')
PSDUMP=$(ps -Ao pid=,etime=,comm= 2>/dev/null)

if [ -z "$TOPDUMP" ]; then
    log ""
    log "  ${YELLOW}top(1) returned nothing; falling back to ps rss (understates swapped processes)${NC}"
    TOPDUMP=$(ps -Ao pid=,rss= 2>/dev/null | awk '{print $1, $2"K", "0B"}')
fi

JOINED=$(awk "$AWKLIB"'
NR == FNR { mem[$1] = tokb($2); cmp[$1] = tokb($3); next }
{
    pid = $1; path = substr($0, index($0, $3))
    if (!(pid in mem)) next
    printf "%d\t%d\t%d\t%s\t%s\n", mem[pid], cmp[pid], etime_secs($2), pid, path
}' <(printf '%s\n' "$TOPDUMP") <(printf '%s\n' "$PSDUMP"))

FAMILIES=$(printf '%s\n' "$JOINED" | awk -F'\t' "$AWKLIB"'
{
    f = family($5)
    tot[f] += $1; comp[f] += $2; n[f]++
    if (is_system($5)) sys[f] = 1
    if (index($5, ".app/") > 0) app[f] = 1
    if ($3 > old[f]) old[f] = $3
    if ($1 > maxm[f]) { maxm[f] = $1; maxp[f] = $4 }
}
END { for (f in tot) printf "%d\t%d\t%d\t%d\t%s\t%s\t%d\t%d\n", tot[f], n[f], old[f], maxp[f], f, comp[f], (f in sys ? 1 : 0), (f in app ? 1 : 0) }' \
| sort -rn)

head2 "Memory by app family  ${DIM}(footprint, not rss - what you would actually quit)${NC}"
log "  ${DIM}     TOTAL   COMPRESSED   PROCS   OLDEST   APP${NC}"
printf '%s\n' "$FAMILIES" | head -n "$TOP" | awk -F'\t' "$AWKLIB"'
{ printf "  %10s   %10s   %5d   %6s   %s%s\n", human_mb($1/1024), human_mb($6/1024), $2, human_age($3), $5, ($7 == 1 ? "  (system)" : "") }'

ACCOUNTED=$(printf '%s\n' "$FAMILIES" | awk -F'\t' '{s+=$1} END {printf "%.1f", s/1048576}')
log "  ${DIM}total across all families: ${ACCOUNTED} GB${NC}"
if printf '%s\n' "$FAMILIES" | awk -F'\t' '$6 > $1 {found=1} END {exit !found}'; then
    log "  ${DIM}(a compressed figure above the total means VM-backed memory, which is"
    log "  accounted through the hypervisor, not the host. Size the VM, do not quit it.)${NC}"
fi

if [ "$SHOW_PROCS" -eq 1 ]; then
    head2 "Top ${TOP} individual processes"
    log "  ${DIM}     TOTAL   COMPRESSED   OLDEST       PID   PROCESS${NC}"
    printf '%s\n' "$JOINED" | sort -rn | head -n "$TOP" | awk -F'\t' "$AWKLIB"'
    { n = $5; sub(/.*\//, "", n)
      printf "  %10s   %10s   %6s   %7s   %s\n", human_mb($1/1024), human_mb($2/1024), human_age($3), $4, n }'
fi

# ---- 3. the JVMs --------------------------------------------------------
JVMPS=$(ps -Ao pid=,etime=,command= 2>/dev/null \
       | grep -E '(^| )[^ ]*/java( |$)|[[:space:]]-Xmx' \
       | grep -v grep | grep -v 'a_c_mem_doctor')

# A Gradle WORKER only exists while a build is actually running. If any is
# alive, a build is in flight and nothing Gradle-related is safe to stop.
GRADLE_WORKERS=$(printf '%s\n' "$JVMPS" | grep -cE 'GradleWorkerMain|gradle-worker-classpath' 2>/dev/null || echo 0)
GRADLE_WORKERS=$(printf '%s' "$GRADLE_WORKERS" | tr -d ' \n')
BUILD_ACTIVE=0
[ "${GRADLE_WORKERS:-0}" -gt 0 ] && BUILD_ACTIVE=1

head2 "JVMs  ${DIM}(heap is committed up to -Xmx and is not returned while the process lives)${NC}"
if [ -z "$JVMPS" ]; then
    log "  ${DIM}none running${NC}"
    JVM_GB=0
else
    JVMROWS=$(awk "$AWKLIB"'
    function jvm_name(s,   n, i, t, skip) {
        n = split(s, t, /[ ]+/)
        for (i = 1; i <= n; i++)
            if (t[i] == "-jar" && i < n) { sub(/.*\//, "", t[i+1]); return t[i+1] }
        skip = 0
        for (i = 2; i <= n; i++) {
            if (skip) { skip = 0; continue }
            if (t[i] ~ /^-(cp|classpath|-class-path|-module-path|p|m)$/) { skip = 1; continue }
            if (t[i] ~ /^-/) continue
            sub(/.*\//, "", t[i]); return t[i]
        }
        return "?"
    }
    NR == FNR { mem[$1] = tokb($2); cmp[$1] = tokb($3); next }
    {
        pid = $1; cmd = substr($0, index($0, $3))
        m = (pid in mem) ? mem[pid] : 0
        c = (pid in mem) ? cmp[pid] : 0
        xmx = "-"
        if (match(cmd, /-Xmx[0-9]+[kKmMgG]?/)) xmx = substr(cmd, RSTART+4, RLENGTH-4)
        kind = (cmd ~ /GradleWorkerMain|gradle-worker-classpath/) ? "worker" \
             : (cmd ~ /GradleDaemon|org\.gradle\.launcher\.daemon/) ? "daemon" \
             : (cmd ~ /KotlinCompileDaemon/) ? "kotlin" \
             : (cmd ~ /ForkedBooter|surefire|failsafe/) ? "test-fork" : "service"
        printf "%d\t%d\t%d\t%s\t%s\t%s\t%s\n", m, c, etime_secs($2), pid, xmx, kind, jvm_name(cmd)
    }' <(printf '%s\n' "$TOPDUMP") <(printf '%s\n' "$JVMPS") | sort -rn)

    log "  ${DIM}     TOTAL   COMPRESSED   XMX      AGE       PID   KIND       NAME${NC}"
    printf '%s\n' "$JVMROWS" | head -n "$TOP" | awk -F'\t' "$AWKLIB"'
    { printf "  %10s   %10s   %-6s %5s   %7s   %-9s  %.40s\n", human_mb($1/1024), human_mb($2/1024), $5, human_age($3), $4, $6, $7 }'
    JVM_GB=$(printf '%s\n' "$JVMROWS" | awk -F'\t' '{s+=$1} END {printf "%.1f", s/1048576}')
    JVM_N=$(printf '%s\n' "$JVMROWS" | wc -l | tr -d ' ')
    log "  ${BOLD}${JVM_N} JVMs holding ${JVM_GB} GB${NC}"
    if [ "$BUILD_ACTIVE" -eq 1 ]; then
        log "  ${YELLOW}A Gradle build is running right now (${GRADLE_WORKERS} workers).${NC}"
        log "  ${DIM}Workers only exist during a build, so this is live work, not stale heap.${NC}"
    fi
fi


# ---- 4. what is safely reclaimable right now ----------------------------
STALE_SECS=$((STALE_HOURS * 3600))

DAEMONS=$(ps -Ao pid=,etime=,command= 2>/dev/null \
    | grep -E 'GradleDaemon|KotlinCompileDaemon|org\.gradle\.launcher\.daemon|GradleWorkerMain|gradle-worker-classpath|MavenDaemon|mvnd' \
    | grep -v grep | grep -v 'a_c_mem_doctor')

FORKS=$(ps -Ao pid=,etime=,command= 2>/dev/null \
    | grep -E 'surefire|failsafe|ForkedBooter' | grep -v grep | grep -v 'a_c_mem_doctor' \
    | awk "$AWKLIB"'{ if (etime_secs($2) > '"$STALE_SECS"') print }')

head2 "Safe to reclaim now  ${DIM}(respawn on demand, no service impact)${NC}"
RECLAIM_MB=0
RECLAIMABLE=""
if [ "$BUILD_ACTIVE" -eq 1 ]; then
    log "  ${YELLOW}Nothing - a Gradle build is in flight (${GRADLE_WORKERS} workers active).${NC}"
    log "  ${DIM}Stopping the daemon or its workers now would fail that build. Re-run when"
    log "  it finishes, or pass --force if you intend to abort the build.${NC}"
    [ "${FORCE:-0}" -eq 1 ] && RECLAIMABLE=$(printf '%s\n%s\n' "$DAEMONS" "$FORKS" | grep -v '^[[:space:]]*$')
else
    RECLAIMABLE=$(printf '%s\n%s\n' "$DAEMONS" "$FORKS" | grep -v '^[[:space:]]*$')
fi

if [ -z "$RECLAIMABLE" ]; then
    [ "$BUILD_ACTIVE" -eq 0 ] && log "  ${DIM}nothing - no idle build daemons or orphaned test forks${NC}"
else
    RECLAIM_ROWS=$(awk "$AWKLIB"'
    NR == FNR { mem[$1] = tokb($2); next }
    { pid = $1; cmd = substr($0, index($0, $3))
      printf "%d\t%d\t%s\t%s\n", (pid in mem ? mem[pid] : 0), etime_secs($2), pid, label(cmd) }' \
      <(printf '%s\n' "$TOPDUMP") <(printf '%s\n' "$RECLAIMABLE") | sort -rn)
    printf '%s\n' "$RECLAIM_ROWS" | awk -F'\t' "$AWKLIB"'
    { printf "  %10s   %5s   %7s   %s\n", human_mb($1/1024), human_age($2), $3, $4 }'
    RECLAIM_MB=$(printf '%s\n' "$RECLAIM_ROWS" | awk -F'\t' '{s+=$1} END {printf "%.0f", s/1024}')
    log "  ${BOLD}total: ${RECLAIM_MB} MB${NC}"
fi


# ---- 5. restart candidates (reported, never auto-killed) ----------------
OLD_SECS=$((OLD_DAYS * 86400))
head2 "Restart candidates  ${DIM}(family >${BIG_MB}MB, running >${OLD_DAYS}d, user-quittable)${NC}"
CANDIDATES=$(printf '%s\n' "$FAMILIES" | awk -F'\t' \
    -v big="$((BIG_MB * 1024))" -v old="$OLD_SECS" '$1 > big && $3 > old && $7 != 1')
if [ -z "$CANDIDATES" ]; then
    log "  ${DIM}none${NC}"
    CAND_GB=0
else
    printf '%s\n' "$CANDIDATES" | head -n "$TOP" | awk -F'\t' "$AWKLIB"'
    { printf "  %10s   %5d procs   up %-5s   %s\n", human_mb($1/1024), $2, human_age($3), $5 }'
    CAND_GB=$(printf '%s\n' "$CANDIDATES" | awk -F'\t' '{s+=$1} END {printf "%.1f", s/1048576}')
    log "  ${BOLD}restarting all of these would return roughly ${CAND_GB} GB${NC}"
fi

DOCKER_UP=0
DOCK_CFG_MB=0
if pgrep -f 'com.docker.virtualization|Docker Desktop|Virtualization.VirtualMachine' >/dev/null 2>&1; then
    DOCKER_UP=1
    DOCK_MB=$(printf '%s\n' "$JOINED" | awk -F'\t' '$5 ~ /[Dd]ocker|Virtualization/ {s+=$1} END {printf "%.0f", s/1024}')
    # The VM's real cost is what it is ALLOCATED, not what top attributes to it:
    # a hypervisor VM reserves its full allocation up front and never gives it
    # back while it runs, whether containers are busy or idle.
    for f in "$HOME/Library/Group Containers/group.com.docker/settings-store.json" \
             "$HOME/Library/Group Containers/group.com.docker/settings.json"; do
        [ -f "$f" ] || continue
        v=$(grep -oE '"[Mm]emoryMiB"[[:space:]]*:[[:space:]]*[0-9]+' "$f" 2>/dev/null | grep -oE '[0-9]+$' | head -1)
        [ -n "$v" ] && { DOCK_CFG_MB="$v"; break; }
    done
    if [ "$DOCK_CFG_MB" -gt 0 ]; then
        PCT=$(( DOCK_CFG_MB * 100 / (TOTAL_GB * 1024) ))
        if [ "$PCT" -ge 33 ]; then
            log "  ${YELLOW}Docker Desktop's VM is allocated ${DOCK_CFG_MB} MB - ${PCT}% of this machine's RAM.${NC}"
        else
            log "  ${DIM}Docker Desktop's VM is allocated ${DOCK_CFG_MB} MB (${PCT}% of RAM).${NC}"
        fi
        log "  ${DIM}A VM reserves its whole allocation up front and holds it while it runs,"
        log "  idle or not. Quitting Docker frees it; lowering the allocation keeps it"
        log "  freed. Docker Desktop > Settings > Resources > Memory.${NC}"
    else
        log "  ${DIM}Docker Desktop is running (~${DOCK_MB} MB incl. its VM). The VM never"
        log "  returns memory either; quit and reopen, or lower its RAM in settings.${NC}"
    fi
fi


# ---- 6. optional deep per-process footprint -----------------------------
if [ "$DEEP" -eq 1 ]; then
    head2 "Per-process swap detail  ${DIM}(how much of each heap now lives on disk)${NC}"
    if ! command -v vmmap >/dev/null 2>&1; then
        log "  ${YELLOW}vmmap(1) is not available on this system${NC}"
    else
        DEEP_PIDS=$(printf '%s\n' "$JVMPS" | head -6 | awk '{print $1}')
        [ -n "$DEEP_PIDS" ] || DEEP_PIDS=$(printf '%s\n' "$FAMILIES" | head -6 | awk -F'\t' '{print $4}')
        log "  ${DIM}    PID   FOOTPRINT   SWAPPED-OUT   PROCESS${NC}"
        for pid in $DEEP_PIDS; do
            [ -n "$pid" ] || continue
            name=$(ps -o comm= -p "$pid" 2>/dev/null | sed 's#.*/##')
            [ -n "$name" ] || continue
            vmmap -summary "$pid" 2>/dev/null | awk -v pid="$pid" -v name="$name" '
                /^Physical footprint:/            { fp = $NF }
                /^Writable regions:/              { for (i=1;i<=NF;i++) if ($i ~ /^swapped_out=/) { sw = $i; sub(/^swapped_out=/, "", sw) } }
                END {
                    if (fp == "") fp = "?"
                    if (sw == "") sw = "-"
                    printf "  %7s   %9s   %11s   %s\n", pid, fp, sw, name
                }'
        done
        log "  ${DIM}A large swapped-out figure is the smoking gun: every GC on that heap"
        log "  must page it back in, which is what freezes the machine while idle.${NC}"
    fi
fi

# ---- 7. reclaim ---------------------------------------------------------
if [ "$RECLAIM" -eq 1 ]; then
    head2 "Reclaim"
    if [ -z "$RECLAIMABLE" ]; then
        log "  ${DIM}nothing to do${NC}"
    else
        for pid in $(printf '%s\n' "$RECLAIMABLE" | awk '{print $3}'); do
            [ -n "$pid" ] || continue
            desc=$(ps -o command= -p "$pid" 2>/dev/null | awk "$AWKLIB"'{ print label($0) }')
            [ -n "$desc" ] || continue
            if [ "$DRY_RUN" -eq 1 ]; then
                log "  ${DIM}[dry-run] would stop${NC} $pid  $desc"
            elif kill "$pid" 2>/dev/null; then
                log "  ${GREEN}stopped${NC} $pid  $desc"
            else
                log "  ${YELLOW}could not stop${NC} $pid  $desc"
            fi
        done
        if [ "$DRY_RUN" -eq 0 ]; then
            sleep 3
            SWAP_AFTER=$(sysctl -n vm.swapusage | awk '
                { for (i=1;i<=NF;i++) if ($i=="used") { u=$(i+2); sub(/M$/,"",u) } }
                END { printf "%.0f", u }')
            log ""
            log "  swap: ${SWAP_USED}M -> ${SWAP_AFTER}M"
            log "  ${DIM}Swap drains lazily. Re-run the report in a minute for the settled number.${NC}"
        fi
    fi
fi

# ---- 8. what to do next -------------------------------------------------
if [ "$STATUS" -gt 0 ]; then
    head2 "Next steps"
    i=1
    if [ "$RECLAIM_MB" -gt 0 ] && [ "$RECLAIM" -eq 0 ]; then
        log "  $i. ${BOLD}a_c_mem_doctor --reclaim${NC}   frees ~${RECLAIM_MB} MB of idle build daemons"
        i=$((i+1))
    fi
    if [ -n "$JVMPS" ]; then
        log "  $i. restart the fattest JVM services one at a time (JVMs section)"
        i=$((i+1))
    fi
    if [ -n "$CANDIDATES" ]; then
        log "  $i. quit and reopen the families above (~${CAND_GB} GB)"
        i=$((i+1))
    fi
    if [ "$DOCKER_UP" -eq 1 ]; then
        log "  $i. quit and reopen Docker Desktop"
        i=$((i+1))
    fi
    log "  $i. ${BOLD}a_c_restart_login${NC}   logout/login: drains everything, no reboot,"
    log "     the machine stays up and reachable over SSH"
    if [ -n "$JVMPS" ]; then
        log ""
        log "  ${DIM}Durable fix so this stops recurring: give the JVMs flags that hand"
        log "  memory back to the OS. See a_c_mem_doctor --help.${NC}"
    fi
fi

# ---- 9. interactive: pick a way out -------------------------------------
ask() {
    local __var="$1" __prompt="$2" __ans=""
    printf "%b" "$__prompt"
    if { exec 3< /dev/tty; } 2>/dev/null; then
        read -r __ans <&3 2>/dev/null || __ans=""
        exec 3<&-
    else
        read -r __ans 2>/dev/null || __ans=""
    fi
    printf -v "$__var" '%s' "$__ans"
}

swap_used_mb() {
    sysctl -n vm.swapusage | awk '
        { for (i=1;i<=NF;i++) if ($i=="used") { u=$(i+2); sub(/M$/,"",u) } }
        END { printf "%.0f", u }'
}

# Never offer to kill the process tree we are running inside.
SELF_CHAIN=""
_p=$$
while [ -n "$_p" ] && [ "$_p" -gt 1 ]; do
    SELF_CHAIN="$SELF_CHAIN $_p"
    _p=$(ps -o ppid= -p "$_p" 2>/dev/null | tr -d ' ')
done

family_pids() {
    printf '%s\n' "$JOINED" | awk -F'\t' -v want="$1" "$AWKLIB"'family($5) == want { print $4 }'
}
family_pids_older() {
    printf '%s\n' "$JOINED" | awk -F'\t' -v want="$1" -v mins="$2" "$AWKLIB"'
        family($5) == want && $3 > (mins * 60) { print $4 }'
}
family_mb() {
    printf '%s\n' "$FAMILIES" | awk -F'\t' -v want="$1" '$5 == want { printf "%.0f", $1/1024 }'
}

# Quit an app bundle gracefully (preserves tabs/session), then report.
quit_family() {
    local fam="$1" pids kept n
    pids=$(family_pids "$fam")
    kept=""
    for pid in $pids; do
        case " $SELF_CHAIN " in *" $pid "*) kept="$kept $pid" ;; esac
    done
    if [ -n "$kept" ]; then
        log "  ${YELLOW}Skipping$kept - that is this session's own process tree.${NC}"
    fi
    if osascript -e "tell application \"$fam\" to quit" >/dev/null 2>&1; then
        log "  ${GREEN}asked \"$fam\" to quit gracefully${NC} ${DIM}(session/tabs preserved)${NC}"
        sleep 5
    fi
    n=0
    for pid in $pids; do
        case " $SELF_CHAIN " in *" $pid "*) continue ;; esac
        kill -0 "$pid" 2>/dev/null && n=$((n+1))
    done
    if [ "$n" -gt 0 ]; then
        log "  ${DIM}${n} process(es) still alive.${NC}"
        ask yn "  Force-kill them? [y/N] "
        if [ "$yn" = "y" ] || [ "$yn" = "Y" ]; then
            for pid in $pids; do
                case " $SELF_CHAIN " in *" $pid "*) continue ;; esac
                kill "$pid" 2>/dev/null
            done
            sleep 3
            log "  ${GREEN}done${NC}"
        fi
    fi
}

if [ "$INTERACTIVE" -eq 1 ]; then
    head2 "Options - pick one"
    OPT_N=0; OPT_KEY=""; OPT_ARG=""

    add_opt() {
        OPT_N=$((OPT_N+1))
        OPT_KEY="$OPT_KEY $1"
        OPT_ARG="$OPT_ARG|$2"
        log "  ${BOLD}${OPT_N})${NC} $3"
    }

    if [ "$RECLAIM_MB" -gt 0 ]; then
        add_opt reclaim "" "Stop idle build daemons + orphaned test forks  ${GREEN}~${RECLAIM_MB} MB${NC}  ${DIM}safe, they respawn${NC}"
    fi

    if [ -n "$CANDIDATES" ]; then
        while IFS=$'\t' read -r tot n old maxp fam comp sys isapp; do
            [ -n "$fam" ] || continue
            [ "${sys:-0}" = "1" ] && continue
            mb=$((tot / 1024))
            if [ "${isapp:-0}" = "1" ]; then
                add_opt quit "$fam" "Quit and reopen ${BOLD}$fam${NC}  ${GREEN}~${mb} MB${NC}  ${DIM}graceful, restores on relaunch${NC}"
            else
                add_opt killfam "$fam" "Kill the ${BOLD}$fam${NC} background processes ($n)  ${GREEN}~${mb} MB${NC}  ${YELLOW}no window, no graceful quit${NC}"
            fi
        done <<EOF
$(printf '%s\n' "$CANDIDATES" | head -5)
EOF
    fi

    if [ "$DOCKER_UP" -eq 1 ]; then
        if [ "$DOCK_CFG_MB" -gt 0 ]; then
            add_opt docker "" "Quit Docker Desktop  ${GREEN}~${DOCK_CFG_MB} MB${NC} ${DIM}(its whole VM allocation)  stops containers${NC}"
        else
            add_opt docker "" "Quit Docker Desktop  ${GREEN}~${DOCK_MB} MB${NC}  ${DIM}stops containers${NC}"
        fi
    fi

    add_opt deep   "" "Show me which processes hold the most swap first ${DIM}(diagnostic only)${NC}"
    add_opt logout "" "${BOLD}Log out and back in${NC}  ${GREEN}frees everything${NC}  ${YELLOW}closes all apps, no reboot, stays reachable over SSH${NC}"

    log ""
    log "  ${BOLD}0)${NC} Do nothing and exit"
    log ""
    ask CHOICE "$(printf "  Choice [0-%d]: " "$OPT_N")"
    [ -n "$CHOICE" ] || CHOICE=0

    if [ "$CHOICE" = "0" ]; then
        log "  ${DIM}nothing changed${NC}"
        exit "$STATUS"
    fi

    KEY=$(printf '%s' "$OPT_KEY" | awk -v i="$CHOICE" '{print $i}')
    ARG=$(printf '%s' "$OPT_ARG" | awk -F'|' -v i="$((CHOICE+1))" '{print $i}')
    [ -n "$KEY" ] || { log "  ${RED}invalid choice${NC}"; exit "$STATUS"; }

    SWAP_BEFORE=$(swap_used_mb)
    log ""
    case "$KEY" in
        reclaim)
            for pid in $(printf '%s\n' "$RECLAIMABLE" | awk '{print $1}'); do
                [ -n "$pid" ] || continue
                desc=$(ps -o command= -p "$pid" 2>/dev/null | awk "$AWKLIB"'{ print label($0) }')
                [ -n "$desc" ] || continue
                kill "$pid" 2>/dev/null && log "  ${GREEN}stopped${NC} $pid  $desc"
            done
            sleep 3 ;;
        quit)     quit_family "$ARG" ;;
        killfam)
            ask MINAGE "  Kill $ARG processes older than how many hours? [enter = ${OLD_DAYS}d, 0 = all] "
            case "$MINAGE" in
                ""|*[!0-9]*) MINS=$((OLD_DAYS * 1440)); AGEDESC="${OLD_DAYS}d" ;;
                0)           MINS=0;                    AGEDESC="any age" ;;
                *)           MINS=$((MINAGE * 60));     AGEDESC="${MINAGE}h" ;;
            esac
            VICTIMS=""
            for pid in $(family_pids_older "$ARG" "$MINS"); do
                case " $SELF_CHAIN " in *" $pid "*) continue ;; esac
                VICTIMS="$VICTIMS $pid"
            done
            NVIC=$(printf '%s' "$VICTIMS" | wc -w | tr -d ' ')
            NALL=$(family_pids "$ARG" | wc -l | tr -d ' ')
            if [ "$NVIC" -eq 0 ]; then
                log "  ${DIM}nothing in $ARG is older than $AGEDESC${NC}"; exit "$STATUS"
            fi
            log "  ${YELLOW}Will kill ${NVIC} of ${NALL} ${ARG} process(es), those older than ${AGEDESC}.${NC}"
            [ "$((NALL - NVIC))" -gt 0 ] && log "  ${DIM}$((NALL - NVIC)) left alone: newer than ${AGEDESC}, or this session's own tree${NC}"
            ask yn "  Confirm? [y/N] "
            if [ "$yn" = "y" ] || [ "$yn" = "Y" ]; then
                for pid in $VICTIMS; do kill "$pid" 2>/dev/null; done
                sleep 3; log "  ${GREEN}killed ${NVIC} process(es)${NC}"
            else
                log "  ${DIM}cancelled${NC}"; exit "$STATUS"
            fi ;;
        docker)
            osascript -e 'quit app "Docker Desktop"' >/dev/null 2>&1 || osascript -e 'quit app "Docker"' >/dev/null 2>&1
            log "  ${GREEN}asked Docker to quit${NC} ${DIM}(reopen it when you need it)${NC}"
            sleep 5 ;;
        deep)
            exec "$0" --deep --top "$TOP" ;;
        logout)
            log "  ${YELLOW}This closes every app. Unsaved work will be lost.${NC}"
            ask yn "  Type 'logout' to confirm: "
            if [ "$yn" = "logout" ]; then sudo killall loginwindow
            else log "  ${DIM}cancelled${NC}"; exit "$STATUS"; fi ;;
    esac

    SWAP_AFTER=$(swap_used_mb)
    log ""
    log "  swap: ${SWAP_BEFORE}M -> ${SWAP_AFTER}M   ${DIM}(drains lazily, give it a minute)${NC}"
    ask again "  Re-scan now? [Y/n] "
    case "$again" in n|N) : ;; *) exec "$0" -i --top "$TOP" ;; esac
fi


exit "$STATUS"
