#!/usr/bin/env bash
#
# a_c_claude_memory - single-file engine for generated global agent guidance.
#
# The rules file loads on every request, and on most machines it is the one thing
# that is hand-typed and version-controlled nowhere. This composes it from source
# files that DO live in git, between markers, and leaves everything outside the
# markers alone.
#
# Sources, in the order they are rendered:
#   0. root      $A_ROOT_DIR/ROOT.md                          (the entry point, if present)
#   1. core      $MY_WORKFLOW_DIR/memory/core-rules.md        (generic, public)
#   2. machine   $A_AGENT_OVERLAY_DIR/machine/$A_MACHINE_NAME.md   (identity + role)
#   3. rules     $A_AGENT_OVERLAY_DIR/machine/rules.md       (personal always-on rules)
#   4. glossary  $A_AGENT_OVERLAY_DIR/machine/glossary.md    (shorthand -> what to do)
#   5. org       $A_AGENT_ORG_OVERLAY_DIR/machine/*          (work-only machine facts)
#   6. pointers  the root repo when set, else generated from the repo paths
#
# Everything but (1) is optional: a machine with no overlay still gets a valid file.
#
# Usage:
#   a_c_claude_memory build     # regenerate Claude's managed region in place
#   a_c_claude_memory diff      # show what build would change (no writes)
#   a_c_claude_memory status    # sources found, region present, in sync?
#   a_c_claude_memory check     # exit 1 if out of sync (for doctor/CI)
#   a_c_claude_memory render    # print the region to stdout
#
# Flags: -n/--dry-run (same as diff for build), -f/--file <path> (target file)

set -euo pipefail

BEGIN_MARK='<!-- >>> agentic-devkit: managed memory >>> -->'
END_MARK='<!-- <<< agentic-devkit: managed memory <<< -->'
# Superseded by the region above; absorbed and removed on build.
OLD_BEGIN='<!-- >>> agentic-devkit hint >>> -->'
OLD_END='<!-- <<< agentic-devkit hint <<< -->'

TARGET="${CLAUDE_MEMORY_FILE:-$HOME/.claude/CLAUDE.md}"
DRY_RUN=0
FORCE=0
CMD=""

if [ -t 1 ]; then
  R=$'\033[0m'; B=$'\033[0;34m'; G=$'\033[0;32m'; Y=$'\033[0;33m'; RED=$'\033[0;31m'; D=$'\033[2m'
else
  R=""; B=""; G=""; Y=""; RED=""; D=""
fi

die() { echo "${RED}error:${R} $*" >&2; exit 1; }

while [ $# -gt 0 ]; do
  case "$1" in
    build|diff|status|check|render) CMD="$1"; shift ;;
    -n|--dry-run) DRY_RUN=1; shift ;;
    -F|--force) FORCE=1; shift ;;
    -f|--file) TARGET="${2:-}"; [ -n "$TARGET" ] || die "-f needs a path"; shift 2 ;;
    -h|--help) sed -n '3,28p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown argument: $1 (try --help)" ;;
  esac
done
[ -n "$CMD" ] || CMD="status"

[ -n "${MY_WORKFLOW_DIR:-}" ] || die "MY_WORKFLOW_DIR is not set. Source your profile first."
CORE="$MY_WORKFLOW_DIR/memory/core-rules.md"
[ -f "$CORE" ] || die "core rules missing: $CORE"
STANDALONE="$MY_WORKFLOW_DIR/memory/core-rules-standalone.md"

OVERLAY="${A_AGENT_OVERLAY_DIR:-${A_CLAUDE_OVERLAY_DIR:-}}"
ORG_OVERLAY="${A_AGENT_ORG_OVERLAY_DIR:-}"
BRAIN="${A_AGENT_BRAIN_DIR:-${A_CLAUDE_BRAIN_DIR:-}}"
# The shared, company-wide brain. Separate from the private one because it answers a
# different question: what a word means and who owns what, rather than what I am doing.
# It is the most consulted repo in the setup, so it gets a path in the loaded file rather
# than only a role name in the root repo's routing table.
ORG_BRAIN="${A_AGENT_ORG_BRAIN_DIR:-}"
MACHINE="${A_MACHINE_NAME:-}"
RUNTIME_NAME="${AGENT_RUNTIME_NAME:-Claude Code}"
RUNTIME_MAKER="${AGENT_RUNTIME_MAKER:-Anthropic}"
# The root repo, when there is one. It owns the paths and the rules that outlive this
# toolkit, so when it is present this script points at it instead of restating them.
# Optional by design: with A_ROOT_DIR unset everything below still renders standalone.
ROOT_REPO="${A_ROOT_DIR:-}"
[ -n "$ROOT_REPO" ] && [ -f "$ROOT_REPO/ROOT.md" ] || ROOT_REPO=""

MACHINE_FILE=""
RULES_FILE=""
GLOSSARY_FILE=""
if [ -n "$OVERLAY" ] && [ -d "$OVERLAY" ]; then
  [ -n "$MACHINE" ] && [ -f "$OVERLAY/machine/$MACHINE.md" ] && MACHINE_FILE="$OVERLAY/machine/$MACHINE.md"
  [ -f "$OVERLAY/machine/rules.md" ]    && RULES_FILE="$OVERLAY/machine/rules.md"
  [ -f "$OVERLAY/machine/glossary.md" ] && GLOSSARY_FILE="$OVERLAY/machine/glossary.md"
fi

# An org overlay is a SECOND private overlay for work-specific machine facts. It exists
# because the personal overlay is shared and must stay free of company content, so a work
# machine's identity cannot live there. Same three file names, rendered after the personal
# ones so the work layer refines the personal one.
ORG_MACHINE_FILE=""
ORG_RULES_FILE=""
ORG_GLOSSARY_FILE=""
if [ -n "$ORG_OVERLAY" ] && [ -d "$ORG_OVERLAY" ]; then
  [ -n "$MACHINE" ] && [ -f "$ORG_OVERLAY/machine/$MACHINE.md" ] && ORG_MACHINE_FILE="$ORG_OVERLAY/machine/$MACHINE.md"
  [ -f "$ORG_OVERLAY/machine/rules.md" ]    && ORG_RULES_FILE="$ORG_OVERLAY/machine/rules.md"
  [ -f "$ORG_OVERLAY/machine/glossary.md" ] && ORG_GLOSSARY_FILE="$ORG_OVERLAY/machine/glossary.md"
fi

# --- render the managed region -------------------------------------------------

render_region() {
  echo "$BEGIN_MARK"
  echo "<!--"
  echo "  GENERATED by agentic-devkit. Do not edit inside these markers - the next"
  echo "  build overwrites it. Edit the source, then run: a_c_agent_memory build"
  echo ""
  echo "  core     $CORE"
  [ -n "$MACHINE_FILE" ]  && echo "  machine  $MACHINE_FILE"
  [ -n "$RULES_FILE" ]    && echo "  rules    $RULES_FILE"
  [ -n "$GLOSSARY_FILE" ] && echo "  glossary $GLOSSARY_FILE"
  [ -n "$ORG_MACHINE_FILE" ]  && echo "  orgmachine  $ORG_MACHINE_FILE"
  [ -n "$ORG_RULES_FILE" ]    && echo "  orgrules    $ORG_RULES_FILE"
  [ -n "$ORG_GLOSSARY_FILE" ] && echo "  orgglossary $ORG_GLOSSARY_FILE"
  if [ -n "$ROOT_REPO" ]; then
    echo "  root     $ROOT_REPO/ROOT.md (owns the paths and the company rules)"
  else
    echo "  pointers generated from A_AGENT_OVERLAY_DIR / A_AGENT_BRAIN_DIR"
  fi
  echo "-->"
  echo ""
  echo "# Global guidance"
  echo ""

  echo "## Runtime identity"
  echo ""
  echo "This file is rendered for **$RUNTIME_NAME**, made by **$RUNTIME_MAKER**. The machine"
  echo "name below identifies the configured agent environment; it does not replace the runtime"
  echo "provider. When asked who you are, state both the machine identity and this runtime. Never"
  echo "claim to be a different provider, and never copy another agent's provider or model name."
  echo "Only name an exact model when the current runtime exposes it reliably."
  echo ""

  if [ -n "$ROOT_REPO" ]; then
    echo "## Start here: the root instructions"
    echo ""
    echo "One repo owns the rules for company work and every path this machine uses:"
    echo "\`$ROOT_REPO\`. **Read its \`ROOT.md\` first**, then the one file it sends you to."
    echo "Nothing below repeats those rules, so a rule fixed there is fixed everywhere."
    echo ""
    echo "@$ROOT_REPO/ROOT.md"
    echo ""
    echo "Paths live in \`$ROOT_REPO/root.config\`, and nowhere else. Need to know where a repo"
    echo "sits on this machine, read that file. Moving a repo is a change there, not here."
    echo ""
  fi

  cat "$CORE"

  # Rules a root repo owns when there is one. Rendered only when there is not.
  if [ -z "$ROOT_REPO" ] && [ -f "$STANDALONE" ]; then
    echo ""
    cat "$STANDALONE"
  fi

  if [ -n "$MACHINE_FILE" ]; then
    echo ""
    emit_source "$MACHINE_FILE"
  fi
  if [ -n "$RULES_FILE" ]; then
    echo ""
    emit_source "$RULES_FILE"
  fi
  if [ -n "$GLOSSARY_FILE" ]; then
    echo ""
    emit_source "$GLOSSARY_FILE"
  fi
  if [ -n "$ORG_MACHINE_FILE" ]; then
    echo ""
    emit_source "$ORG_MACHINE_FILE"
  fi
  if [ -n "$ORG_RULES_FILE" ]; then
    echo ""
    emit_source "$ORG_RULES_FILE"
  fi
  if [ -n "$ORG_GLOSSARY_FILE" ]; then
    echo ""
    emit_source "$ORG_GLOSSARY_FILE"
  fi

  echo ""
  if [ -n "$ROOT_REPO" ]; then
    echo "## Where things live"
    echo ""
    echo "\`$ROOT_REPO/root.config\` lists every repo and its path. This file does not"
    echo "restate them, because two lists of paths drift and one of them is then wrong."
    echo ""
    echo "After a \`git pull\` in a toolkit repo, re-link with \`./install.sh\` in that repo, then"
    echo "run \`a_c_agent_memory build\` if its memory sources changed."
  else
  echo "## Where things live"
  echo ""
  echo "| Repo | Path | Holds |"
  echo "|---|---|---|"
  echo "| **agentic-devkit** (core) | \`$MY_WORKFLOW_DIR\` | generic skills, agents, shell wiring, tools |"
  if [ -n "$OVERLAY" ]; then
    echo "| **private overlay** | \`$OVERLAY\` | personal-only skills, machine identity, glossary |"
  fi
  if [ -n "$BRAIN" ]; then
    echo "| **private brain** | \`$BRAIN\` | knowledge: projects, decisions, setups, trackers |"
  fi
  echo ""
  echo "After a \`git pull\` in a devkit repo, re-link with \`./install.sh\` in that repo, then"
  echo "run \`a_c_agent_memory build\` if its memory sources changed. The model behind this"
  echo "layout: \`$MY_WORKFLOW_DIR/docs/managed-claude.md\`."
  fi

  if [ -n "$ORG_BRAIN" ]; then
    echo ""
    echo "## The shared brain - check it before you guess at a name"
    echo ""
    echo "Path: \`$ORG_BRAIN\`. **Read its \`AGENTS.md\` or \`CLAUDE.md\` entry point first**, it routes"
    echo "you to exactly one file. This is the decoder ring for the organisation: what a codename"
    echo "or acronym means, which repo owns a thing, which team to ask, which service serves a URL,"
    echo "where the logs are."
    echo ""
    echo "Check it BEFORE answering from memory and before searching the code. An unfamiliar name"
    echo "is the signal: guessing at one produces a confident wrong answer that nothing catches."
    echo ""
    echo "If the path is missing on this machine, skip it silently. A missing brain never blocks a"
    echo "session."
  fi

  if [ -n "$BRAIN" ]; then
    echo ""
    echo "## My brain - check it before answering from memory"
    echo ""
    echo "Path: \`$BRAIN\`. **Read its \`AGENTS.md\` or \`CLAUDE.md\` entry point first** - it says which folder answers which"
    echo "kind of question, so you do not have to read or guess at the rest."
    echo ""
    echo "If the path is missing (unmounted volume, a different machine), **skip it silently**. A"
    echo "missing brain must never block a session."
    echo ""
    echo "When a session produces something durable - a correction, a preference, a decision, a"
    echo "repo or person the agent did not know - write it back with \`a_sk_teach_claude\`."
  fi

  echo "$END_MARK"
}

# A source file may carry YAML frontmatter for its own tooling; it is metadata, not content.
strip_frontmatter() {
  awk 'NR==1 && $0=="---" {fm=1; next} fm && $0=="---" {fm=0; next} !fm {print}' "$1"
}

# Overlay sources are SHARED between machines, but repo paths are not: the devkit sits
# at a different absolute path on each box. A hardcoded path in rules.md or glossary.md
# is therefore wrong on every machine but one - and an `@/abs/path` import that does not
# resolve is a silently dead rule. So sources write tokens and we expand them here, per
# machine, at build time.
#
#   {{DEVKIT}}   -> $MY_WORKFLOW_DIR            the public core repo
#   {{OVERLAY}}  -> $A_AGENT_OVERLAY_DIR       the private overlay repo
#   {{ORG}}      -> $A_AGENT_ORG_OVERLAY_DIR   the org overlay repo
#   {{ROOT}}     -> $A_ROOT_DIR                the root instruction repo
#   {{ORGBRAIN}} -> $A_AGENT_ORG_BRAIN_DIR     the shared company brain repo
#   {{BRAIN}}    -> $A_AGENT_BRAIN_DIR         the private brain repo
#
# `|` is the sed delimiter because every value is a path. An unset token expands to
# nothing, which is visible in the built file rather than pretending to be a real path.
expand_tokens() {
  sed -e "s|{{DEVKIT}}|$MY_WORKFLOW_DIR|g" \
      -e "s|{{OVERLAY}}|$OVERLAY|g" \
      -e "s|{{ORG}}|$ORG_OVERLAY|g" \
      -e "s|{{ROOT}}|$ROOT_REPO|g" \
      -e "s|{{ORGBRAIN}}|$ORG_BRAIN|g" \
      -e "s|{{BRAIN}}|$BRAIN|g"
}

emit_source() {
  strip_frontmatter "$1" | expand_tokens
}

# --- safety: never silently shrink ----------------------------------------------
#
# The region header records the sources it was built from. If a source that was
# used last time is missing from the config now but STILL EXISTS ON DISK, the
# environment is wrong - almost always a shell that has not sourced the profile,
# so A_AGENT_OVERLAY_DIR is unset. Rebuilding there would quietly delete the
# machine, rules, and glossary blocks from a file that loads on every request.
# Refuse. A source that is genuinely gone from disk is a real removal; allow it.

previous_sources() {
  [ -f "$TARGET" ] || return 0
  awk -v b="$BEGIN_MARK" '
    $0==b {inr=1; next}
    inr && $0=="-->" {exit}
    inr && ($1=="core"||$1=="machine"||$1=="rules"||$1=="glossary"||$1=="orgmachine"||$1=="orgrules"||$1=="orgglossary") && substr($2,1,1)=="/" {print $2}
  ' "$TARGET"
}

guard_shrink() {
  local current=" $CORE $MACHINE_FILE $RULES_FILE $GLOSSARY_FILE $ORG_MACHINE_FILE $ORG_RULES_FILE $ORG_GLOSSARY_FILE " lost=0 old
  while IFS= read -r old; do
    [ -n "$old" ] || continue
    case "$current" in *" $old "*) continue ;; esac
    [ -e "$old" ] || continue   # really gone: a legitimate removal
    if [ "$lost" -eq 0 ]; then
      echo "${RED}refusing to rebuild:${R} this would drop a block that is in your rules file now." >&2
      echo "These sources exist on disk but are not configured in this shell:" >&2
      lost=1
    fi
    echo "    $old" >&2
  done <<EOF
$(previous_sources)
EOF
  [ "$lost" -eq 0 ] && return 0
  echo "" >&2
  echo "Usually this means the shell has not sourced your profile, so" >&2
  echo "A_AGENT_OVERLAY_DIR / A_MACHINE_NAME are unset. Fix that and re-run:" >&2
  echo "    source ~/.zshrc && a_c_agent_memory build" >&2
  echo "If you really meant to drop those blocks: a_c_agent_memory build --force" >&2
  return 1
}

# --- assemble the whole file ---------------------------------------------------

# Drop the superseded hint block, if a previous a_sk_setup_claude run left one.
strip_old_hint() {
  awk -v b="$OLD_BEGIN" -v e="$OLD_END" '
    $0==b {skip=1; next} $0==e {skip=0; next} !skip {print}
  '
}

build_file() {
  local tmp region_file
  tmp="$(mktemp)"
  # The region goes to a FILE, never through `awk -v`: awk rejects embedded
  # newlines in a -v assignment, and the failure mode is a truncated rules file.
  region_file="$(mktemp)"
  render_region > "$region_file"

  if [ ! -f "$TARGET" ]; then
    cat "$region_file" > "$tmp"
  elif grep -qF "$BEGIN_MARK" "$TARGET" && grep -qF "$END_MARK" "$TARGET"; then
    # Replace in place, preserving hand-written text on both sides.
    awk -v b="$BEGIN_MARK" -v e="$END_MARK" -v f="$region_file" '
      $0==b {while ((getline line < f) > 0) print line; close(f); inblock=1; next}
      $0==e {inblock=0; next}
      !inblock {print}
    ' "$TARGET" | strip_old_hint > "$tmp"
  else
    # First build on a hand-written file: region goes first, existing content is
    # kept below it untouched, so nothing is ever lost to adoption.
    {
      cat "$region_file"
      echo ""
      echo "<!-- Hand-written below this line. agentic-devkit never touches it. -->"
      echo ""
      strip_old_hint < "$TARGET"
    } > "$tmp"
  fi
  rm -f "$region_file"
  printf '%s' "$tmp"
}

case "$CMD" in
  render)
    render_region
    ;;

  build)
    [ "$FORCE" -eq 1 ] || guard_shrink || exit 1
    tmp="$(build_file)"
    if [ -f "$TARGET" ] && cmp -s "$tmp" "$TARGET"; then
      echo "${G}up to date${R} ${D}$TARGET${R}"
      rm -f "$tmp"
      exit 0
    fi
    if [ "$DRY_RUN" -eq 1 ]; then
      echo "${B}would change${R} $TARGET ${D}(dry run)${R}"
      diff -u "$TARGET" "$tmp" 2>/dev/null | sed 's/^/  /' || true
      rm -f "$tmp"
      exit 0
    fi
    if [ -f "$TARGET" ]; then
      bk="$TARGET.bak.$(date +%Y%m%dT%H%M%S)"
      cp "$TARGET" "$bk"
      echo "${D}backup: $bk${R}"
    else
      mkdir -p "$(dirname "$TARGET")"
    fi
    mv "$tmp" "$TARGET"
    echo "${G}built${R} $TARGET ${D}($(wc -l < "$TARGET" | tr -d ' ') lines)${R}"
    ;;

  diff)
    tmp="$(build_file)"
    if [ -f "$TARGET" ] && cmp -s "$tmp" "$TARGET"; then
      echo "${G}in sync${R} ${D}$TARGET${R}"
    elif [ -f "$TARGET" ]; then
      diff -u "$TARGET" "$tmp" 2>/dev/null || true
    else
      diff -u /dev/null "$tmp" 2>/dev/null || true
    fi
    rm -f "$tmp"
    ;;

  check)
    tmp="$(build_file)"
    if [ -f "$TARGET" ] && cmp -s "$tmp" "$TARGET"; then
      rm -f "$tmp"; echo "${G}ok${R} memory in sync"; exit 0
    fi
    rm -f "$tmp"
    echo "${Y}drift${R} $TARGET differs from its sources - run: a_c_agent_memory build" >&2
    exit 1
    ;;

  status)
    echo "${B}target${R}   $TARGET"
    if [ -f "$TARGET" ]; then
      echo "         $(wc -l < "$TARGET" | tr -d ' ') lines"
      if grep -qF "$BEGIN_MARK" "$TARGET"; then
        echo "         ${G}managed region present${R}"
      else
        echo "         ${Y}no managed region yet${R} ${D}(run: a_c_agent_memory build)${R}"
      fi
    else
      echo "         ${Y}does not exist yet${R}"
    fi
    echo "${B}machine${R}  ${MACHINE:-${Y}A_MACHINE_NAME unset${R}}"
    echo "${B}runtime${R}  $RUNTIME_NAME ($RUNTIME_MAKER)"
    echo "${B}sources${R}"
    printf "  %-11s %s\n" "core" "$CORE"
    for pair in "machine:$MACHINE_FILE" "rules:$RULES_FILE" "glossary:$GLOSSARY_FILE" \
                "orgmachine:$ORG_MACHINE_FILE" "orgrules:$ORG_RULES_FILE" "orgglossary:$ORG_GLOSSARY_FILE"; do
      k="${pair%%:*}"; v="${pair#*:}"
      if [ -n "$v" ]; then printf "  %-11s %s\n" "$k" "$v"
      else printf "  %-11s ${D}(none)${R}\n" "$k"; fi
    done
    printf "  %-11s %s\n" "root" "${ROOT_REPO:-${D}(unset)${R}}"
    printf "  %-11s %s\n" "overlay" "${OVERLAY:-${D}(unset)${R}}"
    printf "  %-11s %s\n" "orgoverlay" "${ORG_OVERLAY:-${D}(unset)${R}}"
    printf "  %-11s %s\n" "orgbrain" "${ORG_BRAIN:-${D}(unset)${R}}"
    printf "  %-11s %s\n" "brain" "${BRAIN:-${D}(unset)${R}}"
    tmp="$(build_file)"
    if [ -f "$TARGET" ] && cmp -s "$tmp" "$TARGET"; then
      echo "${G}in sync${R}"
    else
      echo "${Y}out of sync${R} ${D}- a_c_agent_memory diff${R}"
    fi
    rm -f "$tmp"
    ;;
esac
