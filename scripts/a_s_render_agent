#!/usr/bin/env bash
# Render one canonical agents/*.md definition into a provider-native agent file.

set -euo pipefail

provider="${1:-}"
source_file="${2:-}"

case "$provider" in
    claude|codex|agy|gemini-cli) ;;
    *) echo "usage: a_s_render_agent claude|codex|agy|gemini-cli SOURCE.md" >&2; exit 2 ;;
esac
[ -f "$source_file" ] || { echo "agent source not found: $source_file" >&2; exit 2; }

frontmatter_value() {
    local key="$1"
    awk -v key="$key" '
        NR == 1 && $0 == "---" { front = 1; next }
        front && $0 == "---" { exit }
        front && index($0, key ":") == 1 {
            value = substr($0, length(key) + 2)
            sub(/^[[:space:]]+/, "", value)
            print value
            exit
        }
    ' "$source_file"
}

description_value() {
    awk '
        NR == 1 && $0 == "---" { front = 1; next }
        front && $0 == "---" { if (block) print value; exit }
        front && !block && index($0, "description:") == 1 {
            value = substr($0, 13)
            sub(/^[[:space:]]+/, "", value)
            if (value == ">-" || value == ">" || value == "|-" || value == "|") {
                value = ""
                block = 1
                next
            }
            print value
            exit
        }
        front && block {
            if ($0 ~ /^[[:space:]]+/) {
                line = $0
                sub(/^[[:space:]]+/, "", line)
                value = value (value == "" ? "" : " ") line
                next
            }
            print value
            exit
        }
    ' "$source_file"
}

body() {
    awk 'delimiters < 2 && /^---[[:space:]]*$/ { delimiters++; next } delimiters >= 2 { print }' "$source_file"
}

quoted() {
    awk 'BEGIN { ORS="" } {
        if (NR > 1) printf "\\n"
        gsub(/\\/, "\\\\")
        gsub(/"/, "\\\"")
        gsub(/\t/, "\\t")
        printf "%s", $0
    }'
}

name="$(frontmatter_value name)"
description="$(description_value)"
tools="$(frontmatter_value tools)"
tier="$(frontmatter_value model)"

[ -n "$name" ] || { echo "missing name in $source_file" >&2; exit 2; }
[ -n "$description" ] || { echo "missing description in $source_file" >&2; exit 2; }

case "$provider" in
    claude)
        cat "$source_file"
        ;;
    codex)
        case "$tier" in
            haiku) model="${CODEX_AGENT_MODEL_HAIKU:-gpt-5.6-luna}"; effort="${CODEX_AGENT_EFFORT_HAIKU:-low}" ;;
            sonnet) model="${CODEX_AGENT_MODEL_SONNET:-gpt-5.6-terra}"; effort="${CODEX_AGENT_EFFORT_SONNET:-medium}" ;;
            opus) model="${CODEX_AGENT_MODEL_OPUS:-gpt-5.6}"; effort="${CODEX_AGENT_EFFORT_OPUS:-high}" ;;
            *) model="${CODEX_AGENT_MODEL_DEFAULT:-gpt-5.6-terra}"; effort="${CODEX_AGENT_EFFORT_DEFAULT:-medium}" ;;
        esac
        sandbox=read-only
        compact_tools="$(printf '%s' "$tools" | tr -d '[:space:]')"
        case ",$compact_tools," in
            *,Write,*|*,Edit,*|*,Bash,*|*,Task,*) sandbox=workspace-write ;;
        esac
        printf '# Generated by agentic-devkit from agents/%s; DO NOT EDIT.\n' "$(basename "$source_file")"
        printf 'name = "%s"\n' "$(printf '%s' "$name" | quoted)"
        printf 'description = "%s"\n' "$(printf '%s' "$description" | quoted)"
        printf 'model = "%s"\n' "$(printf '%s' "$model" | quoted)"
        printf 'model_reasoning_effort = "%s"\n' "$(printf '%s' "$effort" | quoted)"
        printf 'sandbox_mode = "%s"\n\n' "$sandbox"
        printf "developer_instructions = '''\n"
        printf '%s\n\n' 'Provider adapter: you are running as a Codex custom subagent. Treat provider-specific tool names in the canonical instructions as capability descriptions and use the equivalent Codex tools available in this session.'
        body
        printf "'''\n"
        ;;
    agy)
        case "$tier" in
            haiku) agy_model=flash ;;
            opus) agy_model=pro ;;
            *) agy_model="${AGY_AGENT_MODEL_DEFAULT:-flash}" ;;
        esac

        mapped_tools=""
        old_ifs="$IFS"; IFS=,
        for tool in $tools; do
            tool="${tool#${tool%%[![:space:]]*}}"
            tool="${tool%${tool##*[![:space:]]}}"
            case "$tool" in
                Read) mapped=view_file ;;
                Write) mapped=write_to_file ;;
                Edit) mapped=replace_file_content ;;
                Glob) mapped=find_by_name ;;
                Grep) mapped=grep_search ;;
                Bash) mapped=run_command ;;
                WebSearch) mapped=search_web ;;
                WebFetch) mapped=read_url_content ;;
                Task) mapped=invoke_subagent ;;
                *) mapped="" ;;
            esac
            [ -z "$mapped" ] || mapped_tools="${mapped_tools}${mapped_tools:+ }$mapped"
        done
        IFS="$old_ifs"

        printf '%s\n' '---'
        printf '%s\n' '# Generated by agentic-devkit; edit the canonical file in agents/.'
        printf 'name: "%s"\n' "$(printf '%s' "$name" | quoted)"
        printf 'description: "%s"\n' "$(printf '%s' "$description" | quoted)"
        if [ -n "$mapped_tools" ]; then
            printf '%s\n' 'tools:'
            for tool in $mapped_tools; do printf '  - %s\n' "$tool"; done
        fi
        printf '%s\n' 'mainAgent: false' 'subagent: true'
        printf 'model: %s\n' "$agy_model"
        printf '%s\n' 'commandExecutionPolicy: sandbox' '---' ''
        printf '%s\n\n' 'Provider adapter: you are running as an AGY/Antigravity custom subagent. Treat provider-specific tool names in the canonical instructions as capability descriptions and use the mapped Antigravity tools.'
        body
        ;;
    gemini-cli)
        case "$tier" in
            haiku) gemini_model="${GEMINI_AGENT_MODEL_HAIKU:-gemini-3.5-flash-lite}" ;;
            sonnet) gemini_model="${GEMINI_AGENT_MODEL_SONNET:-gemini-3.6-flash}" ;;
            opus) gemini_model="${GEMINI_AGENT_MODEL_OPUS:-gemini-3.1-pro-preview}" ;;
            *) gemini_model=inherit ;;
        esac
        printf '%s\n' '---'
        printf '%s\n' '# Generated by agentic-devkit; edit the canonical file in agents/.'
        printf 'name: "%s"\n' "$(printf '%s' "$name" | quoted)"
        printf 'description: "%s"\n' "$(printf '%s' "$description" | quoted)"
        printf '%s\n' 'kind: local'
        printf 'model: %s\n' "$gemini_model"
        printf '%s\n' '---' ''
        printf '%s\n\n' 'Provider adapter: you are running as a Gemini CLI custom subagent. Use the Gemini tools available in this session for the capabilities described below.'
        body
        ;;
esac
