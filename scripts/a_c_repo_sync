#!/usr/bin/env bash
#
# a_c_repo_sync - keep this machine's shared-knowledge repos in step with their remotes.
#
# The overlay (machine identity, personal rules, glossary) and the brain (durable
# knowledge) are the two things more than one machine reads and writes. A fact written
# on one box only helps the others once it is pushed, and a stale clone is how two
# machines end up disagreeing. So: pull, commit whatever is local, push. Per repo.
#
# It is deliberately NOT a knowledge-producing routine. It moves this machine's own
# commits and nothing else, which is why every machine may run it on a timer without
# the "only one box owns the routines" rule being broken.
#
# Safety, in order of how much it matters:
#   - never force-pushes, never rewrites history, never resolves a conflict
#   - rebases with --autostash; on ANY conflict it aborts, restores, and reports
#   - skips a repo mid-rebase/merge, on a detached HEAD, or with no upstream
#   - a repo that fails does not stop the others
#   - rebuilds the generated rules file when the pull changed a memory source
#
# Usage:
#   a_c_repo_sync                 # sync every configured repo
#   a_c_repo_sync <path> ...      # sync just these
#   a_c_repo_sync -n              # dry run: report, change nothing
#   a_c_repo_sync --pull-only     # pull only; never commit or push
#   a_c_repo_sync -q              # quiet: only warnings and errors (for timers)
#
# Which repos, by default: $A_CLAUDE_OVERLAY_DIR and $A_CLAUDE_BRAIN_DIR. Override with
# A_SYNC_REPOS as a colon-separated list of paths.

set -uo pipefail

DRY_RUN=0
PULL_ONLY=0
QUIET=0
ARGS=()

if [ -t 1 ]; then
  R=$'\033[0m'; G=$'\033[0;32m'; Y=$'\033[0;33m'; RED=$'\033[0;31m'; D=$'\033[2m'; B=$'\033[0;34m'
else
  R=""; G=""; Y=""; RED=""; D=""; B=""
fi

while [ $# -gt 0 ]; do
  case "$1" in
    -n|--dry-run) DRY_RUN=1; shift ;;
    --pull-only) PULL_ONLY=1; shift ;;
    -q|--quiet) QUIET=1; shift ;;
    -h|--help) sed -n '3,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "unknown argument: $1 (try --help)" >&2; exit 2 ;;
    *) ARGS+=("$1"); shift ;;
  esac
done

say()  { [ "$QUIET" -eq 1 ] || echo "$@"; }
warn() { echo "${Y}warn:${R} $*" >&2; }
err()  { echo "${RED}error:${R} $*" >&2; }

# --- which repos ---------------------------------------------------------------

REPOS=()
if [ "${#ARGS[@]}" -gt 0 ]; then
  REPOS=("${ARGS[@]}")
elif [ -n "${A_SYNC_REPOS:-}" ]; then
  IFS=':' read -r -a REPOS <<< "$A_SYNC_REPOS"
else
  [ -n "${A_CLAUDE_OVERLAY_DIR:-}" ] && REPOS+=("$A_CLAUDE_OVERLAY_DIR")
  [ -n "${A_CLAUDE_BRAIN_DIR:-}" ]   && REPOS+=("$A_CLAUDE_BRAIN_DIR")
fi

if [ "${#REPOS[@]}" -eq 0 ]; then
  err "nothing to sync: set A_CLAUDE_OVERLAY_DIR / A_CLAUDE_BRAIN_DIR in your profile,"
  err "or pass repo paths, or set A_SYNC_REPOS."
  exit 2
fi

# Did the pull touch a file that the generated rules file is composed from?
MEMORY_TOUCHED=0
FAILED=0
CHANGED=0

# --- one repo ------------------------------------------------------------------

sync_one() {
  local repo="$1" name branch upstream before after
  name="$(basename "$repo")"

  if [ ! -d "$repo" ]; then
    # A repo that is simply not on this machine is not an error. Different boxes hold
    # different clones, and the whole design says a missing path must not block anything.
    say "${D}skip${R}     $name ${D}(not on this machine)${R}"
    return 0
  fi
  if ! git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
    warn "$name is not a git repo, skipping"
    return 0
  fi

  # Never touch a repo that is mid-operation: finishing it is a human's job.
  local gitdir
  # --absolute-git-dir, not --git-dir: the latter is relative to the repo for a normal
  # clone but absolute for a linked worktree, so joining it to $repo is wrong half the time.
  gitdir="$(git -C "$repo" rev-parse --absolute-git-dir 2>/dev/null)"
  if [ -d "$gitdir/rebase-merge" ] || [ -d "$gitdir/rebase-apply" ] \
     || [ -f "$gitdir/MERGE_HEAD" ] || [ -f "$gitdir/CHERRY_PICK_HEAD" ]; then
    warn "$name has a rebase/merge in progress, leaving it alone"
    return 1
  fi

  branch="$(git -C "$repo" symbolic-ref --short -q HEAD)"
  if [ -z "$branch" ]; then
    warn "$name is on a detached HEAD, leaving it alone"
    return 1
  fi

  upstream="$(git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)"
  if [ -z "$upstream" ]; then
    warn "$name ($branch) has no upstream, skipping"
    return 1
  fi

  # An identity must be set or the commit fails with a confusing error. Check before,
  # not after, so the message names the real problem.
  if [ "$PULL_ONLY" -eq 0 ] && ! git -C "$repo" config user.email >/dev/null 2>&1; then
    warn "$name has no git user.email (and there is no global one), skipping the commit half"
    warn "  fix: git -C $repo config user.email '<you@example.com>'"
    return 1
  fi

  before="$(git -C "$repo" rev-parse HEAD)"

  if [ "$DRY_RUN" -eq 1 ]; then
    local dirty ahead behind
    dirty="$(git -C "$repo" status --porcelain | wc -l | tr -d ' ')"
    git -C "$repo" fetch --quiet 2>/dev/null
    behind="$(git -C "$repo" rev-list --count "HEAD..$upstream" 2>/dev/null || echo 0)"
    ahead="$(git -C "$repo" rev-list --count "$upstream..HEAD" 2>/dev/null || echo 0)"
    say "${B}would sync${R} $name ${D}($branch: $dirty local change(s), $behind to pull, $ahead to push)${R}"
    return 0
  fi

  # --- pull ---
  if ! git -C "$repo" fetch --quiet 2>/dev/null; then
    # The usual cause on an unattended run is not the network: it is that every SSH key
    # is passphrase-protected and no agent has been unlocked since the last boot.
    if [ -z "${SSH_AUTH_SOCK:-}" ] || ! ssh-add -l >/dev/null 2>&1; then
      warn "$name: fetch failed and no ssh-agent has keys loaded."
      warn "  unlock once with: ssh-add ~/.ssh/<key>   (then this retries on its own)"
    else
      warn "$name: fetch failed (offline?), skipping"
    fi
    return 1
  fi

  if [ "$(git -C "$repo" rev-list --count "HEAD..$upstream" 2>/dev/null || echo 0)" != "0" ]; then
    if git -C "$repo" rebase --autostash --quiet "$upstream" 2>/dev/null; then
      say "${G}pulled${R}   $name ${D}($branch)${R}"
    else
      # Do not attempt a resolution. Put the repo back exactly as it was and say so.
      git -C "$repo" rebase --abort 2>/dev/null
      err "$name: pull conflicts with local work. Left untouched - resolve it by hand:"
      err "  cd $repo && git pull --rebase"
      return 1
    fi
  fi

  after="$(git -C "$repo" rev-parse HEAD)"
  if [ "$before" != "$after" ]; then
    CHANGED=1
    # If the pull changed a memory source, the generated rules file is now stale.
    if git -C "$repo" diff --name-only "$before" "$after" 2>/dev/null | grep -q '^machine/'; then
      MEMORY_TOUCHED=1
    fi
  fi

  [ "$PULL_ONLY" -eq 1 ] && return 0

  # --- commit whatever is local ---
  if [ -n "$(git -C "$repo" status --porcelain)" ]; then
    git -C "$repo" add -A
    if git -C "$repo" commit --quiet --no-verify \
        -m "sync: ${A_MACHINE_NAME:-$(hostname)} $(date -u '+%Y-%m-%d %H:%M:%S') UTC" 2>/dev/null; then
      say "${G}committed${R} $name ${D}(local changes)${R}"
      CHANGED=1
    else
      warn "$name: nothing committed (empty change or hook refused)"
    fi
  fi

  # --- push ---
  if [ "$(git -C "$repo" rev-list --count "$upstream..HEAD" 2>/dev/null || echo 0)" != "0" ]; then
    if git -C "$repo" push --quiet 2>/dev/null; then
      say "${G}pushed${R}   $name ${D}($branch)${R}"
      CHANGED=1
    else
      # Almost always: the remote moved again between our fetch and our push. Next run
      # picks it up. Never force.
      warn "$name: push rejected (remote moved?). Next run will retry."
      return 1
    fi
  fi

  return 0
}

for repo in "${REPOS[@]}"; do
  [ -n "$repo" ] || continue
  sync_one "$repo" || FAILED=$((FAILED + 1))
done

# The rules file loads on every request, so a pulled change to machine/ must be applied
# or this machine keeps running yesterday's rules.
if [ "$MEMORY_TOUCHED" -eq 1 ] && [ "$DRY_RUN" -eq 0 ]; then
  if command -v a_c_claude_memory >/dev/null 2>&1; then
    say "${D}a memory source changed upstream, rebuilding the rules file${R}"
    a_c_claude_memory build >/dev/null 2>&1 \
      && say "${G}rebuilt${R}  ~/.claude/CLAUDE.md" \
      || warn "a_c_claude_memory build failed, run it by hand"
  fi
fi

if [ "$FAILED" -gt 0 ]; then
  err "$FAILED repo(s) need attention (see above)"
  exit 1
fi

[ "$CHANGED" -eq 0 ] && say "${D}everything already in sync${R}"
exit 0
