#!/usr/bin/env bash
#
# a_c_doctor - is this machine set up right, and is anything out of date?
#
# Usage:
#   a_c_doctor             check everything, fetching from each repo's origin for updates
#   a_c_doctor --offline   same, but compare against what was last fetched (no network)
#   a_c_doctor --shell-only  check command loading in a fresh shell only
#   a_c_doctor set private overlay
#                          set the private overlay path and Git URL
#   a_c_doctor set org overlay
#                          set the organization overlay path and Git URL
#   a_c_doctor --configure root|overlay
#                          configure a root or choose an overlay role
#   a_c_doctor --fix       also repair: repoint the config at repos that were moved (keeps
#                          backups), shell wiring, and skill/agent links that point at an
#                          old copy or at a repo that no longer has them
#   a_c_doctor --set-overlay <folder>
#                          record where your private overlay repo is on this machine (in
#                          the right config file, with a backup), then re-run install.sh
#
# Checks, each with the command that fixes what it finds:
#   - the shell rc file loads the devkit profile
#   - this machine has a name, a machine file in an overlay (optional), a prompt colour
#   - the repo folders behind cd_p / cd_w / cd_g are set and exist
#   - the devkit, the overlays and the root repo: updates waiting, local changes
#   - every skill and agent in those repos is linked into the provider homes
#   - the generated agent guidance matches its sources
#
# Runs as its own process, so install.sh runs it at the end of every install. For the
# checks that need your live shell (functions loaded from the right clone), use
# a_c_workflow_doctor, which runs this as well.
#
# Exit status: 0 when nothing is wrong, 1 when there is a warning or an error.

set -uo pipefail

OFFLINE=false
FIX=false
SHELL_ONLY=false
SET_OVERLAY=""
CONFIGURE=""
case "${1:-} ${2:-} ${3:-}" in
    "set private overlay") CONFIGURE=private-overlay; shift 3 ;;
    "set org overlay") CONFIGURE=org-overlay; shift 3 ;;
esac
while [ $# -gt 0 ]; do
    a="$1"; shift
    case "$a" in
        --offline) OFFLINE=true ;;
        --fix) FIX=true ;;
        --shell-only) SHELL_ONLY=true ;;
        --configure) CONFIGURE="${1:?--configure needs root or overlay}"; shift ;;
        --set-overlay) SET_OVERLAY="${1:?--set-overlay needs the folder of your overlay repo}"; shift ;;
        -h|--help) sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "a_c_doctor: unknown argument: $a (see --help)" >&2; exit 2 ;;
    esac
done

DEVKIT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [ -n "$CONFIGURE" ]; then
    exec "$DEVKIT/scripts/a_s_doctor_configure" "$CONFIGURE"
fi

if [ -t 1 ]; then
    GREEN='\033[0;32m' YELLOW='\033[1;33m' RED='\033[0;31m' BLUE='\033[0;34m' DIM='\033[2m' NC='\033[0m'
else
    GREEN='' YELLOW='' RED='' BLUE='' DIM='' NC=''
fi
ok=0 warn=0 err=0
good()    { echo -e " ${GREEN}✓${NC} $1"; ok=$((ok+1)); }
bad()     { echo -e " ${YELLOW}!${NC} $1"; warn=$((warn+1)); }
broken()  { echo -e " ${RED}✗${NC} $1"; err=$((err+1)); }
info()    { echo -e " ${DIM}·${NC} $1"; }
fix()     { echo -e "     ${DIM}fix:${NC} ${GREEN}$1${NC}"; }
section() { echo; echo -e "${BLUE}$1${NC}"; }

if $FIX; then
    # Moved repos first: every check below reads the paths they fix.
    if ! "$DEVKIT/scripts/a_s_relocate_repos" --list >/dev/null; then
        echo -e "${BLUE}Moved repos${NC}"
        if "$DEVKIT/scripts/a_s_relocate_repos" --apply; then
            # The calling shell still exports the old paths, so drop them and relink from the files.
            echo "relinking skills, agents and guidance from the new paths ..."
            env -u A_ROOT_DIR -u DEVKIT_DIR -u MY_WORKFLOW_DIR -u A_AGENT_OVERLAY_DIR -u A_AGENT_ORG_OVERLAY_DIR \
                -u A_MACHINE_NAME "$DEVKIT/install.sh" --link-only
            exit $?
        fi
        unset A_ROOT_DIR
    fi
    "$DEVKIT/install.sh" --shell-only || broken "shell wiring repair failed"
fi

# ------------------------------------------------------------------- load the config
#
# In a shell that loaded the profile, everything is already exported. From install.sh
# or a fresh terminal it is not, so read the same files the profile reads.

read_assignment() {
    local key="$1" file="$2" line
    [ -f "$file" ] || return 0
    line="$(grep -E "^[[:space:]]*(export[[:space:]]+)?$key=" "$file" | tail -n 1)" || true
    line="${line#*=}"
    line="${line%%#*}"
    line="$(printf '%s' "$line" | sed -e 's/[[:space:]]*$//' -e "s/^[\"']//" -e "s/[\"']\$//")"
    printf '%s' "${line/#\~/$HOME}"
}

PROFILE=""
for f in "$HOME/my_settings/a_configs.profile" "$HOME/my_settings/configs.profile"; do
    [ -f "$f" ] && { PROFILE="$f"; break; }
done

ROOT="${A_ROOT_DIR:-}"
[ -n "$ROOT" ] || ROOT="$(read_assignment A_ROOT_DIR "${PROFILE:-/dev/null}")"
EXPECTED_ROOT="$ROOT"
[ -n "$ROOT" ] && [ -f "$ROOT/root.config" ] || ROOT=""

if [ -n "$ROOT" ]; then
    # The keys a user edits, and the file they edit them in.
    CONFIG="$ROOT/root.local.config"
    KEY_P=PERSONAL_REPOS_DIR KEY_W=ORG_REPOS_DIR KEY_G=GLOBAL_REPOS_DIR
    set +u
    [ -f "$ROOT/root.local.config" ] && . "$ROOT/root.local.config"
    . "$ROOT/root.config"
    set -u
    a_dir_p_repos="${PERSONAL_REPOS_DIR:-}"
    a_dir_w_repos="${ORG_REPOS_DIR:-}"
    a_dir_g_repos="${GLOBAL_REPOS_DIR:-}"
    A_AGENT_OVERLAY_DIR="${PRIVATE_DEVKIT_DIR:-}"
    A_AGENT_ORG_OVERLAY_DIR="${ORG_DEVKIT_DIR:-}"
else
    CONFIG="$PROFILE"
    KEY_P=a_dir_p_repos KEY_W=a_dir_w_repos KEY_G=a_dir_g_repos
    if [ -z "${MY_WORKFLOW_DIR:-}" ] && [ -n "$PROFILE" ]; then
        a_dir_p_repos="$(read_assignment a_dir_p_repos "$PROFILE")"
        a_dir_w_repos="$(read_assignment a_dir_w_repos "$PROFILE")"
        a_dir_g_repos="$(read_assignment a_dir_g_repos "$PROFILE")"
        A_AGENT_OVERLAY_DIR="$(read_assignment A_AGENT_OVERLAY_DIR "$PROFILE")"
        A_AGENT_ORG_OVERLAY_DIR="$(read_assignment A_AGENT_ORG_OVERLAY_DIR "$PROFILE")"
    fi
fi
# Older profiles use A_CLAUDE_OVERLAY_DIR for the private overlay.
if [ -z "${A_AGENT_OVERLAY_DIR:-}" ]; then
    A_AGENT_OVERLAY_DIR="${A_CLAUDE_OVERLAY_DIR:-$(read_assignment A_CLAUDE_OVERLAY_DIR "${PROFILE:-/dev/null}")}"
fi
if [ -n "$SET_OVERLAY" ]; then
    dir="$(cd -P "${SET_OVERLAY/#\~/$HOME}" 2>/dev/null && pwd)" \
        || { echo "a_c_doctor: no folder at $SET_OVERLAY" >&2; exit 2; }
    [ -d "$dir/skills" ] || [ -d "$dir/agents" ] \
        || { echo "a_c_doctor: $dir has no skills/ or agents/ folder; is it the overlay repo?" >&2; exit 2; }
    if [ -n "$ROOT" ]; then file="$ROOT/root.local.config"; key=PRIVATE_DEVKIT_DIR; line="$key=\"$dir\""
    else file="$PROFILE"; key=A_AGENT_OVERLAY_DIR; line="export $key=\"$dir\""; fi
    [ -n "$file" ] || { echo "a_c_doctor: no config file found; run install.sh first" >&2; exit 2; }
    if [ -f "$file" ]; then
        bak="$file.bak-$(date +%Y%m%d%H%M%S)"
        (umask 077; cp -p "$file" "$bak") && chmod go-rwx "$bak"
    fi
    if [ -f "$file" ] && grep -Eq "^[[:space:]]*(export[[:space:]]+)?$key=" "$file"; then
        tmp="$(mktemp)"
        sed -E "s|^[[:space:]]*(export[[:space:]]+)?$key=.*|$line|" "$file" > "$tmp" && cat "$tmp" > "$file"; rm -f "$tmp"
    else
        printf '\n# Private overlay repo on this machine (set by a_c_doctor --set-overlay)\n%s\n' "$line" >> "$file"
    fi
    echo -e "${GREEN}set${NC} $line ${DIM}in $file${NC}"
    export A_AGENT_OVERLAY_DIR="$dir" PRIVATE_DEVKIT_DIR="$dir"
    echo "running install.sh to link its skills and agents ..."
    exec "$DEVKIT/install.sh" --link-only
fi

# The name is read fresh from the file, so a rename shows up before the shell reloads.
NAME="$(read_assignment MACHINE_NAME "${CONFIG:-/dev/null}")"
[ -n "$NAME" ] || NAME="$(read_assignment A_MACHINE_NAME "${CONFIG:-/dev/null}")"
[ -n "$NAME" ] || NAME="${MACHINE_NAME:-${A_MACHINE_NAME:-}}"

echo -e "${BLUE}agentic-devkit doctor${NC} ${DIM}($DEVKIT)${NC}"

# ------------------------------------------------------------------- shell wiring
section "Shell"
if [ -z "$PROFILE" ]; then
    info "no standard settings profile; checking command loading directly"
else
    rc=""
    case "$(basename "${SHELL:-}")" in
        bash) rc="$HOME/.bashrc" ;;
        *)    rc="$HOME/.zshrc" ;;
    esac
    if [ -f "$rc" ] && grep -Eq "^[^#]*(source|\.)[[:space:]].*my_settings/[^ ]*\.profile" "$rc"; then
        good "$(basename "$rc") loads $(basename "$PROFILE")"
    elif [ -f "$rc" ] && grep -Fq '# >>> agentic-devkit shell hook >>>' "$rc"; then
        info "$rc has a devkit startup hook; checking command loading directly"
    else
        broken "$rc does not load $PROFILE"
        fix "$DEVKIT/install.sh"
    fi
fi
# An rc source line and an exported variable cannot prove commands load. Start
# with those inherited paths removed so the user's startup files must wire them.
shell_bin="${SHELL:-/bin/zsh}"
case "$(basename "$shell_bin")" in
    bash|zsh)
        if shell_result="$(env -u MY_WORKFLOW_DIR -u DEVKIT_DIR "$shell_bin" -ic '
            [ "${MY_WORKFLOW_DIR:-}" = "$1" ] &&
            [ "$(command -v a_c_doctor)" = "$1/scripts/a_c_doctor" ] &&
            command -v a_c_workflow_doctor >/dev/null 2>&1
        ' devkit-shell-check "$DEVKIT" 2>&1)"; then
            good "fresh $(basename "$shell_bin") loads this checkout’s commands"
        else
            broken "fresh $(basename "$shell_bin") does not load this checkout’s commands"
            fix "$DEVKIT/scripts/a_c_doctor --fix --shell-only"
        fi
        ;;
    *) broken "cannot check unsupported shell: $shell_bin" ;;
esac
if $SHELL_ONLY; then
    [ $((warn + err)) -eq 0 ]
    exit $?
fi
# A settings file that still names an old or moved checkout loads that copy's shell
# functions and prompt, not this devkit's, even though every link here is correct.
if [ -n "$CONFIG" ]; then
    wf="$(sed -nE "s/^[[:space:]]*export[[:space:]]+MY_WORKFLOW_DIR=['\"]?([^'\"]*)['\"]?.*/\1/p" "$CONFIG" | tail -1)"
    wf="${wf/#\~/$HOME}"
    if [ -n "$wf" ] && [ "$(cd -P "$wf" 2>/dev/null && pwd)" != "$(cd -P "$DEVKIT" && pwd)" ]; then
        broken "MY_WORKFLOW_DIR in the settings file loads $wf, not this devkit"
        fix "set MY_WORKFLOW_DIR='$DEVKIT' in $CONFIG, then: source ~/.zshrc"
    fi
fi

section "Configured repositories"
# A configured folder that is gone, but whose repo is nearby under the same name, was
# moved. Say where it is now; --fix repoints all of them at once.
MOVED="$("$DEVKIT/scripts/a_s_relocate_repos" --list 2>/dev/null || true)"
moved_to() { printf '%s\n' "$MOVED" | awk -F'\t' -v k="$1" '$1 == k { print $4; exit }'; }
moved_any=false
while IFS="$(printf '\t')" read -r key old file found; do
    [ -n "$found" ] || continue
    bad "$key=$old is gone; the repo is now at ${found//|/ or }"
    moved_any=true
done <<MOVED_EOF
$MOVED
MOVED_EOF
$moved_any && fix "$DEVKIT/scripts/a_c_doctor --fix   (repoints them, with backups, and relinks)"
if [ -n "$EXPECTED_ROOT" ] && [ ! -f "$EXPECTED_ROOT/root.config" ] && [ -z "$(moved_to A_ROOT_DIR)" ]; then
    bad "A_ROOT_DIR=$EXPECTED_ROOT has no root.config"
    info "A_ROOT_DIR needs a local root-repo directory; A_ROOT_REMOTE needs its Git clone URL"
    fix "a_c_doctor --configure root"
fi
for role in private-overlay org-overlay; do
    # With the root moved, these values are only what an old shell exported; --fix reads the real ones.
    [ -z "$(moved_to A_ROOT_DIR)" ] || break
    if [ "$role" = private-overlay ]; then
        dir="${A_AGENT_OVERLAY_DIR:-}"; key=A_AGENT_OVERLAY_DIR; remote_key=A_AGENT_OVERLAY_REMOTE
        [ -z "$ROOT" ] || { key=PRIVATE_DEVKIT_DIR; remote_key=PRIVATE_DEVKIT_REMOTE; }
    else
        dir="${A_AGENT_ORG_OVERLAY_DIR:-}"; key=A_AGENT_ORG_OVERLAY_DIR; remote_key=A_AGENT_ORG_OVERLAY_REMOTE
        [ -z "$ROOT" ] || { key=ORG_DEVKIT_DIR; remote_key=ORG_DEVKIT_REMOTE; }
    fi
    if [ -n "$dir" ] && [ ! -d "$dir" ] && [ -z "$(moved_to "$key")" ]; then
        bad "$key=$dir is missing"
        info "$key needs a local overlay directory; $remote_key needs its Git clone URL"
        fix "a_c_doctor --configure $role"
    fi
done
[ -n "$CONFIG" ] && info "settings file: $CONFIG"

# ------------------------------------------------------------------- machine
section "Machine"
if [ -z "$NAME" ]; then
    bad "no machine name set, so agents cannot say which machine they are on"
    fix "$DEVKIT/install.sh   (it asks for the name)"
else
    good "name: $NAME"
    # Optional: a machine/<name>.md in an overlay adds facts about this machine to the
    # agent guidance. Its absence is fine, but files for other names often mean a rename.
    found="" others=""
    for overlay in "${A_AGENT_OVERLAY_DIR:-}" "${A_AGENT_ORG_OVERLAY_DIR:-}"; do
        [ -n "$overlay" ] && [ -d "$overlay/machine" ] || continue
        [ -f "$overlay/machine/$NAME.md" ] && found="$overlay/machine/$NAME.md"
        others="$others$(cd "$overlay/machine" && ls ./*.md 2>/dev/null | sed 's|^\./||; s|\.md$||' \
                  | grep -Ev '^(glossary|rules|README)$' | grep -vxF "$NAME" | tr '\n' ' ')"
    done
    if [ -n "$found" ]; then
        good "machine file: $found"
    elif [ -n "$others" ]; then
        info "no machine/$NAME.md in an overlay (optional). There are files for: $others"
        echo -e "     ${DIM}if one of those is this machine under an old name, rename the file to $NAME.md${NC}"
    fi
    colour="$(read_assignment MACHINE_COLOR "${CONFIG:-/dev/null}")"
    if [ -n "$colour" ]; then
        good "prompt colour: $colour"
    elif [ -f "$HOME/.zshrc" ] && grep -Fq '# fleetkit prompt colour' "$HOME/.zshrc"; then
        good "prompt colour: set in .zshrc"
    else
        info "the prompt shows the name in grey. To colour it: ${GREEN}a_c_machine color <colour>${NC} (list: a_c_machine colors)"
    fi
fi

# ------------------------------------------------------------------- folders
section "Repo folders (cd_p, cd_w, cd_g)"
check_tier() {
    local alias="$1" key="$2" dir="$3" what="$4"
    if [ -z "$dir" ]; then
        info "$alias is off: $key is empty ($what)"
        echo -e "     ${DIM}to turn it on, set $key in ${CONFIG:-your profile}${NC}"
    elif [ -d "$dir" ]; then
        good "$alias -> $dir"
    else
        bad "$alias points at $dir, which does not exist"
        fix "mkdir -p \"$dir\"   or set $key in ${CONFIG:-your profile} to the right folder"
    fi
}
check_tier cd_p "$KEY_P" "${a_dir_p_repos:-}" "personal repos"
check_tier cd_w "$KEY_W" "${a_dir_w_repos:-}" "work repos"
check_tier cd_g "$KEY_G" "${a_dir_g_repos:-}" "global repos"

# ------------------------------------------------------------------- updates
section "Updates"
REPOS=()
add_repo() {
    local d="$1" r
    [ -n "$d" ] && [ -d "$d/.git" ] || return 0
    d="$(cd -P "$d" && pwd)"
    for r in ${REPOS[@]+"${REPOS[@]}"}; do [ "$r" = "$d" ] && return 0; done
    REPOS+=("$d")
}
add_repo "$DEVKIT"
add_repo "${A_AGENT_OVERLAY_DIR:-}"
add_repo "${A_AGENT_ORG_OVERLAY_DIR:-}"
add_repo "$ROOT"

FETCH_LOG="$(mktemp -d)"
trap 'rm -rf "$FETCH_LOG"' EXIT
if ! $OFFLINE; then
    # All at once, and never waiting on a password or a dead ssh-agent.
    i=0
    for d in "${REPOS[@]}"; do
        ( GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=5" \
            git -C "$d" fetch -q 2>"$FETCH_LOG/$i.err" || touch "$FETCH_LOG/$i.failed" ) &
        i=$((i+1))
    done
    wait
fi

PULL_CMD=""   # one pull per repo with updates, joined with &&, then a single install
BEHIND=" "   # repos with updates waiting, space separated (bash 3.2 has no maps)
i=0
for d in "${REPOS[@]}"; do
    n="$(basename "$d")"
    branch="$(git -C "$d" branch --show-current 2>/dev/null)"
    if [ -f "$FETCH_LOG/$i.failed" ]; then
        bad "$n: could not reach its origin, so updates are unknown"
        echo -e "     ${DIM}$(head -1 "$FETCH_LOG/$i.err")${NC}"
        fix "git -C \"$d\" fetch   (if it asks for an ssh key: ssh-add)"
    elif ! git -C "$d" rev-parse -q --verify '@{u}' >/dev/null 2>&1; then
        info "$n: branch ${branch:-?} has no upstream, not checked"
    else
        behind="$(git -C "$d" rev-list --count 'HEAD..@{u}' 2>/dev/null || echo 0)"
        ahead="$(git -C "$d" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)"
        if [ "$behind" -gt 0 ]; then
            BEHIND="$BEHIND$d "
            bad "$n: $behind update(s) waiting on ${branch:-its branch}"
            PULL_CMD="${PULL_CMD:+$PULL_CMD && }git -C \"$d\" pull"
        else
            good "$n is up to date"
        fi
        [ "$ahead" -gt 0 ] && { bad "$n: $ahead local commit(s) not pushed"; fix "git -C \"$d\" push"; }
    fi
    dirty="$(git -C "$d" status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
    [ "$dirty" -gt 0 ] && info "$n has $dirty uncommitted change(s)"
    i=$((i+1))
done
[ -n "$PULL_CMD" ] && fix "$PULL_CMD && \"$DEVKIT/install.sh\""
$OFFLINE && info "offline: compared against the last fetch, not the origin"

# ------------------------------------------------------------------- installed links
section "Installed skills and agents"
# A name can come from the devkit or an overlay, so a link is right if it points into
# any of the repos above. A wrong link gets a reason and a fix that actually clears it:
#   repoint  a configured repo has this name, the link points somewhere else
#   orphan   no configured repo has this name and the link leads nowhere: remove it
#   foreign  it leads into a folder outside the configured repos that still exists
#            (an overlay this machine no longer configures): yours to decide
points_into_repos() {
    local target r
    target="$(cd -P "$1" 2>/dev/null && pwd || readlink "$1")"
    for r in "${REPOS[@]}"; do case "$target" in "$r"/*) return 0 ;; esac; done
    return 1
}
# provider_of <name> <skills|agents> -> the path in a configured repo that provides it
provider_of() {
    local r
    for r in "${REPOS[@]}"; do
        if [ "$2" = skills ]; then [ -f "$r/skills/$1/SKILL.md" ] && { echo "$r/skills/$1"; return; }
        else [ -f "$r/agents/$1" ] && { echo "$r/agents/$1"; return; }; fi
    done
}
missing=() repoint=() orphan=() foreign=() missing_from=" "
classify() {  # classify <link> <skills|agents>
    local link="$1" kind="$2" want
    want="$(provider_of "$(basename "$link")" "$kind")"
    if [ -n "$want" ]; then repoint+=("$link|$want")
    elif [ ! -e "$link" ]; then orphan+=("$link")
    else foreign+=("$link"); fi
}
check_home() {
    local home="$1" kind="$2" r src n link seen=" "
    [ -d "$home" ] || return 0
    for r in "${REPOS[@]}"; do
        if [ "$kind" = skills ]; then
            for src in "$r"/skills/*/SKILL.md; do
                [ -f "$src" ] || continue
                # Claude-only skills are not linked for the other providers.
                [ "$home" != "$HOME/.claude/skills" ] \
                    && grep -Eq '^providers:[[:space:]]*claude[[:space:]]*$' "$src" && continue
                n="$(basename "$(dirname "$src")")"; link="$home/$n"
                if [ ! -e "$link" ] && [ ! -L "$link" ]; then missing+=("$link"); missing_from="$missing_from$r "
                elif [ -L "$link" ] && ! points_into_repos "$link"; then classify "$link" skills; seen="$seen$link "; fi
            done
        else
            for src in "$r"/agents/*.md; do
                [ -f "$src" ] || continue
                n="$(basename "$src")"; [ "$n" = README.md ] && continue
                link="$home/$n"
                if [ ! -e "$link" ] && [ ! -L "$link" ]; then missing+=("$link"); missing_from="$missing_from$r "
                elif [ -L "$link" ] && ! points_into_repos "$link"; then classify "$link" agents; seen="$seen$link "; fi
            done
        fi
    done
    # Links nothing above checked: their name is in no configured repo.
    # Only names in the a_ namespace: anything else (a marketplace or plugin skill) is
    # not installed by these repos, so it is not ours to judge.
    for link in "$home"/a_*; do
        [ -L "$link" ] || continue
        case "$seen" in *" $link "*) continue ;; esac
        points_into_repos "$link" && continue
        if [ ! -e "$link" ]; then orphan+=("$link"); else foreign+=("$link"); fi
    done
}
check_home "$HOME/.claude/skills" skills
check_home "$HOME/.agents/skills" skills
check_home "$HOME/.claude/agents" agents

short() { echo "${1/#$HOME/~}"; }
INSTALL_CMD="\"$DEVKIT/install.sh\""
if $FIX; then
    for pair in ${repoint[@]+"${repoint[@]}"}; do
        rm "${pair%%|*}" && ln -s "${pair#*|}" "${pair%%|*}" && info "repointed $(short "${pair%%|*}") -> $(short "${pair#*|}")"
    done
    for link in ${orphan[@]+"${orphan[@]}"}; do rm "$link" && info "removed $(short "$link") (no repo has it)"; done
    repoint=() orphan=()
fi
if [ "${#missing[@]}" -eq 0 ] && [ "${#repoint[@]}" -eq 0 ] && [ "${#orphan[@]}" -eq 0 ] && [ "${#foreign[@]}" -eq 0 ]; then
    good "every skill and agent in these repos is linked"
else
    if [ "${#missing[@]}" -gt 0 ]; then
        bad "${#missing[@]} not installed yet, e.g. $(short "${missing[0]}")"
        # An installer that is out of date cannot install what it does not know about,
        # so a repo with updates waiting has to be pulled first.
        stale_src=""
        for r in "${REPOS[@]}"; do
            case "$missing_from" in *" $r "*) case "$BEHIND" in *" $r "*) stale_src="$stale_src $r" ;; esac ;; esac
        done
        if [ -n "$stale_src" ]; then
            for r in $stale_src; do info "they come from $(basename "$r"), which has updates waiting; its installer here is older"; done
            fix "$(for r in $stale_src; do printf 'git -C "%s" pull && ' "$r"; done)$INSTALL_CMD"
        else
            fix "$INSTALL_CMD"
        fi
    fi
    if [ "${#repoint[@]}" -gt 0 ]; then
        bad "${#repoint[@]} link(s) point at an old copy; a configured repo has the right one:"
        for pair in "${repoint[@]}"; do info "$(short "${pair%%|*}") -> $(short "$(readlink "${pair%%|*}")")"; done
    fi
    if [ "${#repoint[@]}" -gt 0 ]; then
        fix "$INSTALL_CMD"
    fi
    if [ "${#orphan[@]}" -gt 0 ]; then
        unknown_overlay_role=false
        # Group the dead links by the repo they were linked from (<root>/skills/<name>).
        roots=" "
        for link in "${orphan[@]}"; do
            src="$(dirname "$(dirname "$(readlink "$link")")")"
            case "$roots" in *" $src "*) ;; *) roots="$roots$src " ;; esac
        done
        for src in $roots; do
            names=""; count=0; first=""
            for link in "${orphan[@]}"; do
                [ "$(dirname "$(dirname "$(readlink "$link")")")" = "$src" ] || continue
                n="$(basename "$link")"; count=$((count+1))
                case " $names " in *" $n "*) ;; *) names="$names $n"; [ -n "$first" ] || first="$n" ;; esac
            done
            if [ -d "$src" ]; then
                bad "$count link(s) to skills or agents that $(short "$src") no longer has:"
                info "${names# }"
                fix "a_c_doctor --fix   (removes these dead links)"
                continue
            fi
            bad "$count link(s) lead into $(short "$src"), which is not on this machine:"
            info "${names# }"
            # Is that repo somewhere else here? Look in the repo folders and next to the devkit.
            found=""
            for d in "${a_dir_p_repos:-}" "${a_dir_w_repos:-}" "${a_dir_g_repos:-}" "$(dirname "$DEVKIT")"; do
                [ -n "$d" ] || continue
                c="$d/$(basename "$src")"
                if [ -f "$c/skills/$first/SKILL.md" ] || [ -f "$c/agents/$first" ]; then found="$c"; break; fi
            done
            if [ -n "$found" ]; then
                info "that repo is on this machine at $(short "$found")"
                fix "a_c_doctor --set-overlay \"$found\""
            else
                info "they came from your overlay repo ($(basename "$src")). To keep them, clone it on this machine and record where:"
                private_dir="${A_AGENT_OVERLAY_DIR:-${PRIVATE_DEVKIT_DIR:-}}"
                org_dir="${A_AGENT_ORG_OVERLAY_DIR:-${ORG_DEVKIT_DIR:-}}"
                private_dir="${private_dir/#\~/$HOME}"; org_dir="${org_dir/#\~/$HOME}"
                if [ -n "$private_dir" ] && [ "${private_dir%/}" = "$src" ]; then
                    fix "a_c_doctor set private overlay"
                elif [ -n "$org_dir" ] && [ "${org_dir%/}" = "$src" ]; then
                    fix "a_c_doctor set org overlay"
                else
                    info "its overlay role is not recorded here"
                    unknown_overlay_role=true
                fi
                info "or, if this machine should not have them:"
                fix "a_c_doctor --fix   (removes these dead links)"
            fi
        done
        if $unknown_overlay_role; then
            info "For each unclassified source above, choose its role once:"
            info "personal: a_c_doctor set private overlay"
            info "organisation: a_c_doctor set org overlay"
        fi
    fi
    if [ "${#foreign[@]}" -gt 0 ]; then
        roots=" "
        for link in "${foreign[@]}"; do
            src="$(dirname "$(dirname "$(readlink "$link")")")"
            case "$roots" in *" $src "*) ;; *) roots="$roots$src " ;; esac
        done
        for src in $roots; do
            names=""; count=0
            for link in "${foreign[@]}"; do
                [ "$(dirname "$(dirname "$(readlink "$link")")")" = "$src" ] || continue
                n="$(basename "$link")"; count=$((count+1))
                case " $names " in *" $n "*) ;; *) names="$names $n" ;; esac
            done
            bad "$count link(s) lead into $(short "$src"), which this machine does not use as a repo:"
            info "${names# }"
            info "if that is your overlay, record it:"
            fix "a_c_doctor --set-overlay \"$src\""
            info "if not, remove the links (--fix leaves them alone, since the folder still exists):"
            fix "find ~/.claude/skills ~/.claude/agents ~/.agents/skills -maxdepth 1 -lname '$src/*' -delete 2>/dev/null"
        done
    fi
fi

# ------------------------------------------------------------------- guidance
section "Agent guidance"
if [ -x "$DEVKIT/scripts/a_c_agent_memory" ]; then
    if MY_WORKFLOW_DIR="${MY_WORKFLOW_DIR:-$DEVKIT}" "$DEVKIT/scripts/a_c_agent_memory" check >/dev/null 2>&1; then
        good "Claude, Codex and Gemini guidance matches its sources"
    else
        bad "the generated guidance is out of date with its sources"
        fix "$INSTALL_CMD"
    fi
fi

# ------------------------------------------------------------------- summary
echo
echo -e "${GREEN}$ok ok${NC}  ${YELLOW}$warn to fix${NC}  ${RED}$err broken${NC}"
[ $((warn + err)) -eq 0 ]
