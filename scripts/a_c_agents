#!/usr/bin/env bash
# Manage the canonical subagent library for Claude, Codex, AGY, and Gemini CLI.

set -euo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; DIM='\033[2m'; NC='\033[0m'

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
REPO_ROOT="$(cd -P "$SCRIPT_DIR/.." && pwd)"
AGENTS_SRC="${AGENTS_SRC:-${CLAUDE_AGENTS_SRC:-$REPO_ROOT/agents}}"
RENDERER="$SCRIPT_DIR/a_s_render_agent"

PROVIDER="${AGENT_PROVIDER:-claude}"
TARGET_DIR=""
BACKUP_DIR=""
DRY_RUN=false
FORCE=false

usage() {
    cat <<'EOF'
Usage: a_c_agents [--provider claude|codex|agy|gemini-cli] ACTION [name...] [flags]

Actions: install, uninstall, status, list
Flags:   -n/--dry-run, -f/--force, -h/--help

The canonical sources are agents/*.md. Claude receives source symlinks; Codex,
AGY/Antigravity, and Gemini CLI receive generated provider-native definitions.
EOF
}

discover_agents() {
    local f
    for f in "$AGENTS_SRC"/*.md; do
        [ -f "$f" ] || continue
        [ "$(basename "$f")" = README.md ] || basename "$f" .md
    done
}

normalize_provider() {
    case "$PROVIDER" in
        gemini) PROVIDER=agy ;;
        claude|codex|agy|gemini-cli) ;;
        *) echo -e "${RED}Unknown provider: $PROVIDER${NC}" >&2; exit 2 ;;
    esac
    case "$PROVIDER" in
        claude) TARGET_DIR="${CLAUDE_AGENTS_DIR:-$HOME/.claude/agents}" ;;
        codex) TARGET_DIR="${CODEX_AGENTS_DIR:-$HOME/.codex/agents}" ;;
        agy) TARGET_DIR="${AGY_AGENTS_DIR:-$HOME/.gemini/config/agents}" ;;
        gemini-cli) TARGET_DIR="${GEMINI_CLI_AGENTS_DIR:-$HOME/.gemini/agents}" ;;
    esac
    BACKUP_DIR="${AGENTS_BACKUP_DIR:-${TARGET_DIR%/}.backups}"
}

target_name() {
    case "$PROVIDER" in
        codex) printf '%s.toml\n' "$1" ;;
        *) printf '%s.md\n' "$1" ;;
    esac
}

is_managed() {
    grep -q 'Generated by agentic-devkit' "$1" 2>/dev/null
}

render_to() {
    "$RENDERER" "$PROVIDER" "$AGENTS_SRC/$1.md" > "$2"
}

install_one() {
    local name="$1" source="$AGENTS_SRC/$1.md" target="$TARGET_DIR/$(target_name "$1")"
    [ -f "$source" ] || { echo -e "  ${RED}missing${NC}   $name"; return 1; }

    if [ "$PROVIDER" = claude ]; then
        if [ -L "$target" ] && [ "$(readlink "$target")" = "$source" ]; then
            echo -e "  ${GREEN}ok${NC}        $name ${DIM}(already linked)${NC}"
            return
        fi
        if [ -e "$target" ] || [ -L "$target" ]; then
            if ! $FORCE; then
                echo -e "  ${YELLOW}skip${NC}      $name ${DIM}(target exists; use --force)${NC}"
                return
            fi
            $DRY_RUN || { mkdir -p "$BACKUP_DIR"; mv "$target" "$BACKUP_DIR/$(basename "$target").$(date +%Y%m%d-%H%M%S)"; }
        fi
        $DRY_RUN || ln -s "$source" "$target"
        echo -e "  ${GREEN}linked${NC}    $name ${DIM}-> $source${NC}"
        return
    fi

    local rendered
    rendered="$(mktemp)"
    render_to "$name" "$rendered"
    if [ -f "$target" ] && cmp -s "$rendered" "$target"; then
        echo -e "  ${GREEN}ok${NC}        $name ${DIM}(generated $PROVIDER adapter is current)${NC}"
    elif [ -e "$target" ] && ! is_managed "$target" && ! $FORCE; then
        echo -e "  ${YELLOW}skip${NC}      $name ${DIM}(unmanaged target exists; use --force)${NC}"
    else
        if [ -e "$target" ] && ! is_managed "$target"; then
            $DRY_RUN || { mkdir -p "$BACKUP_DIR"; mv "$target" "$BACKUP_DIR/$(basename "$target").$(date +%Y%m%d-%H%M%S)"; }
        fi
        $DRY_RUN || cp "$rendered" "$target"
        echo -e "  ${GREEN}generated${NC} $name ${DIM}-> $target${NC}"
    fi
    rm -f "$rendered"
}

uninstall_one() {
    local name="$1" target="$TARGET_DIR/$(target_name "$1")" source="$AGENTS_SRC/$1.md"
    if [ "$PROVIDER" = claude ] && [ -L "$target" ] && [ "$(readlink "$target")" = "$source" ]; then
        $DRY_RUN || rm "$target"
        echo -e "  ${GREEN}unlinked${NC}  $name"
    elif [ "$PROVIDER" != claude ] && [ -f "$target" ] && is_managed "$target"; then
        $DRY_RUN || rm "$target"
        echo -e "  ${GREEN}removed${NC}   $name ${DIM}($PROVIDER adapter)${NC}"
    elif [ -e "$target" ] || [ -L "$target" ]; then
        echo -e "  ${YELLOW}skip${NC}      $name ${DIM}(not managed by this repo)${NC}"
    else
        echo -e "  ${DIM}absent${NC}    $name"
    fi
}

status_one() {
    local name="$1" target="$TARGET_DIR/$(target_name "$1")" source="$AGENTS_SRC/$1.md"
    if [ "$PROVIDER" = claude ]; then
        if [ -L "$target" ] && [ "$(readlink "$target")" = "$source" ]; then
            echo -e "  ${GREEN}● linked${NC}      $name"
        elif [ -e "$target" ] || [ -L "$target" ]; then
            echo -e "  ${YELLOW}▲ unmanaged${NC}   $name"
        else
            echo -e "  ${DIM}○ not installed${NC} $name"
        fi
        return
    fi
    if [ -f "$target" ] && is_managed "$target"; then
        local rendered
        rendered="$(mktemp)"
        render_to "$name" "$rendered"
        if cmp -s "$rendered" "$target"; then
            echo -e "  ${GREEN}● current${NC}     $name"
        else
            echo -e "  ${YELLOW}▲ stale${NC}       $name"
        fi
        rm -f "$rendered"
    elif [ -e "$target" ] || [ -L "$target" ]; then
        echo -e "  ${YELLOW}▲ unmanaged${NC}   $name"
    else
        echo -e "  ${DIM}○ not installed${NC} $name"
    fi
}

main() {
    local args=()
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --provider)
                [ "$#" -ge 2 ] || { echo "--provider needs a value" >&2; exit 2; }
                PROVIDER="$2"; shift ;;
            -n|--dry-run) DRY_RUN=true ;;
            -f|--force) FORCE=true ;;
            -h|--help) usage; exit 0 ;;
            *) args+=("$1") ;;
        esac
        shift
    done
    normalize_provider
    [ -d "$AGENTS_SRC" ] || { echo -e "${RED}No agents dir at $AGENTS_SRC${NC}"; exit 1; }
    [ -x "$RENDERER" ] || { echo -e "${RED}Renderer is not executable: $RENDERER${NC}"; exit 1; }

    local action="${args[0]:-status}" names=() i normalized
    for ((i=1; i<${#args[@]}; i++)); do
        normalized="$(basename "${args[$i]}")"
        normalized="${normalized%.md}"
        normalized="${normalized%.toml}"
        names+=("$normalized")
    done
    if [ "${#names[@]}" -eq 0 ]; then
        while read -r normalized; do [ -n "$normalized" ] && names+=("$normalized"); done < <(discover_agents)
    fi

    case "$action" in
        list)
            echo -e "${BLUE}Canonical agents${NC} ${DIM}($AGENTS_SRC)${NC}"
            printf '  %s\n' "${names[@]}"
            ;;
        status)
            echo -e "${BLUE}Provider:${NC} $PROVIDER"
            echo -e "${BLUE}Target:${NC}   $TARGET_DIR"
            for normalized in "${names[@]}"; do status_one "$normalized"; done
            ;;
        install)
            $DRY_RUN || mkdir -p "$TARGET_DIR"
            $DRY_RUN && echo -e "${YELLOW}(dry run)${NC}"
            echo -e "${BLUE}Installing $PROVIDER agents into${NC} $TARGET_DIR"
            for normalized in "${names[@]}"; do install_one "$normalized"; done
            ;;
        uninstall)
            $DRY_RUN && echo -e "${YELLOW}(dry run)${NC}"
            for normalized in "${names[@]}"; do uninstall_one "$normalized"; done
            ;;
        *) echo -e "${RED}Unknown action: $action${NC}"; usage; exit 2 ;;
    esac
}

main "$@"
