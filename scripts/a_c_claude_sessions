  <div class="empty" id="empty" style="display:none">No sessions match your search.</div>
</div>
<script>
var REFRESH = __REFRESH_SECS__ * 1000;
var DATA = [];
var OPEN = {};   // session ids (or pid keys) currently expanded
var KILL_ENABLED = false;
function esc(s){ s = (s==null?'':String(s));
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function key(s){ return s.session_id || ('pids:'+(s.pids||[]).join(',')); }
function haystack(s){ return [s.label,s.key,s.key_ref,s.name,s.project,s.cwd,s.git_branch,s.doing,s.first_prompt,
  s.session_id,(s.pids||[]).join(' '),s.remote_control,s.model].join('  ').toLowerCase(); }
function matches(s,q){ if(!q) return true;
  var h = haystack(s);
  return q.toLowerCase().split(/\s+/).filter(Boolean).every(function(t){ return h.indexOf(t)>=0; }); }
function detailHTML(s){
  var rows = [];
  function add(k,v,mono){ if(v==null||v==='') return;
    rows.push('<div class="drow"><div class="dk">'+esc(k)+'</div><div class="dv'+(mono?' mono':'')+'">'+esc(v)+'</div></div>'); }
  add('Session', s.label || s.name);
  add(s.key_kind === 'pr' ? 'Pull request' : 'Ticket',
      s.key ? (s.key + (s.key_ref ? ' · ' + s.key_ref : '')) : '');
  add('Session ID', s.session_id || 'n/a (no transcript yet)', true);
  add('Directory', s.cwd || 'unknown', true);
  add('Git branch', s.git_branch, true);
  add('State', (s.active_now?'working now':'open & idle')+' · last active '+s.last_active_human);
  add('Model', s.model, true);
  add('Permission', s.permission_mode);
  add('Remote control', s.remote_control);
  add('PIDs', (s.pids||[]).join(', '), true);
  add('Started as (first prompt)', s.first_prompt);
  add('Doing (last prompt)', s.doing);
  add('Transcript', s.transcript, true);
  var cmd = s.resume_command;
  var cmdHTML = cmd
    ? '<div class="drow"><div class="dk">Restore</div><div class="dv"><div class="cmd">'
      +'<code id="cmd_'+esc(key(s))+'">'+esc(cmd)+'</code>'
      +'<button class="copy" data-copy="'+esc(cmd)+'">Copy</button></div></div></div>'
    : '<div class="drow"><div class="dk">Restore</div><div class="dv">no session id captured yet</div></div>';
  var killHTML = '';
  if(KILL_ENABLED){
    var nm = esc(s.name)+' ('+esc(s.session_id||('pids '+(s.pids||[]).join(','))) + ')';
    killHTML = '<div class="drow"><div class="dk">Danger</div><div class="dv"><div class="cmd">'
      +'<button class="kill" data-kill="'+esc(key(s))+'" data-name="'+nm+'">End session (SIGTERM)</button>'
      +'<button class="kill force" data-kill="'+esc(key(s))+'" data-force="1" data-name="'+nm+'">Force kill (SIGKILL)</button>'
      +'<span class="killnote">signals PID(s) '+esc((s.pids||[]).join(', '))+'</span>'
      +'</div></div></div>';
  }
  return '<div class="dgrid">'+rows.join('')+cmdHTML+killHTML+'</div>';
}
function render(){
  var q = document.getElementById('q').value.trim();
  var list = DATA.filter(function(s){ return matches(s,q); });
  var tb = document.getElementById('rows');
  var html = '';
  list.forEach(function(s,i){
    var k = key(s); var isOpen = !!OPEN[k];
    var branch = s.git_branch ? '<span class="branch">'+esc(s.git_branch)+'</span>' : '';
    var doing = s.doing ? esc(s.doing.length>200 ? s.doing.slice(0,199)+'…' : s.doing) : '';
    html += '<tr class="row '+(s.active_now?'working':'idle')+(isOpen?' open':'')+'" data-k="'+esc(k)+'">'
      + '<td class="num">'+(i+1)+'</td>'
      + '<td class="dot">'+(s.active_now?'🟢':'⚪')+'</td>'
      + '<td class="ago">'+esc(s.last_active_human)+'</td>'
      + '<td class="name"><span class="caret">'+(isOpen?'▼':'▶')+'</span>'
      + (s.key ? '<span class="key">'+esc(s.key)+'</span>' : '')
      + esc(s.key ? (s.label||'').slice(s.key.length+3) : (s.label||s.name))+'</td>'
      + '<td class="proj">'+esc(s.project||'?')+branch+'<span class="path">'+esc(s.cwd||'unknown')+'</span></td>'
      + '<td class="doing">'+doing+'</td>'
      + '<td class="sid">'+esc(s.session_id||'n/a')+'</td></tr>';
    if(isOpen){ html += '<tr class="detail"><td colspan="7">'+detailHTML(s)+'</td></tr>'; }
  });
  tb.innerHTML = html;
  document.getElementById('empty').style.display = list.length ? 'none' : 'block';
}
function refresh(){
  fetch('/json',{cache:'no-store'}).then(function(r){return r.json();}).then(function(d){
    DATA = d.sessions||[];
    KILL_ENABLED = !!d.kill_enabled;
    var a = DATA.filter(function(s){return s.active_now;}).length;
    document.getElementById('sub').innerHTML = 'Updated '+esc(d.generated)
      + ' <span class="pill g">'+a+' working</span>'
      + ' <span class="pill n">'+(DATA.length-a)+' idle</span>'
      + ' <span class="pill n">'+DATA.length+' total</span>';
    render();
  }).catch(function(){ document.getElementById('sub').textContent='(refresh failed, retrying…)'; });
}
function killSession(btn){
  var k = btn.getAttribute('data-kill');
  var force = btn.getAttribute('data-force')==='1';
  var nm = btn.getAttribute('data-name')||'this session';
  var msg = (force?'FORCE KILL (SIGKILL)':'End (SIGTERM)')+' '+nm+'?\n\n'
    +'This signals the running claude process. Unsaved work in that session may be lost.';
  if(!window.confirm(msg)) return;
  btn.disabled = true; var old = btn.textContent; btn.textContent = 'Killing…';
  fetch('/kill',{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({key:k,force:force})})
    .then(function(r){return r.json();})
    .then(function(res){
      if(!res.ok){ alert('Kill failed: '+(res.error||'unknown')); btn.disabled=false; btn.textContent=old; return; }
      var killed = (res.killed||[]).length, skip = (res.skipped||[]).length;
      OPEN[k] = false;
      setTimeout(refresh, 400);
      if(!killed){ alert('Nothing killed ('+res.signal+'). '+
        ((res.skipped||[]).map(function(x){return x.pid+': '+x.reason;}).join('; ')||'')); }
    })
    .catch(function(){ alert('Kill request failed to reach the server.'); btn.disabled=false; btn.textContent=old; });
}
document.getElementById('q').addEventListener('input', render);
document.getElementById('rows').addEventListener('click', function(e){
  var kb = e.target.closest('button.kill');
  if(kb){ e.stopPropagation(); killSession(kb); return; }
  var btn = e.target.closest('button.copy');
  if(btn){ e.stopPropagation();
    navigator.clipboard.writeText(btn.getAttribute('data-copy')).then(function(){
      var t=btn.textContent; btn.textContent='Copied'; setTimeout(function(){btn.textContent=t;},1200); });
    return; }
  var tr = e.target.closest('tr.row'); if(!tr) return;
  var k = tr.getAttribute('data-k'); OPEN[k] = !OPEN[k]; render();
});
refresh(); setInterval(refresh, REFRESH);
</script>
</body></html>"""


# --------------------------------------------------------------------------- #
# mdnest write (safe: literal temp file -> "$(cat)" -> verify)
# --------------------------------------------------------------------------- #
def write_mdnest(markdown, path):
    import tempfile
    with tempfile.NamedTemporaryFile("w", suffix=".md", delete=False) as tf:
        tf.write(markdown)
        tmp = tf.name
    try:
        # Does it already exist? Choose write vs create.
        exists = subprocess.run(
            ["bash", "-lc", f'mdnest read {path} >/dev/null 2>&1 && echo yes || echo no'],
            capture_output=True, text=True,
        ).stdout.strip()
        verb = "write" if exists == "yes" else "create"
        r = subprocess.run(
            ["bash", "-lc", f'mdnest {verb} {path} "$(cat {tmp})"'],
            capture_output=True, text=True,
        )
        if r.returncode != 0:
            print(f"mdnest {verb} failed:\n{r.stderr or r.stdout}", file=sys.stderr)
            return False
        # Verify: no escaped backticks survived, content is present.
        chk = subprocess.run(
            ["bash", "-lc", f'mdnest read {path}'],
            capture_output=True, text=True,
        ).stdout
        if "\\`" in chk:
            print("verify FAILED: escaped backticks found in stored note", file=sys.stderr)
            return False
        if "Running Sessions" not in chk:
            print("verify FAILED: heading missing from stored note", file=sys.stderr)
            return False
        print(f"mdnest {verb} OK -> {path}  ({len(chk)} bytes verified)")
        return True
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass


