#!/usr/bin/env python3
"""
a_c_claude_sessions - dashboard + search for the Claude Code sessions on this machine.

For every running `claude` CLI process it resolves the exact session it is on
(session id, human title, and the last thing it was asked to do), orders them by
most-recently-active first, and renders that as:

  --print        Markdown to stdout (default) - LIVE sessions only
  --json         raw JSON of the collected sessions
  --write-mdnest write the Markdown dashboard to an mdnest note (safe write + verify)
  --serve        run a tiny web page (auto-refreshing) at http://HOST:PORT.
                 Binds 127.0.0.1 (this machine only) by default; --tailscale
                 exposes it on this host's tailnet IP, or --bind ADDR for any.

Make it survive reboots (portable - reads THIS machine's paths at install time,
so it works the same on any Mac that has the my_setup repo set up):

  --install-web-agent [PORT]   generate + load a launchd agent that serves the
                               dashboard on the tailnet at LOGIN (default 8787)
  --install-mdnest-agent       launchd agent refreshing the mdnest note every 10 min
  --uninstall-web-agent / --uninstall-mdnest-agent   remove them

  --install-boot-daemon [PORT] needs sudo. A system LaunchDaemon that starts at
                               BOOT, before any login, so an unattended reboot
                               (power cut, remote reboot) brings the dashboard
                               back with nobody at the keyboard. Runs as your
                               user, and retires the login agent so the two
                               never clash on the port.
  --uninstall-boot-daemon      needs sudo. Remove it

It also searches EVERY session transcript on disk, live or already closed, so a
session you closed by mistake can be found again and resumed:

  --find QUERY   rank all sessions by how well they match QUERY (ticket key, PR
                 number, repo name, task, title, branch, session id) and print the
                 exact `claude --resume` command for each match. Newest activity
                 breaks ties.
  --all          list every session on disk (live + closed), newest first.
  --since W      only sessions active within a window (36h, 2d, 90m); shows all
                 of them and lifts the scan cap
  --limit N      cap the transcript scan to the N most-recently-active sessions
                 (default 600; use 0 for no cap). Search is head+tail only, so
                 even large transcripts are cheap to scan.

--find / --all combine with --json for machine-readable output (used by the
a_sag_claude_session_finder sub-agent).

How it works
------------
1. Read the process table and keep the real `claude` CLI processes (not the desktop
   GUI app, its renderer helpers, or the background pty host).
2. For each process get its working directory (lsof) and pull any session id,
   --remote-control name, or leading prompt straight out of its argv.
3. Map the process to its session .jsonl under ~/.claude/projects. If argv named a
   session id, use it; otherwise take the most recently written session in the
   project directory that matches the cwd.
4. Read each session .jsonl for its ai title, its last prompt (what it is doing),
   its first prompt (why it exists), git branch, and last-activity time.
5. Name the session after the work it belongs to: a ticket key from the branch or
   worktree dir, else a PR (a review-pr-N branch or a PR URL in the first prompt),
   else a ticket named in the first prompt. The label is "<key> · <repo> · <what>",
   and the key is weighted like a session id when searching, so `--find PROJ-142`
   or `--find 1452` lands exactly. Derived from disk, so it works on old sessions.
6. Order by last-activity time, newest on top, and render.

Read-only. Never writes to any repo. Only --write-mdnest touches mdnest.
"""

import argparse
import json
import os
import pwd
import re
import shutil
import sqlite3
import signal
import subprocess
import sys
import threading
import time
from datetime import datetime, timezone
from urllib.parse import urlparse

HOME = os.path.expanduser("~")
PROJECTS_DIR = os.path.join(HOME, ".claude", "projects")
UUID_RE = re.compile(
    r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", re.I
)
DEFAULT_MDNEST_PATH = "@work/my_brain/Automations/Claude/RunningSessions.md"
# A session whose transcript changed within this many seconds is "working now",
# otherwise it is an open-but-idle session (process alive, waiting on input).
ACTIVE_WINDOW_SECS = 180


# --------------------------------------------------------------------------- #
# Process collection
# --------------------------------------------------------------------------- #
def _is_real_claude(cmd):
    """True for the claude CLI, false for the desktop GUI / helpers / pty host."""
    if "--bg-pty-host" in cmd:
        return False
    # Desktop Electron app shell and its renderer processes.
    if "/Applications/Claude.app/Contents/MacOS/Claude" in cmd:
        return False
    if "Claude Helper" in cmd:
        return False
    # The real CLI is invoked as `claude ...`, `.../bin/claude.exe ...`,
    # or the headless desktop agent `.../claude.app/Contents/MacOS/claude --output-format ...`.
    first = cmd.split(None, 1)[0] if cmd else ""
    base = os.path.basename(first)
    if base in ("claude", "claude.exe"):
        return True
    if base == "claude" or first.endswith("/MacOS/claude"):
        return True
    # bare `claude` / `claude -r` / `claude <prompt>`
    if cmd == "claude" or cmd.startswith("claude "):
        return True
    return False


def _cwd_of(pid):
    return _cwds_of([pid]).get(int(pid))


def _cwds_of(pids):
    """Working directory of many pids in ONE lsof call (per-pid calls were the
    slow part that wedged the single request)."""
    res = {}
    pids = [str(p) for p in pids]
    if not pids:
        return res
    try:
        out = subprocess.run(
            ["lsof", "-a", "-d", "cwd", "-Fpn", "-p", ",".join(pids)],
            capture_output=True, text=True, timeout=20,
        ).stdout
    except Exception:
        return res
    cur = None
    for line in out.splitlines():
        if not line:
            continue
        tag, val = line[0], line[1:]
        if tag == "p":
            try:
                cur = int(val)
            except ValueError:
                cur = None
        elif tag == "n" and cur is not None:
            res.setdefault(cur, val)
    return res


def _parse_argv(cmd):
    """Pull the useful bits out of a claude command line."""
    info = {
        "session_id": None,
        "remote_control": None,
        "prompt": None,
        "permission_mode": None,
        "forked": "--fork-session" in cmd,
        "resumed": False,
    }
    # --session-id <uuid>
    m = re.search(r"--session-id[=\s]+([0-9a-fA-F-]{36})", cmd)
    if m:
        info["session_id"] = m.group(1).lower()
    # --resume[=| ]<uuid> (also implies a resumed session) or --resume <path.jsonl>
    m = re.search(r"--resume[=\s]+(\S+)", cmd)
    if m:
        info["resumed"] = True
        val = m.group(1)
        um = UUID_RE.search(val)
        if um and not info["session_id"]:
            info["session_id"] = um.group(0).lower()
    if re.search(r"(^|\s)-r(\s|$)", cmd):
        info["resumed"] = True
    m = re.search(r"--remote-control[=\s]+(\S+)", cmd)
    if m:
        info["remote_control"] = m.group(1)
    m = re.search(r"--permission-mode[=\s]+(\S+)", cmd)
    if m:
        info["permission_mode"] = m.group(1)
    # Leading free-text prompt: the token(s) after `claude` before the first flag,
    # only for the simple `claude <prompt> ...` invocation form.
    m = re.match(r"claude\s+(?!-)(.+?)(?:\s--|\s-[a-zA-Z]|$)", cmd)
    if m:
        cand = m.group(1).strip()
        if cand and not cand.startswith("-"):
            info["prompt"] = cand
    return info


def collect_processes():
    """Return a list of live claude CLI processes with argv-derived hints + cwd."""
    try:
        out = subprocess.run(
            ["ps", "-Ao", "pid=,etime=,%cpu=,command="],
            capture_output=True, text=True, timeout=15,
        ).stdout
    except Exception as e:
        print(f"error: could not read process table: {e}", file=sys.stderr)
        return []
    procs = []
    for line in out.splitlines():
        line = line.strip()
        if not line:
            continue
        parts = line.split(None, 3)
        if len(parts) < 4:
            continue
        pid, etime, cpu, cmd = parts
        if not _is_real_claude(cmd):
            continue
        p = {"pid": int(pid), "etime": etime, "cpu": cpu, "cmd": cmd}
        p.update(_parse_argv(cmd))
        procs.append(p)
    # Resolve every cwd in ONE lsof call (per-pid calls were the slow part).
    cwds = _cwds_of([p["pid"] for p in procs])
    for p in procs:
        p["cwd"] = cwds.get(p["pid"])
    return procs


# --------------------------------------------------------------------------- #
# Session (transcript) resolution
# --------------------------------------------------------------------------- #
def _project_dir_for_cwd(cwd):
    """Claude encodes a cwd into a project dir name by turning every
    non-alphanumeric character (/, ., _, space, ...) into a dash."""
    if not cwd:
        return None
    encoded = re.sub(r"[^A-Za-z0-9]", "-", cwd)
    path = os.path.join(PROJECTS_DIR, encoded)
    return path if os.path.isdir(path) else None


# session id -> transcript path, built once (cheap: one listdir per project dir).
_SESSION_INDEX = None


def _session_index():
    global _SESSION_INDEX
    if _SESSION_INDEX is None:
        _SESSION_INDEX = {}
        try:
            for proj in os.listdir(PROJECTS_DIR):
                pdir = os.path.join(PROJECTS_DIR, proj)
                if not os.path.isdir(pdir):
                    continue
                for fn in os.listdir(pdir):
                    if fn.endswith(".jsonl"):
                        _SESSION_INDEX[fn[:-6]] = os.path.join(pdir, fn)
        except OSError:
            pass
    return _SESSION_INDEX


def _find_session_file(session_id):
    """Locate a session .jsonl anywhere under projects by its id."""
    if not session_id:
        return None
    return _session_index().get(session_id.lower())


def _newest_session_in(project_dir):
    if not project_dir or not os.path.isdir(project_dir):
        return None
    best, best_mt = None, -1
    for fn in os.listdir(project_dir):
        if not fn.endswith(".jsonl"):
            continue
        fp = os.path.join(project_dir, fn)
        try:
            mt = os.path.getmtime(fp)
        except OSError:
            continue
        if mt > best_mt:
            best, best_mt = fp, mt
    return best


def _text_from_content(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        for part in content:
            if isinstance(part, dict) and part.get("type") == "text":
                return part.get("text")
    return None


def read_session_meta(session_file):
    """Extract the display metadata from a session transcript."""
    meta = {
        "session_id": os.path.basename(session_file)[:-6],
        "file": session_file,
        "ai_title": None,
        "last_prompt": None,
        "first_prompt": None,
        "cwd": None,
        "git_branch": None,
        "model": None,
        "mtime": None,
        "last_ts": None,
        "custom_title": None,
        "agent_name": None,
    }
    try:
        meta["mtime"] = os.path.getmtime(session_file)
    except OSError:
        pass
    try:
        with open(session_file, "r", errors="replace") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    d = json.loads(line)
                except json.JSONDecodeError:
                    continue
                t = d.get("type")
                ts = _epoch_from_iso(d.get("timestamp"))
                if ts and ts > (meta.get("last_ts") or 0):
                    meta["last_ts"] = ts
                if t == "ai-title":
                    meta["ai_title"] = d.get("aiTitle") or meta["ai_title"]
                elif t == "custom-title":
                    meta["custom_title"] = d.get("customTitle") or meta["custom_title"]
                elif t == "agent-name":
                    meta["agent_name"] = d.get("agentName") or meta["agent_name"]
                elif t == "last-prompt":
                    meta["last_prompt"] = d.get("lastPrompt") or meta["last_prompt"]
                if d.get("cwd"):
                    meta["cwd"] = d["cwd"]
                if d.get("gitBranch"):
                    meta["git_branch"] = d["gitBranch"]
                if t == "user" and not d.get("isMeta"):
                    txt = _text_from_content(d.get("message", {}).get("content"))
                    if txt and not txt.lstrip().startswith("<"):
                        if not meta["first_prompt"]:
                            meta["first_prompt"] = txt
                        meta["last_prompt"] = meta["last_prompt"] or txt
                if t == "assistant":
                    m = d.get("message", {})
                    if m.get("model"):
                        meta["model"] = m["model"]
    except OSError:
        pass
    return meta


# --------------------------------------------------------------------------- #
# Session key + label: name a session after the work it belongs to.
#
# A session is far easier to find again (especially after a crash, when every
# window is gone and only transcripts survive) if its row says "PROJ-142" or
# "PR #1452" instead of the first half-sentence you happened to type. The key is
# DERIVED from what is already on disk, so it works retroactively on every old
# transcript and needs nothing from the session itself.
#
# Priority: ticket in the branch / worktree dir, then a PR (review-pr-N branch or
# a PR URL in the FIRST prompt), then a ticket named in the first prompt, then
# nothing. Branch and directory are trusted; free prompt text is not, because a
# transcript is full of ticket-shaped strings that are not this session's ticket
# (rule examples in CLAUDE.md, keys quoted inside a reviewed diff), so a ticket
# from a prompt counts only when it appears in a deliberate reference.
# --------------------------------------------------------------------------- #
_TICKET_RE = re.compile(r"(?<![A-Za-z0-9])([A-Za-z]{2,10})-(\d{1,6})(?![A-Za-z0-9])")
# Prefixes that look like a ticket key but never are.
_TICKET_STOP = {"PR", "UTF", "ISO", "SHA", "RFC", "IPV", "HTTP", "HTTPS", "SSH",
                "REVIEW", "RELEASE", "PART", "V", "VER", "TOP", "NO"}
_REVIEW_PR_RE = re.compile(r"(?:^|[/-])review-pr-(\d{1,6})\b")
_PR_URL_RE = re.compile(r"github\.com/([\w.-]+/[\w.-]+)/pull/(\d{1,6})")
_TICKET_CTX_RES = (
    # A Jira link: .../browse/PROJ-142
    re.compile(r"/browse/([A-Za-z]{2,10}-\d{1,6})(?![A-Za-z0-9])"),
    # A branch name pasted into the prompt: feature/proj-142-agency-priced-lines
    re.compile(r"(?:feature|fix|bugfix|hotfix|chore|story|task)/[\w.]*?"
               r"([A-Za-z]{2,10}-\d{1,6})(?![A-Za-z0-9])"),
    # Named outright: "ticket PROJ-142", "jira PROJ-142"
    re.compile(r"\b(?:ticket|issue|jira|card)\s+(?:key\s+)?([A-Za-z]{2,10}-\d{1,6})"
               r"(?![A-Za-z0-9])", re.I),
)


def _norm_ticket(prefix, num):
    prefix = prefix.upper()
    if prefix in _TICKET_STOP:
        return None
    return f"{prefix}-{num}"


def _ticket_from_ref(text):
    """A ticket key out of a branch name or directory name (trusted source)."""
    if not text:
        return None
    for m in _TICKET_RE.finditer(text):
        key = _norm_ticket(m.group(1), m.group(2))
        if key:
            return key
    return None


def _ticket_from_prompt(text):
    """A ticket key out of prompt text, only from a deliberate reference."""
    if not text:
        return None
    for rx in _TICKET_CTX_RES:
        m = rx.search(text)
        if m:
            pre, _, num = m.group(1).partition("-")
            key = _norm_ticket(pre, num)
            if key:
                return key
    return None


_UUIDISH_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-", re.I)


def _repo_name(cwd):
    """Just the repository name.

    A worktree lives at <root>/WorkTrees/<repo>/<branch-dir>, so the repo is the
    component right after the WorkTrees folder, not the directory you are in.
    """
    if not cwd:
        return None
    parts = [p for p in cwd.strip("/").split("/") if p]
    if not parts:
        return None
    name = parts[-1]
    for i, comp in enumerate(parts[:-1]):
        if comp.lower() in ("worktrees", "worktree"):
            name = parts[i + 1]
            break
    name = name.lstrip(".")
    # A throwaway isolation worktree is named by uuid; that is not a repo name.
    if not name or _UUIDISH_RE.match(name):
        return None
    return name


def session_key(meta):
    """What work this session belongs to: {kind, key, ref} or None.

    kind is "ticket" or "pr"; key is the display key ("PROJ-142" / "PR #1452");
    ref is the repo it belongs to.
    """
    branch = meta.get("git_branch") or ""
    base = os.path.basename((meta.get("cwd") or "").rstrip("/"))
    repo = _repo_name(meta.get("cwd"))

    ticket = _ticket_from_ref(branch) or _ticket_from_ref(base)
    if ticket:
        return {"kind": "ticket", "key": ticket, "ref": repo}

    m = _REVIEW_PR_RE.search(branch) or _REVIEW_PR_RE.search(base)
    if m:
        return {"kind": "pr", "key": f"PR #{m.group(1)}", "ref": repo}

    first = meta.get("first_prompt")
    m = _PR_URL_RE.search(first or "")
    if m:
        return {"kind": "pr", "key": f"PR #{m.group(2)}", "ref": m.group(1)}

    ticket = _ticket_from_prompt(first)
    if ticket:
        return {"kind": "ticket", "key": ticket, "ref": repo}
    return None


_FILLER_SUMMARIES = {"continue", "go on", "carry on", "resume", "next", "ok", "yes",
                     "proceed", "keep going", "continue please"}
_BRANCH_PREFIX_RE = re.compile(r"^(?:feature|fix|bugfix|hotfix|chore|story|task)[/-]", re.I)


def _slug_summary(meta, key):
    """A readable summary out of the branch slug: story-PROJ-142-invoice-rollup -> invoice rollup."""
    for src in (meta.get("git_branch"), os.path.basename((meta.get("cwd") or "").rstrip("/"))):
        if not src:
            continue
        text = _BRANCH_PREFIX_RE.sub("", src.split("/")[-1])
        if key:
            text = re.sub(re.escape(key["key"].replace("PR #", "review-pr-")), "", text,
                          flags=re.I)
            text = re.sub(re.escape(key["key"]), "", text, flags=re.I)
        text = " ".join(re.split(r"[-_.]+", text)).strip()
        if len(text) >= 3:
            return text
    return None


def session_label(meta, name, key=None):
    """The display name: "<key> · <repo> · <summary>", dropping whatever is absent."""
    parts = []
    if key:
        parts.append(key["key"])
    repo = (key or {}).get("ref") or _repo_name(meta.get("cwd"))
    if repo and repo not in parts:
        parts.append(repo)
    # A raw URL in the label is wasted width; the key already says which PR it is.
    summary = " ".join(re.sub(r"https?://\S+", "", name or "").split()).rstrip(":,- ")
    summary = _short(summary, 52) if len(summary) >= 3 else _short(name, 52)
    # "continue" tells you nothing, and it is exactly how a session resumed after a
    # crash starts. The branch slug says more.
    if summary and summary.lower().strip(".!") in _FILLER_SUMMARIES:
        summary = _slug_summary(meta, key) or summary
    # `name` falls back to a session-id stub when the transcript captured no title
    # and no prompt; that is noise next to a real key, so drop it.
    if summary and summary == (meta.get("session_id") or "")[:8]:
        summary = _slug_summary(meta, key)
    if summary and summary.lower() not in [p.lower() for p in parts]:
        parts.append(summary)
    return " · ".join(parts) or (meta.get("session_id") or "unknown")[:8]


def build_sessions():
    """Correlate live processes to sessions; return them newest-active first."""
    procs = collect_processes()
    sessions = {}  # session_id -> record

    for p in procs:
        sid = p.get("session_id")
        sfile = None
        if sid:
            sfile = _find_session_file(sid)
        if not sfile:
            proj = _project_dir_for_cwd(p.get("cwd"))
            sfile = _newest_session_in(proj)
        if not sfile:
            # A live process we cannot tie to a transcript yet (brand new / no cwd).
            key = f"pid:{p['pid']}"
            rec = sessions.setdefault(key, {
                "meta": {
                    "session_id": None, "file": None, "ai_title": None,
                    "last_prompt": None, "first_prompt": None,
                    "cwd": p.get("cwd"), "git_branch": None, "model": None,
                    "mtime": None,
                },
                "procs": [],
            })
            rec["procs"].append(p)
            continue

        sid = os.path.basename(sfile)[:-6]
        rec = sessions.get(sid)
        if not rec:
            rec = {"meta": read_session_meta(sfile), "procs": []}
            sessions[sid] = rec
        rec["procs"].append(p)

    records = list(sessions.values())
    for rec in records:
        meta = rec["meta"]
        mt = meta.get("last_ts") or meta.get("mtime") or 0
        rec["last_active"] = mt
        rec["active_now"] = (time.time() - mt) <= ACTIVE_WINDOW_SECS if mt else False
        # Best short name: ai title, else remote-control name, else prompt, else id.
        rc = next((p["remote_control"] for p in rec["procs"] if p.get("remote_control")), None)
        rec["remote_control"] = rc
        prompt = next((p["prompt"] for p in rec["procs"] if p.get("prompt")), None)
        rec["argv_prompt"] = prompt
        # "What it is doing": last prompt, then argv prompt, then first prompt.
        rec["doing"] = meta.get("last_prompt") or prompt or meta.get("first_prompt")
        rec["name"] = (
            _best_title(meta) or rc or _short(prompt) or _short(meta.get("first_prompt"))
            or (meta.get("session_id") or "unknown")[:8]
        )
        rec["key"] = session_key(meta)
        rec["label"] = session_label(meta, rec["name"], rec["key"])
    records.sort(key=lambda r: r["last_active"], reverse=True)
    return records


# --------------------------------------------------------------------------- #
# Search across ALL sessions on disk (live + closed) - for finding a session
# you closed by mistake and resuming it.
# --------------------------------------------------------------------------- #
HEAD_LINES = 80          # title / first prompt / cwd / branch live near the top
TAIL_BYTES = 96 * 1024   # last prompt / recent activity live at the very end


def _best_title(meta):
    """The name a human would recognise: what they typed beats what was generated."""
    return (meta.get("custom_title") or meta.get("ai_title")
            or meta.get("agent_name"))


def _epoch_from_iso(value):
    """Epoch seconds from a transcript ISO-8601 timestamp, or None."""
    if not value or not isinstance(value, str):
        return None
    txt = value.strip()
    if txt.endswith("Z"):
        txt = txt[:-1] + "+00:00"
    try:
        return datetime.fromisoformat(txt).timestamp()
    except ValueError:
        return None


def _parse_window(text):
    """'36h' / '2d' / '90m' / '45s' / bare number (hours) -> seconds, or None."""
    if not text:
        return None
    m = re.fullmatch(r"\s*(\d+(?:\.\d+)?)\s*([smhdw]?)\s*", str(text).lower())
    if not m:
        return None
    n = float(m.group(1))
    unit = m.group(2) or "h"
    return n * {"s": 1, "m": 60, "h": 3600, "d": 86400, "w": 604800}[unit]


def _apply_records(meta, records):
    """Fold a list of decoded transcript records into a meta dict, in order."""
    for d in records:
        if not isinstance(d, dict):
            continue
        t = d.get("type")
        ts = _epoch_from_iso(d.get("timestamp"))
        if ts and ts > (meta.get("last_ts") or 0):
            meta["last_ts"] = ts
        if t == "ai-title":
            meta["ai_title"] = d.get("aiTitle") or meta["ai_title"]
        elif t == "custom-title":
            # A title the USER typed. Last one wins (they can rename mid-session),
            # and it outranks the generated ai-title everywhere a name is shown.
            meta["custom_title"] = d.get("customTitle") or meta["custom_title"]
        elif t == "agent-name":
            meta["agent_name"] = d.get("agentName") or meta["agent_name"]
        elif t == "last-prompt":
            meta["last_prompt"] = d.get("lastPrompt") or meta["last_prompt"]
        if d.get("cwd"):
            meta["cwd"] = meta["cwd"] or d["cwd"]
        if d.get("gitBranch"):
            meta["git_branch"] = meta["git_branch"] or d["gitBranch"]
        if t == "user" and not d.get("isMeta"):
            txt = _text_from_content(d.get("message", {}).get("content"))
            if txt and not txt.lstrip().startswith("<"):
                if not meta["first_prompt"]:
                    meta["first_prompt"] = txt
                meta["recent_user"] = txt   # keep overwriting -> last one wins
        if t == "assistant":
            m = d.get("message", {})
            if m.get("model"):
                meta["model"] = m.get("model") or meta["model"]


def read_session_meta_fast(session_file):
    """Metadata from a transcript reading only its head + tail (cheap on big files)."""
    meta = {
        "session_id": os.path.basename(session_file)[:-6],
        "file": session_file,
        "ai_title": None, "last_prompt": None, "first_prompt": None,
        "recent_user": None, "cwd": None, "git_branch": None,
        "model": None, "mtime": None, "last_ts": None,
        "custom_title": None, "agent_name": None,
    }
    try:
        meta["mtime"] = os.path.getmtime(session_file)
    except OSError:
        pass

    def _decode(lines):
        out = []
        for line in lines:
            line = line.strip()
            if not line:
                continue
            try:
                out.append(json.loads(line))
            except json.JSONDecodeError:
                continue
        return out

    try:
        with open(session_file, "rb") as f:
            head = []
            for _ in range(HEAD_LINES):
                b = f.readline()
                if not b:
                    break
                head.append(b.decode("utf-8", "replace"))
            _apply_records(meta, _decode(head))
            # Tail: seek near the end and read the last chunk of lines.
            try:
                f.seek(0, os.SEEK_END)
                size = f.tell()
                start = max(0, size - TAIL_BYTES)
                f.seek(start)
                tail_raw = f.read().decode("utf-8", "replace")
                tail = tail_raw.splitlines()
                if start > 0 and tail:
                    tail = tail[1:]  # drop the partial first line
                _apply_records(meta, _decode(tail))
            except OSError:
                pass
    except OSError:
        pass

    if not meta["cwd"]:
        # Fall back to decoding the cwd from the encoded project dir name.
        proj = os.path.basename(os.path.dirname(session_file))
        meta["cwd"] = proj.replace("-", "/") if proj.startswith("-") else None
    meta["last_prompt"] = meta["last_prompt"] or meta["recent_user"] or meta["first_prompt"]
    return meta


def _live_session_map():
    """session_id -> [pids] for sessions with a live claude process right now."""
    live = {}
    for rec in build_sessions():
        sid = rec["meta"].get("session_id")
        if sid and rec.get("procs"):
            live[sid] = [p["pid"] for p in rec["procs"]]
    return live


def _score(meta, tokens, key=None, qnorm=None):
    """Relevance of a session's metadata to the query tokens. Higher = better."""
    if not tokens:
        return 0
    keytxt = " ".join(filter(None, [(key or {}).get("key"),
                                    (key or {}).get("ref")])).lower()
    bonus = 0
    if qnorm and key:
        # The whole query IS this session's key ("PROJ-142", "PR #1458", "1458").
        # Decide it here, before token scoring: "pr" on its own is a weak, common
        # token that would otherwise drown the number that actually identifies it.
        knorm = re.sub(r"[^a-z0-9]", "", key["key"].lower())
        if qnorm == knorm or (qnorm.isdigit() and knorm == "pr" + qnorm):
            bonus = 30
    title = (meta.get("ai_title") or "").lower()
    proj = (_repo_label(meta.get("cwd")) or "").lower()
    branch = (meta.get("git_branch") or "").lower()
    cwd = (meta.get("cwd") or "").lower()
    prompts = " ".join(filter(None, [
        meta.get("first_prompt"), meta.get("last_prompt"), meta.get("recent_user"),
    ])).lower()
    sid = (meta.get("session_id") or "").lower()
    score = 0
    for tok in tokens:
        if not tok:
            continue
        if tok in title:
            score += 6
        if tok in proj or tok in branch:
            score += 5
        if tok in cwd:
            score += 3
        if tok in prompts:
            score += 2
        if tok in sid:
            score += 8   # a pasted id fragment is a strong signal
        if keytxt and tok in keytxt:
            score += 8   # a ticket key or PR number is just as exact
    # Whole-query phrase bonus.
    phrase = " ".join(tokens)
    if phrase and (phrase in title or phrase in prompts):
        score += 4
    return score + bonus


def _resume_cmd(meta):
    sid = meta.get("session_id")
    cwd = meta.get("cwd")
    if not sid:
        return None
    if cwd:
        return f'(cd "{cwd}" && claude --resume {sid})'
    return f"claude --resume {sid}"


def search_sessions(query, limit=600, since=None):
    """Rank EVERY session on disk against query. Returns records newest/best first.

    `since` is a window in seconds; only sessions whose LAST TRANSCRIPT ENTRY falls
    inside it are returned.
    """
    idx = _session_index()
    files = list(idx.values())
    # Order the scan by file mtime. mtime is not the session's real last activity
    # (other tooling touches these files long after the session ended, which is why
    # last_active is read from the transcript instead), but it only ever moves
    # FORWARD, so mtime >= true last activity for every file. That makes this a safe
    # superset ordering for the scan cap: a genuinely recent session can never be
    # pushed out of the window by it.
    files.sort(key=lambda fp: os.path.getmtime(fp) if os.path.exists(fp) else 0,
               reverse=True)
    if limit and limit > 0:
        files = files[:limit]
    live = _live_session_map()
    tokens = [t for t in re.split(r"\s+", (query or "").strip().lower()) if t]
    qnorm = re.sub(r"[^a-z0-9]", "", (query or "").lower())

    out = []
    for fp in files:
        meta = read_session_meta_fast(fp)
        sid = meta.get("session_id")
        key = session_key(meta)
        rec = {
            "meta": meta,
            "key": key,
            "score": _score(meta, tokens, key, qnorm),
            "live": sid in live,
            "pids": live.get(sid, []),
            "last_active": meta.get("last_ts") or meta.get("mtime") or 0,
            "resume": _resume_cmd(meta),
        }
        rec["name"] = (_best_title(meta) or _short(meta.get("first_prompt"))
                       or (sid or "unknown")[:8])
        rec["label"] = session_label(meta, rec["name"], key)
        rec["doing"] = meta.get("last_prompt") or meta.get("first_prompt")
        out.append(rec)

    if since:
        cutoff = time.time() - since
        out = [r for r in out if r["last_active"] >= cutoff]

    if tokens:
        out = [r for r in out if r["score"] > 0]
        out.sort(key=lambda r: (r["score"], r["last_active"]), reverse=True)
    else:
        out.sort(key=lambda r: r["last_active"], reverse=True)
    return out


# --------------------------------------------------------------------------- #
# Formatting helpers
# --------------------------------------------------------------------------- #
def _short(text, n=60):
    if not text:
        return None
    text = " ".join(text.split())
    return text if len(text) <= n else text[: n - 1] + "…"


def _clean_cell(text, n=90):
    """One line, table-safe (no pipes / newlines)."""
    if not text:
        return ""
    text = " ".join(str(text).split()).replace("|", "│")
    return text if len(text) <= n else text[: n - 1] + "…"


def _repo_label(cwd):
    if not cwd:
        return "?"
    base = os.path.basename(cwd.rstrip("/"))
    repo = _repo_name(cwd)
    if repo and repo != base:
        # A worktree: name the repo it belongs to, then the worktree dir.
        return f"{repo} / {base}"
    return base


def _ago(mtime):
    if not mtime:
        return "unknown"
    secs = int(time.time() - mtime)
    if secs < 0:
        secs = 0
    if secs < 60:
        return f"{secs}s ago"
    if secs < 3600:
        return f"{secs // 60}m ago"
    if secs < 86400:
        return f"{secs // 3600}h {(secs % 3600)//60}m ago"
    return f"{secs // 86400}d ago"


def _now_str():
    return datetime.now().astimezone().strftime("%Y-%m-%d %H:%M:%S %Z")


# --------------------------------------------------------------------------- #
# Renderers
# --------------------------------------------------------------------------- #
def render_markdown(records):
    active = [r for r in records if r["active_now"]]
    idle = [r for r in records if not r["active_now"]]
    lines = []
    lines.append("# Claude Code - Running Sessions")
    lines.append("")
    lines.append(f"_Updated {_now_str()}. {len(records)} live session(s): "
                 f"{len(active)} working now, {len(idle)} open & idle. "
                 "Newest activity on top._")
    lines.append("")

    top = records[0] if records else None
    if top:
        lines.append("## Running right now (top)")
        lines.append("")
        lines.append(f"- **Session:** {top.get('label') or top['name']}")
        if top.get("key"):
            kind = "Ticket" if top["key"]["kind"] == "ticket" else "Pull request"
            lines.append(f"- **{kind}:** `{top['key']['key']}`"
                         + (f" ({top['key']['ref']})" if top["key"].get("ref") else ""))
        lines.append(f"- **Session ID:** `{top['meta'].get('session_id') or 'n/a'}`")
        lines.append(f"- **Where:** {_repo_label(top['meta'].get('cwd'))}"
                     + (f"  (`{top['meta'].get('git_branch')}`)" if top['meta'].get('git_branch') else ""))
        lines.append(f"- **Directory:** `{top['meta'].get('cwd') or 'unknown'}`")
        lines.append(f"- **State:** {'working now' if top['active_now'] else 'open & idle'}, "
                     f"last active {_ago(top['last_active'])}")
        lines.append(f"- **Doing:** {_clean_cell(top.get('doing'), 240) or '(no prompt captured)'}")
        restore = _resume_cmd(top["meta"])
        if restore:
            lines.append(f"- **Restore:** `{restore}`")
        lines.append("")

    lines.append("## All live sessions")
    lines.append("")
    lines.append("| # | Last active | State | Session | Project / branch | Directory | Doing | Session ID |")
    lines.append("|---|-------------|-------|---------|------------------|-----------|-------|------------|")
    for i, r in enumerate(records, 1):
        m = r["meta"]
        state = "\U0001F7E2 working" if r["active_now"] else "⚪ idle"
        branch = m.get("git_branch")
        proj = _repo_label(m.get("cwd"))
        if branch and branch not in proj:
            proj = f"{proj}<br/>`{branch}`"
        sid = m.get("session_id") or "n/a"
        cwd = (m.get("cwd") or "unknown").replace("|", "│")
        lines.append(
            f"| {i} | {_ago(r['last_active'])} | {state} | "
            f"{_clean_cell(r.get('label') or r['name'], 72)} | {_clean_cell(proj, 48)} | "
            f"`{cwd}` | {_clean_cell(r.get('doing'), 90)} | `{sid}` |"
        )
    lines.append("")
    lines.append("### How this is measured")
    lines.append("")
    lines.append("- One row per live `claude` CLI process on this machine (the desktop app, "
                 "its helpers, and the pty host are excluded).")
    lines.append("- **State:** \U0001F7E2 working = transcript changed in the last "
                 f"{ACTIVE_WINDOW_SECS // 60} min; ⚪ idle = process alive but waiting on input.")
    lines.append("- Session id is exact for remote-control, forked, and resumed sessions "
                 "(it is in the command line). For a plain interactive session the id is "
                 "inferred as the most recently active session in that working directory, "
                 "so two plain sessions in the same folder can collapse into one row.")
    lines.append(f"- {sum(len(r['procs']) for r in records)} process(es) mapped to "
                 f"{len(records)} session(s). Generated by `a_c_claude_sessions` (my_setup); "
                 "run `a_c_claude_sessions --serve` for a live local web view.")
    lines.append("")
    return "\n".join(lines)


def render_json(records):
    out = []
    for r in records:
        m = r["meta"]
        out.append({
            "session_id": m.get("session_id"),
            "label": r.get("label") or r["name"],
            "name": r["name"],
            "key": (r.get("key") or {}).get("key"),
            "key_kind": (r.get("key") or {}).get("kind"),
            "key_ref": (r.get("key") or {}).get("ref"),
            "doing": r.get("doing"),
            "first_prompt": m.get("first_prompt"),
            "cwd": m.get("cwd"),
            "git_branch": m.get("git_branch"),
            "project": _repo_label(m.get("cwd")),
            "active_now": r["active_now"],
            "last_active_epoch": r["last_active"],
            "last_active_human": _ago(r["last_active"]),
            "model": m.get("model"),
            "pids": [p["pid"] for p in r["procs"]],
            "remote_control": r.get("remote_control"),
            "permission_mode": next((p.get("permission_mode") for p in r["procs"] if p.get("permission_mode")), None),
            "transcript": m.get("file"),
            "resume_command": _resume_cmd(m),
        })
    return json.dumps({"generated": _now_str(), "count": len(out),
                       "kill_enabled": _ALLOW_KILL, "sessions": out}, indent=2)


def _window_human(secs):
    if not secs:
        return None
    if secs % 86400 == 0:
        return f"{int(secs // 86400)}d"
    if secs % 3600 == 0:
        return f"{int(secs // 3600)}h"
    return f"{int(secs // 60)}m"


def render_search_markdown(records, query, limit, shown=12, since=None):
    lines = []
    title = f'sessions matching "{query}"' if query else "all sessions (newest first)"
    if since:
        title += f" - active in the last {_window_human(since)}"
    lines.append(f"# Claude Code - {title}")
    lines.append("")
    scanned = "no cap" if not limit else f"newest {limit}"
    if shown and shown > 0:
        howmany = f"showing top {min(shown, len(records))}"
    else:
        howmany = "showing all"
    lines.append(f"_Updated {_now_str()}. {len(records)} match(es), {howmany}. "
                 f"Scanned {scanned} sessions on disk (live + closed). "
                 "Last active is read from the transcript, not the file timestamp._")
    lines.append("")
    if not records:
        lines.append("No session matched. Try fewer / different words, a repo name, "
                     "or part of the session id. Widen the scan with `--limit 0`.")
        lines.append("")
        return "\n".join(lines)

    shortlist = records if not shown or shown <= 0 else records[:shown]

    # A windowed or long listing is for scanning, so lead with a table whose first
    # real column is the session NAME - that is what the user recognises, not the id.
    if since or len(shortlist) > 6:
        lines.append("| # | Session | Last active | State | Project / branch | Session ID |")
        lines.append("|---|---------|-------------|-------|------------------|------------|")
        for i, r in enumerate(shortlist, 1):
            m = r["meta"]
            state = "\U0001F7E2 running" if r["live"] else "⚪ closed"
            proj = _repo_label(m.get("cwd"))
            if m.get("git_branch"):
                proj = f"{proj}<br/>`{m['git_branch']}`"
            lines.append(
                f"| {i} | {_clean_cell(r.get('name') or r.get('label'), 60)} | "
                f"{_ago(r['last_active'])} | {state} | {_clean_cell(proj, 40)} | "
                f"`{m.get('session_id') or 'n/a'}` |")
        lines.append("")

    for i, r in enumerate(shortlist, 1):
        m = r["meta"]
        state = "\U0001F7E2 still running" if r["live"] else "⚪ closed"
        lines.append(f"## {i}. {r.get('label') or r['name']}")
        lines.append("")
        lines.append(f"- **State:** {state}, last active {_ago(r['last_active'])}"
                     + (f" (pid {', '.join(map(str, r['pids']))})" if r["live"] else ""))
        if r.get("key"):
            kind = "Ticket" if r["key"]["kind"] == "ticket" else "Pull request"
            lines.append(f"- **{kind}:** `{r['key']['key']}`"
                         + (f" ({r['key']['ref']})" if r["key"].get("ref") else ""))
        lines.append(f"- **Project:** {_repo_label(m.get('cwd'))}"
                     + (f"  (`{m.get('git_branch')}`)" if m.get("git_branch") else ""))
        lines.append(f"- **Session ID:** `{m.get('session_id') or 'n/a'}`")
        if r.get("doing"):
            lines.append(f"- **Doing:** {_clean_cell(r.get('doing'), 240)}")
        if r.get("resume"):
            verb = "reattach / resume" if not r["live"] else "resume (already open elsewhere)"
            lines.append(f"- **To {verb}:**")
            lines.append("")
            lines.append("```bash")
            lines.append(r["resume"])
            lines.append("```")
        lines.append("")
    return "\n".join(lines)


def render_search_json(records, query, limit, since=None):
    out = []
    for r in records:
        m = r["meta"]
        out.append({
            "session_id": m.get("session_id"),
            "label": r.get("label") or r["name"],
            "name": r["name"],
            "key": (r.get("key") or {}).get("key"),
            "key_kind": (r.get("key") or {}).get("kind"),
            "key_ref": (r.get("key") or {}).get("ref"),
            "score": r["score"],
            "live": r["live"],
            "pids": r["pids"],
            "doing": r.get("doing"),
            "cwd": m.get("cwd"),
            "git_branch": m.get("git_branch"),
            "project": _repo_label(m.get("cwd")),
            "last_active_epoch": r["last_active"],
            "last_active_human": _ago(r["last_active"]),
            "model": m.get("model"),
            "resume_command": r.get("resume"),
        })
    return json.dumps({
        "generated": _now_str(), "query": query, "scan_limit": limit,
        "since_seconds": since, "since_human": _window_human(since),
        "count": len(out), "sessions": out,
    }, indent=2)


def _html_escape(s):
    return (str(s).replace("&", "&amp;").replace("<", "&lt;")
            .replace(">", "&gt;").replace('"', "&quot;"))


def render_html(refresh=10):
    """Static shell for the client-rendered dashboard. Data comes from /json, so
    the search box and an expanded row survive the periodic refresh."""
    return _WEB_PAGE.replace("__REFRESH_SECS__", str(max(2, int(refresh))))


