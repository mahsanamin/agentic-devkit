def _tailscale_ip():
    """Best-effort IPv4 Tailscale (100.64.0.0/10 CGNAT) address of this host."""
    for cmd in (["tailscale", "ip", "-4"],
                ["/Applications/Tailscale.app/Contents/MacOS/Tailscale", "ip", "-4"]):
        try:
            out = subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout
        except Exception:
            continue
        for tok in out.split():
            if re.match(r"100\.(6[4-9]|[7-9]\d|1[01]\d|12[0-7])\.", tok):
                return tok
    # Fallback: scan interfaces for a 100.x CGNAT address.
    try:
        out = subprocess.run(["ifconfig"], capture_output=True, text=True, timeout=5).stdout
        for line in out.splitlines():
            m = re.search(r"inet (100\.(?:6[4-9]|[7-9]\d|1[01]\d|12[0-7])\.\d+\.\d+)", line)
            if m:
                return m.group(1)
    except Exception:
        pass
    return None


_FAVICON_SVG = (
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">'
    '<rect x="1" y="1" width="30" height="30" rx="7" fill="#0d1117" stroke="#30363d" stroke-width="2"/>'
    '<path d="M9 10 L15 16 L9 22" fill="none" stroke="#58a6ff" stroke-width="2.6" '
    'stroke-linecap="round" stroke-linejoin="round"/>'
    '<rect x="17" y="20" width="8" height="2.6" rx="1.3" fill="#7ee787"/>'
    '<circle cx="24.5" cy="8.5" r="3" fill="#1f7a3a" stroke="#7ee787" stroke-width="1"/>'
    '</svg>'
).encode()

_JSON_CACHE = {"t": 0.0, "body": None}
_JSON_LOCK = threading.Lock()
_ALLOW_KILL = False


def _cmd_of_pid(pid):
    try:
        return subprocess.run(["ps", "-o", "command=", "-p", str(pid)],
                              capture_output=True, text=True, timeout=5).stdout.strip()
    except Exception:
        return None


def _kill_session(key, force=False):
    """Signal the claude process(es) for a session. Safe: re-validates each pid is
    a live claude CLI process RIGHT NOW before signaling, and never touches this
    server's own process. `key` is a session id or a 'pids:1,2,3' key."""
    records = build_sessions()
    target = None
    for r in records:
        sid = r["meta"].get("session_id")
        rkey = sid or ("pids:" + ",".join(str(p["pid"]) for p in r["procs"]))
        if key == sid or key == rkey:
            target = r
            break
    if target is None:
        return {"ok": False, "error": "session not found (it may have already exited)"}

    sig = signal.SIGKILL if force else signal.SIGTERM
    me = os.getpid()
    killed, skipped = [], []
    for p in target["procs"]:
        pid = p["pid"]
        if pid == me:
            skipped.append({"pid": pid, "reason": "this is the dashboard server"})
            continue
        cmd = _cmd_of_pid(pid)
        if not cmd:
            skipped.append({"pid": pid, "reason": "already exited"})
            continue
        if not _is_real_claude(cmd):
            skipped.append({"pid": pid, "reason": "not a claude process (pid reused) - refused"})
            continue
        try:
            os.kill(pid, sig)
            killed.append(pid)
        except ProcessLookupError:
            skipped.append({"pid": pid, "reason": "already exited"})
        except PermissionError:
            skipped.append({"pid": pid, "reason": "permission denied"})
    # Make the next /json reflect the kill immediately.
    with _JSON_LOCK:
        _JSON_CACHE["body"] = None
    return {"ok": True, "signal": "SIGKILL" if force else "SIGTERM",
            "killed": killed, "skipped": skipped}


def _json_feed(ttl=4):
    """Cached JSON so rapid auto-refresh hits don't each trigger a full scan."""
    now = time.monotonic()
    with _JSON_LOCK:
        if _JSON_CACHE["body"] is not None and (now - _JSON_CACHE["t"]) < ttl:
            return _JSON_CACHE["body"]
        body = render_json(build_sessions()).encode()
        _JSON_CACHE.update(t=now, body=body)
        return body


# --------------------------------------------------------------------------- #
# Full-text search index over what YOU typed in every session.
#
# The point of this index is to make searching your own history something you do
# yourself, instantly, instead of asking an assistant to grep for you and paying
# tokens for it. It covers ALL sessions on disk, not just the running ones.
#
# Only USER prompts are indexed, deliberately. Assistant replies and tool output
# are the overwhelming bulk of a transcript (hundreds of MB across a history this
# size) and searching them mostly returns your own words quoted back at you. What
# you actually remember is what you typed.
#
# Indexing is incremental: each session records how many bytes were already read,
# so a refresh only parses what was appended since. The first build is the only
# expensive one.
# --------------------------------------------------------------------------- #
INDEX_DB = os.path.expanduser("~/.claude/.cache/session-search.db")

# Per session. Generous enough to hold a long conversation's prompts, bounded so
# one runaway session cannot dominate the index.
MAX_PROMPT_CHARS = 200_000


def _index_connect():
    os.makedirs(os.path.dirname(INDEX_DB), exist_ok=True)
    conn = sqlite3.connect(INDEX_DB, timeout=10)
    conn.execute("PRAGMA journal_mode=WAL")
    conn.execute("""CREATE TABLE IF NOT EXISTS sessions (
            session_id TEXT PRIMARY KEY,
            cwd TEXT, project TEXT, branch TEXT, name TEXT,
            key TEXT, key_kind TEXT,
            last_active REAL, offset INTEGER DEFAULT 0, size INTEGER DEFAULT 0,
            prompts TEXT DEFAULT '')""")
    conn.execute("""CREATE VIRTUAL TABLE IF NOT EXISTS sessions_fts
            USING fts5(session_id UNINDEXED, name, project, branch, prompts,
                       tokenize='porter unicode61')""")
    conn.execute("CREATE INDEX IF NOT EXISTS idx_last_active "
                 "ON sessions(last_active DESC)")
    conn.commit()
    return conn


def _user_prompts_from(text):
    """The human-typed lines out of a chunk of transcript."""
    out = []
    for rec in _iter_index_records(text):
        if rec.get("type") != "user" or rec.get("isMeta"):
            continue
        content = (rec.get("message") or {}).get("content")
        txt = _text_from_content(content)
        if not txt:
            continue
        txt = txt.strip()
        # Tool results and injected context arrive as "user" records too. They are
        # machine text, not something the person typed, so they do not belong here.
        if not txt or txt.startswith("<"):
            continue
        out.append(txt)
    return out


def _iter_index_records(text):
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            yield json.loads(line)
        except json.JSONDecodeError:
            continue


def index_sessions(progress=False):
    """Refresh the search index. Returns (indexed, skipped, total)."""
    conn = _index_connect()
    known = {row[0]: (row[1], row[2]) for row in
             conn.execute("SELECT session_id, offset, size FROM sessions")}
    files = _session_index()
    indexed = skipped = 0
    total = len(files)

    for n, (sid, path) in enumerate(sorted(files.items()), 1):
        try:
            size = os.path.getsize(path)
        except OSError:
            continue
        prev_offset, prev_size = known.get(sid, (0, -1))
        if size == prev_size:
            skipped += 1
            continue
        # A shrunken file is not the file we indexed before; start it over.
        start = prev_offset if size > prev_size else 0

        try:
            with open(path, "rb") as fh:
                fh.seek(start)
                raw = fh.read().decode("utf-8", "replace")
        except OSError:
            continue
        if start > 0 and "\n" in raw:
            raw = raw.split("\n", 1)[1]

        meta = read_session_meta_fast(path)
        key = session_key(meta) or {}
        new_text = "\n".join(_user_prompts_from(raw))

        row = conn.execute("SELECT prompts FROM sessions WHERE session_id = ?",
                           (sid,)).fetchone()
        prompts = ((row[0] + "\n" + new_text) if row and start > 0 else new_text)
        if len(prompts) > MAX_PROMPT_CHARS:
            # Keep the most recent end of a very long session.
            prompts = prompts[-MAX_PROMPT_CHARS:]

        name = (_best_title(meta) or _short(meta.get("first_prompt"))
                or (sid or "unknown")[:8])
        project = _repo_label(meta.get("cwd")) or ""
        last_active = meta.get("last_ts") or meta.get("mtime") or 0

        conn.execute("""INSERT INTO sessions
                (session_id, cwd, project, branch, name, key, key_kind,
                 last_active, offset, size, prompts)
                VALUES (?,?,?,?,?,?,?,?,?,?,?)
                ON CONFLICT(session_id) DO UPDATE SET
                 cwd=excluded.cwd, project=excluded.project, branch=excluded.branch,
                 name=excluded.name, key=excluded.key, key_kind=excluded.key_kind,
                 last_active=excluded.last_active, offset=excluded.offset,
                 size=excluded.size, prompts=excluded.prompts""",
            (sid, meta.get("cwd") or "", project, meta.get("git_branch") or "",
             name, key.get("key") or "", key.get("kind") or "",
             last_active, size, size, prompts))
        conn.execute("DELETE FROM sessions_fts WHERE session_id = ?", (sid,))
        conn.execute("INSERT INTO sessions_fts (session_id, name, project, branch, prompts) "
                     "VALUES (?,?,?,?,?)", (sid, name, project,
                                            meta.get("git_branch") or "", prompts))
        indexed += 1
        if progress and indexed % 25 == 0:
            print(f"  indexed {indexed} (seen {n}/{total})", file=sys.stderr)

    conn.commit()
    conn.close()
    return indexed, skipped, total


def _fts_query(query):
    """User words -> an FTS5 query. Quoted so punctuation cannot be syntax."""
    words = [w for w in re.split(r"\s+", (query or "").strip()) if w]
    if not words:
        return None
    return " AND ".join('"' + w.replace('"', '""') + '"*' for w in words)


def search_index(query, limit=40, since=None):
    """Sessions whose prompts match. Empty query = most recent, newest first."""
    if not os.path.exists(INDEX_DB):
        return None
    conn = _index_connect()
    where, params = [], []
    if since:
        where.append("s.last_active >= ?")
        params.append(time.time() - since)

    match = _fts_query(query)
    if match:
        sql = ("SELECT s.session_id, s.name, s.project, s.branch, s.cwd, "
               "s.last_active, s.key, snippet(sessions_fts, 4, '[', ']', ' … ', 12) "
               "FROM sessions_fts f JOIN sessions s ON s.session_id = f.session_id "
               "WHERE sessions_fts MATCH ?")
        params.insert(0, match)
        if where:
            sql += " AND " + " AND ".join(where)
    else:
        sql = ("SELECT s.session_id, s.name, s.project, s.branch, s.cwd, "
               "s.last_active, s.key, '' FROM sessions s")
        if where:
            sql += " WHERE " + " AND ".join(where)
    sql += " ORDER BY s.last_active DESC LIMIT ?"
    params.append(limit)

    try:
        rows = conn.execute(sql, params).fetchall()
    except sqlite3.OperationalError:
        conn.close()
        return []
    conn.close()

    live = _live_session_map()
    out = []
    for sid, name, project, branch, cwd, last_active, key, snip in rows:
        out.append({
            "session_id": sid, "name": name, "project": project,
            "branch": branch, "cwd": cwd, "key": key or None,
            "last_active_epoch": last_active,
            "last_active_human": _ago(last_active),
            "live": sid in live,
            "match": (snip or "").replace("\n", " ").strip(),
            "resume_command": _resume_cmd({"session_id": sid, "cwd": cwd}),
        })
    return out


def render_index_markdown(rows, query, since=None):
    lines = []
    what = f'you typed matching "{query}"' if query else "your newest sessions"
    if since:
        what += f" (last {_window_human(since)})"
    lines.append(f"# Claude Code - {what}")
    lines.append("")
    if not rows:
        lines.append("Nothing matched. Try one distinctive word; matching is "
                     "prefix-based and every word must appear.")
        return "\n".join(lines)
    lines.append(f"_{len(rows)} session(s). Searching only what YOU typed._")
    lines.append("")
    lines.append("| # | Session | Last active | State | Project | Match |")
    lines.append("|---|---------|-------------|-------|---------|-------|")
    for i, r in enumerate(rows, 1):
        state = "\U0001F7E2 running" if r["live"] else "⚪ closed"
        lines.append(
            f"| {i} | {_clean_cell(r['name'], 46)} | {r['last_active_human']} | "
            f"{state} | {_clean_cell(r['project'], 28)} | "
            f"{_clean_cell(r['match'] or '-', 70)} |")
    lines.append("")
    lines.append("Resume any of them:")
    lines.append("")
    lines.append("```bash")
    for r in rows[:5]:
        lines.append(r["resume_command"] or "")
    lines.append("```")
    return "\n".join(lines)


def serve(host, port, refresh, allow_kill=False):
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

    class Handler(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, *a):
            pass

        def do_GET(self):
            try:
                path = self.path.split("?", 1)[0].rstrip("/")
                if path in ("/json", "/api"):
                    body = _json_feed()
                    ctype = "application/json"
                elif path in ("/favicon.ico", "/favicon.svg", "/favicon"):
                    body = _FAVICON_SVG
                    ctype = "image/svg+xml"
                else:
                    body = render_html(refresh).encode()
                    ctype = "text/html; charset=utf-8"
                self.send_response(200)
                self.send_header("Content-Type", ctype)
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
            except (BrokenPipeError, ConnectionResetError):
                pass

        def _reply(self, code, obj):
            body = json.dumps(obj).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_POST(self):
            try:
                path = self.path.split("?", 1)[0].rstrip("/")
                if path != "/kill":
                    self._reply(404, {"ok": False, "error": "not found"})
                    return
                if not _ALLOW_KILL:
                    self._reply(403, {"ok": False,
                        "error": "kill is disabled; start the server with --allow-kill"})
                    return
                # CSRF defenses. (1) Require application/json: a cross-origin fetch
                # with this content-type triggers a CORS preflight the attacker's
                # page can't satisfy, and a form/"simple request" POST can't set it.
                ctype = self.headers.get("Content-Type", "").split(";")[0].strip().lower()
                if ctype != "application/json":
                    self._reply(415, {"ok": False,
                        "error": "Content-Type must be application/json"})
                    return
                # (2) If an Origin/Referer is present, it must match our own host.
                origin = self.headers.get("Origin") or self.headers.get("Referer", "")
                if origin:
                    host = self.headers.get("Host", "")
                    if urlparse(origin).netloc != host:
                        self._reply(403, {"ok": False,
                            "error": "cross-origin request refused"})
                        return
                n = int(self.headers.get("Content-Length") or 0)
                raw = self.rfile.read(n) if n else b"{}"
                try:
                    data = json.loads(raw or b"{}")
                except ValueError:
                    data = {}
                key = data.get("key")
                if not key:
                    self._reply(400, {"ok": False, "error": "missing 'key'"})
                    return
                self._reply(200, _kill_session(key, force=bool(data.get("force"))))
            except (BrokenPipeError, ConnectionResetError):
                pass
            except Exception as e:  # never crash the server on a bad request
                try:
                    self._reply(500, {"ok": False, "error": str(e)})
                except Exception:
                    pass

    global _ALLOW_KILL
    _ALLOW_KILL = bool(allow_kill)
    try:
        httpd = ThreadingHTTPServer((host, port), Handler)
        httpd.daemon_threads = True
    except OSError as e:
        print(f"error: cannot bind {host}:{port} -> {e}", file=sys.stderr)
        if host not in ("127.0.0.1", "0.0.0.0", "localhost"):
            print("  (is that address up on this machine? `tailscale ip -4` to check, "
                  "or use --bind 0.0.0.0)", file=sys.stderr)
        sys.exit(1)
    shown = "localhost" if host in ("127.0.0.1", "0.0.0.0") else host
    scope = ("all interfaces (LAN + tailnet + public)" if host == "0.0.0.0"
             else "this machine only" if host in ("127.0.0.1", "localhost")
             else "this address only (e.g. your tailnet)")
    print(f"Claude sessions dashboard at http://{shown}:{port}  (Ctrl-C to stop)", flush=True)
    print(f"  JSON feed at http://{shown}:{port}/json", flush=True)
    print(f"  bound to {host}:{port} - reachable from {scope}", flush=True)
    print(f"  kill endpoint: {'ENABLED (POST /kill)' if _ALLOW_KILL else 'disabled'}", flush=True)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped")


# --------------------------------------------------------------------------- #
# launchd self-install (portable: paths are read from THIS machine at run time)
# --------------------------------------------------------------------------- #
LAUNCH_AGENTS_DIR = os.path.join(HOME, "Library", "LaunchAgents")


def _agent_spec(kind, port, allow_kill=False):
    """(label, ProgramArguments, keepalive, start_interval, logfile) for a kind."""
    script = os.path.realpath(__file__)
    logs = os.path.join(HOME, "Library", "Logs")
    # Run the script directly (its #!/usr/bin/env python3 shebang + the PATH we
    # set below resolve python), so a later python upgrade does not strand a
    # pinned interpreter path.
    if kind == "web":
        args = [script, "--serve", str(port), "--tailscale"]
        if allow_kill:
            args.append("--allow-kill")
        return (
            "com.ahsan.claude-sessions-web",
            args,
            True, None,
            os.path.join(logs, "a_c_claude_sessions_web.launchd.log"),
        )
    if kind == "mdnest":
        return (
            "com.ahsan.claude-sessions",
            [script, "--write-mdnest"],
            False, 600,
            os.path.join(logs, "a_c_claude_sessions.launchd.log"),
        )
    raise ValueError(kind)


def _launchd_path_env():
    """A PATH that covers tailscale, mdnest, python, and the usual dirs, on any Mac."""
    parts = [
        "/usr/local/bin", "/opt/homebrew/bin",
        "/Applications/Tailscale.app/Contents/MacOS",
        os.path.dirname(sys.executable),
        "/usr/bin", "/bin", "/usr/sbin", "/sbin",
    ]
    seen, out = set(), []
    for p in parts:
        if p and p not in seen:
            seen.add(p)
            out.append(p)
    return ":".join(out)


def _plist_xml(label, args, keepalive, start_interval, logfile,
               username=None, home=None):
    """Render a launchd job.

    username/home are for a system LaunchDaemon: it starts at boot with no user
    session, so it must be told which user to run as, and HOME must be explicit
    (a daemon inherits none, and this script reads ~/.claude/projects).
    """
    def esc(s):
        return (str(s).replace("&", "&amp;").replace("<", "&lt;")
                .replace(">", "&gt;"))
    arg_xml = "\n".join(f"        <string>{esc(a)}</string>" for a in args)
    sched = ("    <key>KeepAlive</key>\n    <true/>\n" if keepalive else
             f"    <key>StartInterval</key>\n    <integer>{start_interval}</integer>\n")
    env = [f"        <key>PATH</key>\n        <string>{esc(_launchd_path_env())}</string>"]
    if home:
        env.append(f"        <key>HOME</key>\n        <string>{esc(home)}</string>")
    who = ""
    if username:
        who = (f"    <key>UserName</key>\n    <string>{esc(username)}</string>\n"
               f"    <key>GroupName</key>\n    <string>staff</string>\n")
    return f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Generated by `a_c_claude_sessions --install-*-agent` / `--install-boot-daemon`
     on this machine. Do not hand-copy to another machine; run the install command
     there instead (paths below are specific to this host). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{esc(label)}</string>
    <key>ProgramArguments</key>
    <array>
{arg_xml}
    </array>
    <key>EnvironmentVariables</key>
    <dict>
{chr(10).join(env)}
    </dict>
{who}    <key>RunAtLoad</key>
    <true/>
{sched}    <key>StandardOutPath</key>
    <string>{esc(logfile)}</string>
    <key>StandardErrorPath</key>
    <string>{esc(logfile)}</string>
</dict>
</plist>
"""


def install_agent(kind, port=8787, allow_kill=False):
    label, args, keepalive, interval, logfile = _agent_spec(kind, port, allow_kill)
    if kind == "web" and not _tailscale_ip():
        print("warning: no Tailscale IP detected on this machine yet. The agent will "
              "keep retrying until Tailscale is up. Start Tailscale, or use "
              "`--serve --bind 0.0.0.0` for a non-tailnet run.", file=sys.stderr)
    os.makedirs(LAUNCH_AGENTS_DIR, exist_ok=True)
    dest = os.path.join(LAUNCH_AGENTS_DIR, label + ".plist")
    with open(dest, "w") as f:
        f.write(_plist_xml(label, args, keepalive, interval, logfile))
    subprocess.run(["launchctl", "unload", dest],
                   capture_output=True, text=True)
    r = subprocess.run(["launchctl", "load", dest], capture_output=True, text=True)
    if r.returncode != 0:
        print(f"launchctl load failed: {r.stderr or r.stdout}", file=sys.stderr)
        return False
    print(f"installed + loaded {label}")
    print(f"  plist:  {dest}")
    print(f"  script: {os.path.realpath(__file__)}")
    print(f"  log:    {logfile}")
    if kind == "web":
        ip = _tailscale_ip()
        where = f"http://{ip}:{port}" if ip else f"(tailnet IP):{port}"
        print(f"  serving on {where}  (tailnet only; JSON at /json)")
        print(f"  kill endpoint: {'ENABLED' if allow_kill else 'disabled'}")
    else:
        print(f"  refreshing {DEFAULT_MDNEST_PATH} every {interval//60} min")
    return True


def uninstall_agent(kind):
    label, *_ = _agent_spec(kind, 8787)
    dest = os.path.join(LAUNCH_AGENTS_DIR, label + ".plist")
    subprocess.run(["launchctl", "unload", dest], capture_output=True, text=True)
    existed = os.path.exists(dest)
    try:
        os.remove(dest)
    except OSError:
        pass
    print(f"uninstalled {label}" + ("" if existed else " (was not installed)"))
    return True


# --------------------------------------------------------------------------- #
# Boot-level install (LaunchDaemon)
#
# A LaunchAgent starts at LOGIN. On an always-on machine that is not the same as
# "starts when the machine starts": an unattended reboot (power cut, remote
# `reboot`) leaves the dashboard down until somebody logs in. A LaunchDaemon in
# /Library/LaunchDaemons starts at BOOT, with no user session, so it closes that
# gap. It needs root to install, runs as the named user (not root, so the
# transcripts under that user's ~/.claude are readable and nothing is created
# root-owned), and it replaces the LaunchAgent rather than joining it, because
# two copies would fight over the same port.
#
# Note: on a machine with FileVault ON the data volume is locked until somebody
# unlocks it at the login screen, so no daemon can read ~/.claude before that.
# There, boot-level start buys nothing and the LaunchAgent is the honest answer.
# --------------------------------------------------------------------------- #
LAUNCH_DAEMONS_DIR = "/Library/LaunchDaemons"


def _boot_target_user():
    """(name, home, uid) of the human a boot daemon should run as, or (None,)*3.

    Prefers SUDO_USER (the person who typed `sudo`), then the console owner, so
    `sudo a_c_claude_sessions --install-boot-daemon` does the obvious thing.
    """
    candidates = [os.environ.get("SUDO_USER") or ""]
    try:
        candidates.append(pwd.getpwuid(os.stat("/dev/console").st_uid).pw_name)
    except Exception:
        pass
    for name in candidates:
        if not name or name == "root":
            continue
        try:
            pw = pwd.getpwnam(name)
        except KeyError:
            continue
        return (pw.pw_name, pw.pw_dir, pw.pw_uid)
    return (None, None, None)


def _retire_login_agent(label, uid, home):
    """Unload the per-user LaunchAgent and move its plist aside.

    Without this the agent would start a second copy at the next login and lose
    the race for the port. The plist is kept (renamed) so the change is
    reversible by hand, and so it is obvious what happened.
    """
    plist = os.path.join(home, "Library", "LaunchAgents", label + ".plist")
    subprocess.run(["launchctl", "bootout", f"gui/{uid}/{label}"],
                   capture_output=True, text=True)
    if os.path.exists(plist):
        aside = plist + ".replaced-by-boot-daemon"
        try:
            shutil.move(plist, aside)
            print(f"  retired login agent: {aside}")
        except OSError as e:
            print(f"warning: could not move {plist} aside ({e}). Remove it by hand, "
                  "or it will fight the daemon for the port at next login.",
                  file=sys.stderr)
    return plist


def install_boot_daemon(port=8787, allow_kill=False):
    label, args, keepalive, interval, _log = _agent_spec("web", port, allow_kill)
    if os.geteuid() != 0:
        script = os.path.realpath(__file__)
        extra = " --allow-kill" if allow_kill else ""
        print("error: installing a boot-level daemon needs root.\n\n"
              f"  sudo {script} --install-boot-daemon {port}{extra}\n\n"
              "(run it from your own shell, not a root shell, so the daemon can "
              "tell which user's sessions to read)", file=sys.stderr)
        return False
    user, home, uid = _boot_target_user()
    if not user:
        print("error: could not work out which user to run as. Run it as "
              "`sudo a_c_claude_sessions --install-boot-daemon` from that user's "
              "shell so SUDO_USER is set.", file=sys.stderr)
        return False
    if not _tailscale_ip():
        print("warning: no Tailscale IP on this machine yet. KeepAlive means the "
              "daemon will retry until Tailscale is up, which is the expected "
              "state early in boot.", file=sys.stderr)

    # The script path must be readable at boot. Warn if it lives somewhere that
    # may mount late (an external or network volume).
    script = os.path.realpath(__file__)
    if script.startswith("/Volumes/"):
        print(f"note: the script lives on {script.split('/')[2]!r} under /Volumes. "
              "That is fine for an internal APFS volume (it mounts at boot); a "
              "removable or network volume would make the daemon retry until it "
              "appears.", file=sys.stderr)

    _retire_login_agent(label, uid, home)

    logfile = os.path.join(home, "Library", "Logs",
                           "a_c_claude_sessions_web.launchd.log")
    os.makedirs(os.path.dirname(logfile), exist_ok=True)
    dest = os.path.join(LAUNCH_DAEMONS_DIR, label + ".plist")
    with open(dest, "w") as f:
        f.write(_plist_xml(label, args, keepalive, interval, logfile,
                           username=user, home=home))
    # launchd refuses a daemon plist that is not root-owned and not
    # group/world writable.
    os.chown(dest, 0, 0)
    os.chmod(dest, 0o644)

    subprocess.run(["launchctl", "bootout", f"system/{label}"],
                   capture_output=True, text=True)
    r = subprocess.run(["launchctl", "bootstrap", "system", dest],
                       capture_output=True, text=True)
    if r.returncode != 0:
        print(f"launchctl bootstrap failed: {r.stderr or r.stdout}", file=sys.stderr)
        return False
    ip = _tailscale_ip()
    print(f"installed + started {label} as a BOOT daemon")
    print(f"  plist:  {dest}  (root:wheel 644)")
    print(f"  runs as: {user}  (HOME={home})")
    print(f"  script: {script}")
    print(f"  log:    {logfile}")
    print(f"  serving on {f'http://{ip}:{port}' if ip else f'(tailnet IP):{port}'}"
          "  (tailnet only; JSON at /json)")
    print(f"  kill endpoint: {'ENABLED' if allow_kill else 'disabled'}")
    print("  starts at boot, with no login needed. Verify after a reboot with:")
    print(f"    sudo launchctl print system/{label} | head -20")
    return True


def uninstall_boot_daemon():
    label, *_ = _agent_spec("web", 8787)
    if os.geteuid() != 0:
        print(f"error: needs root.\n\n  sudo {os.path.realpath(__file__)} "
              "--uninstall-boot-daemon", file=sys.stderr)
        return False
    dest = os.path.join(LAUNCH_DAEMONS_DIR, label + ".plist")
    subprocess.run(["launchctl", "bootout", f"system/{label}"],
                   capture_output=True, text=True)
    existed = os.path.exists(dest)
    try:
        os.remove(dest)
    except OSError:
        pass
    print(f"uninstalled boot daemon {label}" + ("" if existed else " (was not installed)"))
    user, home, _uid = _boot_target_user()
    if home:
        aside = os.path.join(home, "Library", "LaunchAgents",
                             label + ".plist.replaced-by-boot-daemon")
        if os.path.exists(aside):
            print(f"  the login agent is still parked at {aside}")
            print("  restore login-time start with: a_c_claude_sessions --install-web-agent")
    return True


# --------------------------------------------------------------------------- #
def main():
    ap = argparse.ArgumentParser(
        description="Live dashboard of Claude Code sessions running on this machine.")
    g = ap.add_mutually_exclusive_group()
    g.add_argument("--print", action="store_true", help="print Markdown (default)")
    g.add_argument("--json", action="store_true", help="print JSON")
    g.add_argument("--write-mdnest", nargs="?", const=DEFAULT_MDNEST_PATH,
                   metavar="PATH", help=f"write Markdown to mdnest (default {DEFAULT_MDNEST_PATH})")
    g.add_argument("--serve", nargs="?", const=8787, type=int, metavar="PORT",
                   help="serve an auto-refreshing web page (default port 8787)")
    g.add_argument("--install-web-agent", nargs="?", const=8787, type=int, metavar="PORT",
                   help="generate + load a launchd agent (for THIS machine) that serves "
                        "the dashboard on the tailnet at boot (default port 8787)")
    g.add_argument("--install-mdnest-agent", action="store_true",
                   help="generate + load a launchd agent that refreshes the mdnest note every 10 min")
    g.add_argument("--install-boot-daemon", nargs="?", const=8787, type=int, metavar="PORT",
                   help="needs sudo. Install a system LaunchDaemon that serves the "
                        "dashboard at BOOT, before any login (a LaunchAgent only "
                        "starts at login). Replaces the web agent so the two never "
                        "clash on the port")
    g.add_argument("--uninstall-web-agent", action="store_true",
                   help="unload + remove the tailnet web launchd agent")
    g.add_argument("--uninstall-mdnest-agent", action="store_true",
                   help="unload + remove the mdnest-refresh launchd agent")
    g.add_argument("--uninstall-boot-daemon", action="store_true",
                   help="needs sudo. Stop + remove the boot-level LaunchDaemon")
    ap.add_argument("--bind", metavar="ADDR", default="127.0.0.1",
                    help="serve bind address (default 127.0.0.1 = this machine only; "
                         "give a tailnet IP to expose on Tailscale, or 0.0.0.0 for all)")
    ap.add_argument("--tailscale", action="store_true",
                    help="bind --serve to this machine's Tailscale IP (auto-detected)")
    ap.add_argument("--allow-kill", action="store_true",
                    help="enable the POST /kill endpoint + the web Kill buttons "
                         "(off by default; anyone who can reach the page can then end sessions)")
    ap.add_argument("--find", metavar="QUERY",
                    help="search ALL sessions on disk (live + closed) and print the "
                         "resume command for each match, best/newest first")
    ap.add_argument("--all", action="store_true",
                    help="list every session on disk (live + closed), newest first")
    ap.add_argument("--limit", type=int, default=None,
                    help="cap the transcript scan to the N newest sessions "
                         "(0 = no cap; default 600, or no cap when --since is used)")
    ap.add_argument("--top", type=int, default=None,
                    help="how many matches to show in --find/--all markdown "
                         "(0 = all; default 12, or all when --since is used)")
    ap.add_argument("--search", metavar="WORDS",
                    help="search everything you TYPED across all sessions, using the "
                         "local index (instant). Empty value lists the newest.")
    ap.add_argument("--reindex", action="store_true",
                    help="refresh the search index now (it also refreshes on demand)")
    ap.add_argument("--since", metavar="WINDOW",
                    help="only sessions whose last transcript entry is inside this "
                         "window, e.g. 36h, 2d, 90m (a bare number means hours). "
                         "Shows every session in the window and lifts the scan cap.")
    ap.add_argument("--refresh", type=int, default=10, help="web auto-refresh seconds (default 10)")
    args = ap.parse_args()

    if args.install_web_agent is not None:
        sys.exit(0 if install_agent("web", args.install_web_agent, allow_kill=args.allow_kill) else 1)
    if args.install_mdnest_agent:
        sys.exit(0 if install_agent("mdnest") else 1)
    if args.install_boot_daemon is not None:
        sys.exit(0 if install_boot_daemon(args.install_boot_daemon,
                                          allow_kill=args.allow_kill) else 1)
    if args.uninstall_web_agent:
        sys.exit(0 if uninstall_agent("web") else 1)
    if args.uninstall_mdnest_agent:
        sys.exit(0 if uninstall_agent("mdnest") else 1)
    if args.uninstall_boot_daemon:
        sys.exit(0 if uninstall_boot_daemon() else 1)

    if args.serve is not None:
        host = args.bind
        if args.tailscale:
            host = _tailscale_ip()
            if not host:
                print("error: could not detect a Tailscale IP on this machine "
                      "(is Tailscale up? try `tailscale ip -4`)", file=sys.stderr)
                sys.exit(1)
        serve(host, args.serve, args.refresh, allow_kill=args.allow_kill)
        return
    if args.reindex:
        indexed, skipped, total = index_sessions(progress=True)
        print(f"indexed {indexed}, unchanged {skipped}, {total} session(s) on disk")
        if args.search is None:
            return

    if args.search is not None:
        since = _parse_window(args.since) if args.since else None
        if args.since and since is None:
            print(f"error: could not read --since {args.since!r}", file=sys.stderr)
            sys.exit(1)
        # Keep the index warm without the user having to think about it.
        index_sessions()
        rows = search_index(args.search, limit=(args.top or 40), since=since)
        if args.json:
            print(json.dumps({"query": args.search, "count": len(rows or []),
                              "sessions": rows or []}, indent=2))
        else:
            print(render_index_markdown(rows or [], args.search, since))
        return

    if args.find is not None or args.all:
        query = "" if args.all else args.find
        since = _parse_window(args.since) if args.since else None
        if args.since and since is None:
            print(f"error: could not read --since {args.since!r}; "
                  "use a form like 36h, 2d or 90m", file=sys.stderr)
            sys.exit(1)
        # A window is an explicit "show me everything in here", so neither the scan
        # cap nor the display cap may silently cut it. Both still honour an explicit flag.
        limit = args.limit if args.limit is not None else (0 if since else 600)
        top = args.top if args.top is not None else (0 if since else 12)
        records = search_sessions(query, limit=limit, since=since)
        if args.json:
            print(render_search_json(records, query, limit, since=since))
        else:
            print(render_search_markdown(records, query, limit, shown=top, since=since))
        return
    if args.write_mdnest is not None:
        records = build_sessions()
        ok = write_mdnest(render_markdown(records), args.write_mdnest)
        sys.exit(0 if ok else 1)

    records = build_sessions()
    if args.json:
        print(render_json(records))
    else:
        print(render_markdown(records))


if __name__ == "__main__":
    main()
