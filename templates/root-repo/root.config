# root.config
#
# Every path this setup uses, in one place. Nothing else in the repo hardcodes a path.
# Shell key=value, safe to `source`, plain enough for an agent to read as text.
#
# Per machine: copy the keys that differ into `root.local.config` (gitignored) and set them
# there. Usually only ROOT_BASE_DIR and MACHINE_NAME change.
#
# LOAD ORDER: root.local.config FIRST, then this file. Every key here is written as
# ${KEY:-default}, so anything already set survives. That is what lets a machine override
# ROOT_BASE_DIR and have every path derived from it follow, instead of being expanded
# against the default before the override is even read.
# Optional roles: leave a value empty when that repo is not on this machine. Empty is normal.
# Another company: copy this repo, keep the key names exactly, change only the values.
#
# The devkit reads these key names. The contract is in agentic-devkit/docs/root-repo.md.

# --- Identity ---------------------------------------------------------------
ORG_NAME="${ORG_NAME:-{{ORG_NAME}}}"
ORG_SLUG="${ORG_SLUG:-{{ORG_SLUG}}}"
ORG_EMAIL_DOMAIN="${ORG_EMAIL_DOMAIN:-}"
ORG_GITHUB="${ORG_GITHUB:-}"
ORG_JIRA_URL="${ORG_JIRA_URL:-}"

# --- Base directories. Override these first on a new machine. ---------------
ROOT_BASE_DIR="${ROOT_BASE_DIR:-$HOME}"

# The three repo tiers. The cd_w / cd_p / cd_g shell aliases are built from these.
ORG_REPOS_DIR="${ORG_REPOS_DIR:-$ROOT_BASE_DIR/work}"        # cd_w  company work
PERSONAL_REPOS_DIR="${PERSONAL_REPOS_DIR:-$ROOT_BASE_DIR/personal}"  # cd_p  my private repos
GLOBAL_REPOS_DIR="${GLOBAL_REPOS_DIR:-$ROOT_BASE_DIR/public}"   # cd_g  my public repos

# Per machine values. Every machine sets its own, so these live in root.local.config.
MACHINE_NAME="${MACHINE_NAME:-}"     # how an agent should name this box. Picks machine/<name>.md in an overlay
MACHINE_TYPE="${MACHINE_TYPE:-}"     # e.g. m1 / i7. Picks the org shell profile: <ORG_SLUG>.<MACHINE_TYPE>.profile
GDRIVE_DIR="${GDRIVE_DIR:-}"       # cloud drive root on this machine, if any. Becomes cd_gd
GDRIVE_CHATS_DIR="${GDRIVE_CHATS_DIR:-}" # a folder inside it worth an alias. Becomes cd_gc

# --- This repo. Required. ---------------------------------------------------
ROOT_DIR="${ROOT_DIR:-$ORG_REPOS_DIR/{{ROOT_REPO_NAME}}}"
ROOT_ENTRY="${ROOT_ENTRY:-ROOT.md}"
ROOT_REMOTE="${ROOT_REMOTE:-}"

# --- Knowledge: what we know ------------------------------------------------
# The company brain, shared with colleagues. The most consulted repo here.
ORG_BRAIN_DIR="${ORG_BRAIN_DIR:-}"
ORG_BRAIN_ENTRY="${ORG_BRAIN_ENTRY:-AGENTS.md}"
ORG_BRAIN_REMOTE="${ORG_BRAIN_REMOTE:-}"

# My own brain for this company. Optional.
PRIVATE_BRAIN_DIR="${PRIVATE_BRAIN_DIR:-}"
PRIVATE_BRAIN_ENTRY="${PRIVATE_BRAIN_ENTRY:-AGENTS.md}"
PRIVATE_BRAIN_REMOTE="${PRIVATE_BRAIN_REMOTE:-}"

# --- Capability: what an agent can do ---------------------------------------
# Use the right ssh host alias per account. On the wrong host a clone authenticates as the
# other identity and fails with a misleading "Repository not found".

# The generic toolkit. PUBLIC: nothing about the company may enter it.
# NO_ORG_CONTENT is the flag that matters for the boundary check, not IS_PUBLIC.
DEVKIT_DIR="${DEVKIT_DIR:-$PERSONAL_REPOS_DIR/agentic-devkit}"
DEVKIT_ENTRY="${DEVKIT_ENTRY:-AGENTS.md}"
DEVKIT_REMOTE="${DEVKIT_REMOTE:-git@github.com:mahsanamin/agentic-devkit.git}"
DEVKIT_IS_PUBLIC="${DEVKIT_IS_PUBLIC:-true}"
DEVKIT_NO_ORG_CONTENT="${DEVKIT_NO_ORG_CONTENT:-true}"

# The company overlay on that toolkit: company only skills, agents, machine facts. Optional.
ORG_DEVKIT_DIR="${ORG_DEVKIT_DIR:-}"
ORG_DEVKIT_ENTRY="${ORG_DEVKIT_ENTRY:-AGENTS.md}"
ORG_DEVKIT_REMOTE="${ORG_DEVKIT_REMOTE:-}"

# The private overlay: my own skills and my own always-on rules. Optional.
# Private, but still no company content: it is shared across machines and guarded.
PRIVATE_DEVKIT_DIR="${PRIVATE_DEVKIT_DIR:-}"
PRIVATE_DEVKIT_ENTRY="${PRIVATE_DEVKIT_ENTRY:-AGENTS.md}"
PRIVATE_DEVKIT_REMOTE="${PRIVATE_DEVKIT_REMOTE:-}"
PRIVATE_DEVKIT_IS_PUBLIC="${PRIVATE_DEVKIT_IS_PUBLIC:-false}"
PRIVATE_DEVKIT_NO_ORG_CONTENT="${PRIVATE_DEVKIT_NO_ORG_CONTENT:-true}"

# --- The human's own always-on rules ----------------------------------------
# Neither company rules nor toolkit capability. They survive a toolkit swap, so the root owns
# the pointer and a swap is a config change, not a rewrite.
STYLE_RULES_FILE="${STYLE_RULES_FILE:-}"
PERSONAL_RULES_DIR="${PERSONAL_RULES_DIR:-}"

# --- Agent framework --------------------------------------------------------
# The per repo workflow installed into a project. Optional.
AGENT_FRAMEWORK_DIR="${AGENT_FRAMEWORK_DIR:-}"
AGENT_FRAMEWORK_ENTRY="${AGENT_FRAMEWORK_ENTRY:-}"
AGENT_FRAMEWORK_REMOTE="${AGENT_FRAMEWORK_REMOTE:-}"

# --- Machine level ----------------------------------------------------------
AGENT_HOME="${AGENT_HOME:-$HOME/.claude}"
