<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for a_c_docker_cleanup (safe Docker space reclaim).

  Runs the SAFE cleanup weekly, Sunday at 03:00. Safe mode never touches
  running containers or volumes; see the script header for the full contract.

  Install / manage:
    cp launchd/com.ahsan.docker-cleanup.plist ~/Library/LaunchAgents/
    launchctl unload ~/Library/LaunchAgents/com.ahsan.docker-cleanup.plist 2>/dev/null
    launchctl load   ~/Library/LaunchAgents/com.ahsan.docker-cleanup.plist
    launchctl list | grep docker-cleanup        # confirm it is registered
    launchctl start  com.ahsan.docker-cleanup    # run it now, on demand

  Change the schedule: edit StartCalendarInterval below, then unload + load.
    Weekday: 0=Sunday .. 6=Saturday. Omit a key to mean "every".
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ahsan.docker-cleanup</string>

    <!-- The safe cleanup. No flags = safe mode. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/Work/Personal/repos/agentic-devkit/scripts/a_c_docker_cleanup</string>
    </array>

    <!-- launchd starts with a bare PATH; give it docker + the usual dirs. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Weekly: Sunday 03:00. A run missed while asleep fires on next wake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- launchd's own capture (the script also tees to ~/Library/Logs). -->
    <key>StandardOutPath</key>
    <string>/Users/ahsan/Library/Logs/a_c_docker_cleanup.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ahsan/Library/Logs/a_c_docker_cleanup.launchd.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
